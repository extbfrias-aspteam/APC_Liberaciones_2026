name: Build and Test Source

on:
  push:
    branches:
      - main
      - develop
      - qa
      - staging
      - production
  pull_request:
    branches:
      - main
      - develop
      - qa
      - staging

env:
  MAVEN_OPTS: "-Dmaven.repo.local=${{ github.workspace }}/automatizacion-main/automatizacion-main/java-app/.m2/repository"
  JAVA_VERSION: "17"
  WORKING_DIR: "automatizacion-main/automatizacion-main/java-app"

jobs:
  build:
    name: Build App1
    runs-on: ubuntu-latest
    permissions:
      contents: read
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 
      
      - name: Set up JDK ${{ env.JAVA_VERSION }}
        uses: actions/setup-java@v4
        with:
          java-version: ${{ env.JAVA_VERSION }}
          distribution: 'temurin'
          cache: 'maven'
      
      - name: Verify Java version
        working-directory: ${{ env.WORKING_DIR }}
        run: |
          echo "Java version:"
          java -version
          echo "Maven version:"
          mvn -version
      
      - name: Build App1
        working-directory: ${{ env.WORKING_DIR }}
        run: mvn clean package -DskipTests
      
      - name: Save build cache
        uses: actions/cache/save@v4
        if: success()
        with:
          path: |
            ${{ env.WORKING_DIR }}/target/
            ${{ env.WORKING_DIR }}/.m2/repository/
          key: build-${{ github.sha }}
      
      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        if: success()
        with:
          name: build-artifacts
          path: |
            ${{ env.WORKING_DIR }}/target/*.war
            ${{ env.WORKING_DIR }}/target/*.ear
            ${{ env.WORKING_DIR }}/target/*.jar
          retention-days: 30

  test:
    name: Run Tests & Sonar Analysis
    runs-on: ubuntu-latest
    needs: build
    permissions:
      contents: write   
      checks: write     
      pull-requests: write 
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
      
      - name: Set up JDK ${{ env.JAVA_VERSION }}
        uses: actions/setup-java@v4
        with:
          java-version: ${{ env.JAVA_VERSION }}
          distribution: 'temurin'
          cache: 'maven'
      
      - name: Restore build cache
        uses: actions/cache/restore@v4
        with:
          path: |
            ${{ env.WORKING_DIR }}/target/
            ${{ env.WORKING_DIR }}/.m2/repository/
          key: build-${{ github.sha }}
          fail-on-cache-miss: true
      
      - name: Run unit tests
        working-directory: ${{ env.WORKING_DIR }}
        run: mvn test
      
      - name: SonarQube Analysis
        working-directory: ${{ env.WORKING_DIR }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}
        run: mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=ASP-POC
      
      - name: Publish test results
        uses: EnricoMi/publish-unit-test-result-action@v2
        if: always()
        with:
          files: ${{ env.WORKING_DIR }}/target/surefire-reports/TEST-*.xml

      - name: Create PR to Staging
        if: github.ref == 'refs/heads/qa' && github.event_name == 'push'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }} 
        run: |
          echo "Verificando si ya existe un PR abierto de QA hacia Staging..."
          PR_EXISTS=$(gh pr list --head qa --base staging --state open --json number -q '.[0].number')
          
          if [ -z "$PR_EXISTS" ]; then
            echo "Creando nuevo Pull Request hacia la rama Staging..."
            gh pr create \
              --head qa \
              --base staging \
              --title "🚀 QA a Staging: Despliegue automático (Build #${{ github.run_number }})" \
              --body "El pipeline de QA pasó con éxito todas las pruebas unitarias y el escaneo de SonarQube de forma satisfactoria. Listo para revisión."
          else
            echo "Ya existe un Pull Request abierto (#$PR_EXISTS). No es necesario crear uno nuevo."
          fi