<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

	<bean id="sigSeqAS" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="select nextval('ahorro_saldos_ahorro_saldos_id_seq')" />
	</bean>
	
	<bean id="nuevoAS" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="INSERT INTO ahorro_saldos(cuenta,solicitante_id,saldo_real,saldo_promedio,saldo_acumulado,fecha_corte,fecha_deposito,intereses,iva,isr,retenciones,desviacion,dias,saldo_disponible,ahorro_saldos_id,ide) 
			       VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)" />
	</bean>
	
	<bean id="buscarSaldoByCuenta" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="SELECT cuenta,solicitante_id,saldo_real,saldo_promedio,saldo_acumulado,fecha_corte,fecha_deposito,intereses,iva,isr,retenciones,desviacion,dias,saldo_disponible,ahorro_saldos_id,ide 
			       FROM ahorro_saldos WHERE cuenta = ?" />
	</bean>
	
	<bean id="actualizarAS" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="UPDATE 
					  ahorro_saldos  
					SET
					  saldo_real = ?,
					  saldo_acumulado = ?,
					  saldo_disponible = ?	 
					WHERE 
					  ahorro_saldos_id = ?" />
	</bean>
	
	<bean id="AhorroSaldosDAO" class="net.cero.spring.dao.AhorroSaldosDAO">
		<property name="jdbcTemplatePr" ref="jdbcTemplatePr"/>
		<property name="sigSeqAS" ref="sigSeqAS"/>
		<property name="nuevoAS" ref="nuevoAS"/>
		<property name="buscarSaldoByCuenta" ref="buscarSaldoByCuenta"/>
		<property name="actualizarAS" ref="actualizarAS"/>
	</bean>
	
</beans>