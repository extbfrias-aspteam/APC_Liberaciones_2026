<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

	<bean id="montoRetenciones" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="select coalesce(sum(monto),0) from ahorro_retenciones where cuenta= ? and estatus=1;" />
	</bean>
	
	
	<bean id="AhorroRetencionesDAO" class="net.cero.spring.dao.AhorroRetencionesDAO">
		<property name="jdbcTemplatePr" ref="jdbcTemplatePr"/>
		<property name="montoRetenciones" ref="montoRetenciones"/>
	</bean>
	
</beans>