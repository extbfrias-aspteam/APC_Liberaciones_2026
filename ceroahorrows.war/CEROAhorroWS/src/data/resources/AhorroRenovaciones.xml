<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
	http://www.springframework.org/schema/beans/spring-beans-2.5.xsd">

	<bean id="ultimaFechaRenovacion" class="java.lang.String">
		<constructor-arg type="java.lang.String"
			value="select max(fecha_renovacion) from ahorro_renovaciones where cuenta = ?" />
	</bean>
	
	
	<bean id="AhorroRenovacionesDAO" class="net.cero.spring.dao.AhorroRenovacionesDAO">
		<property name="jdbcTemplatePr" ref="jdbcTemplatePr"/>
		<property name="ultimaFechaRenovacion" ref="ultimaFechaRenovacion"/>
	</bean>
	
</beans>