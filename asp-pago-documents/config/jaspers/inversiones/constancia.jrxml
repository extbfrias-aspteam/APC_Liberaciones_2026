	<variable name="fecha_dep" class="java.lang.String">
		<expression><![CDATA[ $F{fecha_inicio} == null 
        ? "" 
        : new java.text.SimpleDateFormat("d 'DE' MMMM 'DEL' yyyy", new java.util.Locale("es","ES"))
            .format($F{fecha_inicio})
            .toUpperCase()]]></expression>
	</variable>
	<variable name="fecha_operacion" class="java.lang.String">
		<expression><![CDATA[   $F{fecha_inicio} == null 
        ? "" 
        : new java.text.SimpleDateFormat("d-MMM-yyyy", new java.util.Locale("es","ES"))
            .format($F{fecha_inicio})
            .toUpperCase()]]></expression>
	</variable>
	<variable name="cuenta" class="java.lang.String">
		<expression><![CDATA[$F{cuenta} == null 
        ? "" 
        : $F{cuenta}.substring(0, Math.min($F{cuenta}.length(), 8))]]></expression>
	</variable>
	<variable name="subcuenta" class="java.lang.String">
		<expression><![CDATA[$F{cuenta} == null 
        ? "" 
        : $F{cuenta}.substring(8, Math.min($F{cuenta}.length(), 10))]]></expression>
	</variable>
	<variable name="fecha_ven" class="java.lang.String">
		<expression><![CDATA[$F{fecha_final} == null 
        ? "" 
        : new java.text.SimpleDateFormat("d 'DE' MMMM 'DEL' yyyy", new java.util.Locale("es","ES"))
            .format($F{fecha_final})
            .toUpperCase()]]></expression>
	</variable>
	<variable name="folio" class="java.lang.String">
		<expression><![CDATA[$F{rendimiento_vigente_id} == null 
        ? "" 
        : String.format("%010d", $F{rendimiento_vigente_id})]]></expression>
	</variable>
