<jasperReport name="CONSTANCIA" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3daedc94-3e17-444d-98a8-dc17c9ef1714">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="posgtrs  procrea"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="num_cuenta" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
    reportes_param."parametro1",
    reportes_param."parametro2",
    reportes_param."parametro3",
    reportes_param."parametro4",
    reportes_param."parametro13",
    reportes_param."parametro14",
    ahorro_contrato."cuenta",
    ahorro_rendimiento_vigente."rendimiento_vigente_id",
    ahorro_rendimiento_vigente."plazo",
    ahorro_rendimiento_vigente."tasa_int",
    ahorro_rendimiento_vigente."capital",
    ahorro_rendimiento_vigente."fecha_inicio",
    ahorro_rendimiento_vigente."fecha_final",
    agente."nombre"     AS agente_nombre,
    agente."titulo"     ,
    solicitante."nombre" AS solicitante_nombre,
    coalesce(solicitante."credencial_ife", '') as "credencial_ife", 
    ahorro_capitalizar_rendimientos."descripcion",
    (
        SELECT acr2.descripcion
        FROM ahorro_capitalizar_rendimientos acr2
        WHERE acr2.tipo_id = 2
        LIMIT 1
    ) AS retiroCapital
FROM "public"."reportes_param" reportes_param
INNER JOIN "public"."ahorro_rendimiento_vigente" ahorro_rendimiento_vigente
    ON reportes_param."llave" = ahorro_rendimiento_vigente."cuenta"
AND ahorro_rendimiento_vigente."estatus" = 'A'
LEFT JOIN "public"."ahorro_contrato" ahorro_contrato
    ON reportes_param."llave" = ahorro_contrato."cuenta"
LEFT JOIN "public"."solicitante" solicitante
    ON ahorro_contrato."solicitante_id" = solicitante."numero"
INNER JOIN "public"."ahorro_capitalizar_rendimientos" ahorro_capitalizar_rendimientos
    ON ahorro_rendimiento_vigente."tipo_capitalizar_id" = ahorro_capitalizar_rendimientos."tipo_id"
LEFT JOIN "public"."agente" agente
    ON ahorro_contrato."sucursal_apertura" = agente."clave"
    where ahorro_contrato.cuenta=$P{num_cuenta}
ORDER BY ahorro_contrato."cuenta" asc limit 1;]]></query>
