			<text><![CDATA[SALDO PROMEDIO MENSUAL]]></text>
		</element>
		<element kind="rectangle" uuid="a6edb3ca-1e5b-4c66-95f8-c6fec048e128" x="300" y="388" width="253" height="20"/>
