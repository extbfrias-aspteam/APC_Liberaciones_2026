			<text><![CDATA[SALDO DISPONIBLE
]]></text>
		</element>
		<element kind="staticText" uuid="ea413623-fb9a-47eb-bb85-3c89090f79f5" x="306" y="349" width="100" height="20" fontName="Arial" fontSize="8.0" vTextAlign="Middle">
			<text><![CDATA[SALDO]]></text>
		</element>
		<element kind="staticText" uuid="a4a35813-6e43-4787-8b7f-a9e5a9cddbdb" x="306" y="389" width="114" height="18" fontName="Arial" fontSize="8.0">
			<text><![CDATA[SALDO PROMEDIO DIARIO]]></text>
		</element>
		<element kind="textField" uuid="7459abff-1eba-413a-9da1-d2d381bcd987" x="406" y="290" width="44" height="20" fontName="Arial" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[$F{depositos_num}]]></expression>
		</element>
		<element kind="textField" uuid="998784b5-302b-4552-a7c1-ebb61a853052" x="406" y="311" width="44" height="18" fontName="Arial" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[$F{retiros_num}]]></expression>
		</element>
		<element kind="staticText" uuid="9961bc8f-8728-4f15-87df-7d59c4c51d72" x="406" y="330" width="44" height="18" fontName="Arial" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle">
			<text><![CDATA[0]]></text>
		</element>
		<element kind="textField" uuid="514d919c-d3f1-4b33-9ac6-7bc52dade169" x="433" y="270" width="120" height="20" fontName="Arial" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format(
    ($F{saldo_ant} == null ? BigDecimal.ZERO : ((BigDecimal)$F{saldo_ant})).setScale(2, java.math.RoundingMode.HALF_UP)
)
]]></expression>
		</element>
		<element kind="textField" uuid="69743f2d-1bc1-430a-8303-c4a268e86055" x="450" y="290" width="102" height="20" fontName="Arial" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format(
    ($F{depositos_total} == null ? BigDecimal.ZERO : ((BigDecimal)$F{depositos_total})).setScale(2, java.math.RoundingMode.HALF_UP)
)
]]></expression>
		</element>
		<element kind="textField" uuid="32d56d9c-1a28-43d8-96b1-f045176b8cc6" x="452" y="310" width="100" height="18" fontName="Arial" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format(
    ($F{retiros_total} == null ? BigDecimal.ZERO : ((BigDecimal)$F{retiros_total})).setScale(2, java.math.RoundingMode.HALF_UP)
)
]]></expression>
		</element>
		<element kind="staticText" uuid="282b6e96-9758-4fff-919a-e3a0bfa0b934" x="451" y="329" width="100" height="18" fontName="Arial" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[$0]]></text>
		</element>
		<element kind="textField" uuid="45412d8a-ef95-4ce5-86f6-55f6d8d98d72" x="407" y="349" width="144" height="20" fontName="Arial" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format(
    ($F{saldo_real}== null ? BigDecimal.ZERO : ((BigDecimal)$F{saldo_real})).setScale(2, java.math.RoundingMode.HALF_UP)
)
]]></expression>
		</element>
		<element kind="textField" uuid="da14d2ca-d39a-4657-82f1-157e7cb252ee" x="420" y="369" width="132" height="18" fontName="Arial" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format(($F{saldo_promedio}.doubleValue() == 0.0) ? $F{saldo_real} : $F{saldo_promedio})
]]></expression>
		</element>
		<element kind="textField" uuid="b2d65438-72bc-48f4-8a12-d34dc147ec2e" x="400" y="408" width="152" height="30" fontName="Arial" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
			<expression><![CDATA["$" + new java.text.DecimalFormat("#,##0.00").format(
    ($F{saldo_disponible} == null ? BigDecimal.ZERO : ((BigDecimal)$F{saldo_disponible})).setScale(2, java.math.RoundingMode.HALF_UP)
)
