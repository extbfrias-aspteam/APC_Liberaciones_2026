<jasperReport name="nuevoDoc" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="64f228c9-8edf-4b78-804d-ae60bb1488a9">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="posgtrs  procrea"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="anio" class="java.lang.Integer"/>
	<parameter name="numMes" class="java.lang.Integer"/>
	<parameter name="no_cuenta" class="java.lang.String"/>
	<query language="sql"><![CDATA[  SELECT
    ai."cuenta",
    ai."id_solicitante",
    ai."tipo_ahorro_id",
    ai."nombre_cliente",
    ai."domicilio",
    ai."colonia",
    ai."localidad",
    ai."estado",
    ai."moneda",
    ai."rendimiento",
    ai."condusef",
    ai."leyenda",
    ai."mes",
    ai."anio",
    ai."fec_corte",
    ai."saldo_ant",
    ai."depositos_total",
    ai."depositos_num",
    ai."retiros_total",
    ai."retiros_num",
    ai."saldo_real",
    ai."saldo_disponible",
    ai."gat",
    ai."tasa_int",
    ai."udis",
    coalesce(ai."unidad_une", '') as unidad_une,
    ag."nombre" AS agente_nombre,
    ag."domicilio" AS agente_domicilio,
    ag."colonia" AS agente_colonia,
    ag."telefono" AS agente_telefono,
    ag."titulo" AS agente_titulo,
    det."fecha",
    det."descripcion",
    det."cargo",
    det."abono",
    det."origen_operacion",
    ac."fecha_deposito",
    coalesce(ac."cuenta_clabe", '') as cuenta_clabe,
    ae."saldo_real" AS edocuenta_saldo_real,
    ae."saldo_promedio",
    adi."fecha_inicio",
    adi."fecha_vencim",
    adi."plazo"
FROM public.ahorro_imprime_edocuenta ai
INNER JOIN public.agente ag
    ON ai."sucursal" = ag."clave"
INNER JOIN public.ahorro_contrato ac
    ON ai."cuenta" = ac."cuenta"
LEFT JOIN public.ahorro_edocuenta ae
    ON ai."cuenta" = ae."cuenta"
   AND ai."mes" = ae."mes"
   AND ai."anio" = ae."anio"
LEFT JOIN public.ahorro_imprime_edocuenta_adicional adi
    ON ai."ahorro_imprime_edocuenta_id" = adi."ahorro_imprime_edocuenta_id"
LEFT JOIN public.ahorro_imprime_edocuenta_detalle det
    ON ai."cuenta" = det."cuenta"
   AND ai."mes" = det."mes"
   AND ai."anio" = det."anio"
   where ai.cuenta = $P{no_cuenta} and ai.anio =  $P{anio}  and ai.mes >= $P{numMes}  and ai.mes <= $P{numMes} 
ORDER BY
    ai."cuenta" ASC,
    det."fecha" asc ;]]></query>
