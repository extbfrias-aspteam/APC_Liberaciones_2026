	<variable name="fDesde" resetType="None" class="java.util.Date">
		<expression><![CDATA[new java.util.GregorianCalendar(
    $F{fec_corte}.getYear() + 1900,
    $F{fec_corte}.getMonth(),
    1
).getTime()
]]></expression>
	</variable>
	<variable name="v_sdo_prom" resetType="None" class="java.lang.Double">
		<expression><![CDATA[($F{saldo_promedio} == 0.0) ? $F{saldo_real}.doubleValue() : $F{saldo_promedio}
]]></expression>
	</variable>
	<variable name="dias_periodo" resetType="None" class="java.lang.Integer">
		<expression><![CDATA[(int)( ($F{fec_corte}.getTime() - $V{fDesde}.getTime()) / (1000 * 60 * 60 * 24) ) + 1
]]></expression>
	</variable>
	<variable name="regdetalle" class="java.lang.Integer">
		<expression><![CDATA[$V{regdetalle} == null ? 1 : $V{regdetalle} + 1
]]></expression>
	</variable>
	<variable name="nSaldo" class="java.math.BigDecimal">
		<expression><![CDATA[($V{nSaldo} == null ? 
    ($F{saldo_ant} == null ? BigDecimal.ZERO : (BigDecimal)$F{saldo_ant})
    : $V{nSaldo})
.add($F{abono} == null ? BigDecimal.ZERO : (BigDecimal)$F{abono})
.subtract($F{cargo} == null ? BigDecimal.ZERO : (BigDecimal)$F{cargo})
]]></expression>
	</variable>
	<variable name="v_sdo_prom_diario" resetType="None" class="java.lang.Double">
		<expression><![CDATA[($V{dias_periodo} == 0) ? 0.0 : ($V{v_sdo_prom} / $V{dias_periodo}.doubleValue())
]]></expression>
	</variable>
