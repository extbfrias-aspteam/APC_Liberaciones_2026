	<title height="438" splitType="Stretch">
		<element kind="rectangle" uuid="2b084e91-5d03-4298-973c-a21265813d15" x="300" y="309" width="253" height="20"/>
		<element kind="rectangle" uuid="a08a1481-c90d-46a5-8ae5-e31b01d124ab" x="300" y="329" width="253" height="20"/>
		<element kind="rectangle" uuid="39e9a8c0-f9f0-4b59-882e-38da9c60bb18" x="300" y="290" width="253" height="20"/>
		<element kind="rectangle" uuid="bc70d189-32fc-4b21-8916-39f073ff01b2" x="0" y="309" width="300" height="129"/>
		<element kind="staticText" uuid="e77fb9ce-dc5c-4321-b9ae-52ebded51dcc" x="-20" y="40" width="595" height="20" fontName="Arial" bold="true" hTextAlign="Center">
			<text><![CDATA[ESTADO DE CUENTA
]]></text>
		</element>
		<element kind="textField" uuid="62a322f4-e7c3-40a8-82d6-cdfb740c97c0" x="-20" y="50" width="594" height="20" fontName="Arial" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle">
			<expression><![CDATA[$F{rendimiento}]]></expression>
		</element>
		<element kind="textField" uuid="74f9b534-e396-49d2-9244-cfa75e57a82e" x="-20" y="70" width="594" height="20" fontName="Arial" fontSize="8.0" hTextAlign="Center" vTextAlign="Top">
			<expression><![CDATA["Periodo "+ new java.text.SimpleDateFormat("dd-MMM-yyyy").format(
    new java.util.GregorianCalendar($P{anio}, $P{numMes} - 1, 1).getTime()
) +
" al " +
new java.text.SimpleDateFormat("dd-MMM-yyyy").format(
    new java.util.GregorianCalendar($P{anio}, $P{numMes} - 1, 
        new java.util.GregorianCalendar($P{anio}, $P{numMes} - 1, 1).getActualMaximum(java.util.Calendar.DAY_OF_MONTH)
    ).getTime()
)
]]></expression>
		</element>
		<element kind="textField" uuid="2c938864-cc26-4c9f-89b0-9884f08b5399" x="-19" y="90" width="593" height="20" fontName="Arial" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Top">
			<expression><![CDATA[$F{agente_nombre}]]></expression>
		</element>
		<element kind="textField" uuid="78e30e7b-faa5-4bd6-8813-d456184ef91f" x="40" y="110" width="480" height="30" fontName="Arial" fontSize="8.0" hTextAlign="Center">
			<expression><![CDATA[$F{agente_domicilio}+" "+$F{agente_colonia}+" "+$F{agente_titulo}+" "+$F{agente_telefono}]]></expression>
		</element>
		<element kind="staticText" uuid="710dee0a-8a60-4967-83d1-d02c6354d9e5" x="0" y="140" width="180" height="20" fontName="Arial" fontSize="8.0" vTextAlign="Middle">
			<text><![CDATA[Datos del Cliente:]]></text>
		</element>
		<element kind="textField" uuid="e7f1d94c-14c8-40a5-bcab-2be5090cdcbc" x="10" y="160" width="240" height="20" fontName="Arial" fontSize="8.0">
			<expression><![CDATA[$F{nombre_cliente}]]></expression>
		</element>
		<element kind="textField" uuid="db18cd2e-bc56-4723-9ca2-1c86bf6d9eb9" x="10" y="181" width="300" height="49" fontName="Arial" fontSize="8.0">
			<expression><![CDATA[$F{domicilio}+""+$F{colonia}+" "+$F{localidad}+""+$F{estado}]]></expression>
		</element>
		<element kind="textField" uuid="a3205ab3-63d0-46c4-9aa5-20dc817494c9" x="0" y="230" width="310" height="20" fontName="Arial" fontSize="8.0">
			<expression><![CDATA["CLABE INTERBANCARIA: " +$F{cuenta_clabe}]]></expression>
		</element>
		<element kind="textField" uuid="fd5fcd20-6903-46ad-9780-7c258e7b080c" x="0" y="250" width="310" height="19" fontName="Arial" fontSize="8.0">
			<expression><![CDATA["FECHA DE CORTE: "+(new java.util.GregorianCalendar($P{anio}, $P{numMes} - 1, 1).getActualMaximum(java.util.Calendar.DAY_OF_MONTH)) + " de " +
(new String[]{"ENERO","FEBRERO","MARZO","ABRIL","MAYO","JUNIO","JULIO","AGOSTO","SEPTIEMBRE","OCTUBRE","NOVIEMBRE","DICIEMBRE"}[$P{numMes} - 1]) + 
" de " + $P{anio}
]]></expression>
		</element>
		<element kind="textField" uuid="168c492f-8161-4ffd-b0c3-043c5e2701a4" x="438" y="160" width="115" height="10" fontName="Arial" fontSize="8.0">
			<expression><![CDATA[$F{cuenta}.substring(0, Math.min($F{cuenta}.length(), 13))
]]></expression>
		</element>
		<element kind="staticText" uuid="b70a3aa4-cfe7-4217-972b-bc940a09fafa" x="380" y="160" width="60" height="10" fontName="Arial" fontSize="8.0">
			<text><![CDATA[NO. CUENTA:]]></text>
		</element>
		<element kind="textField" uuid="8fafdf2a-662b-462c-a15d-1f0438e82944" x="438" y="170" width="115" height="10" fontName="Arial" fontSize="8.0">
			<expression><![CDATA[$F{cuenta}.substring(8, Math.min($F{cuenta}.length(), 10))
]]></expression>
		</element>
		<element kind="staticText" uuid="0b3dee46-37fa-4d0b-ae90-613dee155b9f" x="363" y="170" width="80" height="10" fontName="Arial" fontSize="8.0">
			<text><![CDATA[NO. SUBCUENTA:]]></text>
		</element>
		<element kind="staticText" uuid="ab28970f-2b1a-4bd2-be10-2515428003a3" x="366" y="180" width="70" height="10" fontName="Arial" fontSize="8.0">
			<text><![CDATA[NO. DE CLIENTE:]]></text>
		</element>
		<element kind="textField" uuid="6955b8ed-dc2b-4c61-a233-d1719f069bfa" x="438" y="180" width="115" height="10" fontName="Arial" fontSize="8.0">
			<expression><![CDATA[$F{id_solicitante}]]></expression>
		</element>
		<element kind="staticText" uuid="d82452a8-aff7-4dac-b7f3-edb1fa977827" x="374" y="200" width="59" height="10" fontName="Arial" fontSize="8.0" vTextAlign="Top">
			<text><![CDATA[FECHA INICIO:]]></text>
		</element>
		<element kind="staticText" uuid="a62f2069-dc9f-4ed5-887d-42e24780248b" x="343" y="210" width="90" height="10" fontName="Arial" fontSize="8.0" vTextAlign="Top">
			<text><![CDATA[FECHA VENCIMIENTO:]]></text>
		</element>
		<element kind="staticText" uuid="f415b4e1-2450-4556-b1d3-297986e74ae0" x="367" y="220" width="66" height="10" fontName="Arial" fontSize="8.0" vTextAlign="Top">
			<text><![CDATA[PLAZO EN DÍAS:]]></text>
		</element>
		<element kind="textField" uuid="72c1090f-9ed0-49e0-af5f-81de3fa4640d" x="438" y="200" width="100" height="10" fontName="Arial" fontSize="8.0">
			<expression><![CDATA[new java.text.SimpleDateFormat("dd-MMM-yyyy", java.util.Locale.ENGLISH).format($F{fecha_inicio})]]></expression>
		</element>
		<element kind="textField" uuid="eadb5578-c645-4ed8-a94e-65da8db43bca" x="438" y="210" width="100" height="10" fontName="Arial" fontSize="8.0">
			<expression><![CDATA[new java.text.SimpleDateFormat("dd-MMM-yyyy", java.util.Locale.ENGLISH).format($F{fecha_vencim})
]]></expression>
		</element>
		<element kind="textField" uuid="21d51c7c-3379-4125-bd5b-d99ed0210d87" x="438" y="220" width="100" height="11" fontName="Arial" fontSize="8.0">
			<expression><![CDATA[$F{plazo}]]></expression>
		</element>
		<element kind="textField" uuid="4f77a8ab-b61f-4b23-b357-e6c5364b6531" x="0" y="270" width="300" height="20" fontName="Arial" fontSize="8.0">
			<expression><![CDATA["MONEDA: "+$F{moneda}]]></expression>
			<box>
				<pen lineWidth="1.0"/>
			</box>
		</element>
		<element kind="textField" uuid="a0b4950f-09ad-4df3-9cbe-b14e888ec43a" x="10" y="311" width="150" height="20" fontName="Arial" fontSize="8.0">
			<expression><![CDATA["GAT Nominal: " + (
    ($F{gat} == null || ((Number)$F{gat}).doubleValue() <= 0) 
        ? $F{gat} 
        : $F{gat} + "%"
)
]]></expression>
		</element>
		<element kind="textField" uuid="2bf92ac0-a99d-49a4-98a5-78b4ee56240f" x="160" y="311" width="139" height="20" fontName="Arial" fontSize="8.0">
			<expression><![CDATA["GAT Real: "+(($F{gat} == null) ? "" : $F{gat}.toString() + "%")

]]></expression>
		</element>
		<element kind="staticText" uuid="d7a4668b-aa80-4f92-9aa7-3a0b763c5b07" x="10" y="330" width="280" height="39" fontName="Arial" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle">
			<text><![CDATA[Antes de Impuestos y para fines informativos y de comparación]]></text>
		</element>
		<element kind="staticText" uuid="9a88c288-05bd-4bd9-a1e2-b4895b45a03b" x="10" y="368" width="280" height="30" fontName="Arial" fontSize="8.0">
			<text><![CDATA["GAT real : Es el rendimiento que obtendria despues de descontar la inflacion estimada "]]></text>
		</element>
		<element kind="textField" uuid="bfe64678-51af-4198-8753-1d031dd475e1" x="0" y="290" width="300" height="19" fontName="Arial" fontSize="8.0">
			<expression><![CDATA["TASA DE INTERÉS ANUAL: "+$F{tasa_int} +"% FIJA"]]></expression>
			<box>
				<pen lineWidth="1.0"/>
			</box>
		</element>
		<element kind="rectangle" uuid="34997d52-fa5b-49a8-aab2-76f113fae708" x="300" y="270" width="253" height="20"/>
		<element kind="staticText" uuid="c762c82d-b1af-4407-950e-484aa6a43b96" x="306" y="270" width="84" height="20" fontName="Arial" fontSize="8.0" vTextAlign="Middle">
			<text><![CDATA[SALDO ANTERIOR ]]></text>
		</element>
		<element kind="staticText" uuid="b103870c-3e59-4b28-bcaa-2e7038063d42" x="306" y="290" width="100" height="19" fontName="Arial" fontSize="8.0" vTextAlign="Middle">
			<text><![CDATA[DEPOSITOS/ABONOS (+)]]></text>
		</element>
