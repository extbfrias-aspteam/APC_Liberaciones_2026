	</parameter>
	<query language="sql"><![CDATA[select a.cuenta,p.descripcion as producto,a.rendimiento,a.gat_nominal,a.gat_real,p.clave as clave_producto,a.sucursal_id
from ahorro.ahcuentas as a
join productos.prproductos_ahorro as p on a.producto_ahorro_id=p.id
where a.cuenta=$P{P_CUENTA}]]></query>
	<field name="cuenta" class="java.lang.String"/>
	<field name="producto" class="java.lang.String"/>
	<field name="rendimiento" class="java.math.BigDecimal"/>
