			<element kind="subreport" uuid="e9966096-8e1b-4cc8-b5e0-16e829ee0ff5" positionType="Float" x="0" y="423" width="572" height="98">
				<connectionExpression><![CDATA[$P{SUBREPORT_CONNECTION}]]></connectionExpression>
				<expression><![CDATA[$P{SUBREPORT_DIR} + "caratula_subreport1.jasper"]]></expression>
				<parameter name="SUBREPORT_DIR">
					<expression><![CDATA[$P{SUBREPORT_DIR}]]></expression>
