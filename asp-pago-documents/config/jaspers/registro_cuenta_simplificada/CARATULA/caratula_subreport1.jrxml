<jasperReport name="caratula_subreport1" language="java" pageWidth="572" pageHeight="752" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="3003c622-3d2e-47e1-af8d-66e7b1e9a78f">
	<property name="ireport.zoom" value="1.331000000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_SUCURSAL" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["C:\\CEROServicios\\wildfly-10.1.0.Final\\portal\\config\\Reportes\\ahorro\\"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[Select Distinct Coalesce(ru.region,'') as region,
  Case when r.ppal_une= 1 then r.domicilio else rune.domicilio end as dom,
  Coalesce(case when r.ppal_une= 1 then r.telefono else rune.telefono end, '') as tel,
  Coalesce(u.correo, '') as correo,a.condusef
  From regiones r
  left join regiones_une ru on r.region_une_id = ru.id
  left join regiones rune on ru.region_id = rune.clave
  left join usuarios u on ru.empleado_responsable_id = u.no_empleado
  left join agente as a on r.clave=a.region_id
  Where r.clave=$P{P_SUCURSAL} and a.empresa=2;]]></query>
	<field name="region" class="java.lang.String"/>
	<field name="dom" class="java.lang.String"/>
	<field name="tel" class="java.lang.String"/>
	<field name="correo" class="java.lang.String"/>
	<field name="condusef" class="java.lang.String"/>
