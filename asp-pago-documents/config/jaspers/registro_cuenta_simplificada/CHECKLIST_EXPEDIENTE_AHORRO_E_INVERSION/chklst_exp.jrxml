<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="chklst_exp" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="16b959b3-05f9-4808-94ab-5d2a1dce9576">
	<property name="ireport.zoom" value="1.4641000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="288"/>
	<parameter name="P_RUTAIMAGEN" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:/CEROServicios/wildfly-10.1.0.Final/portal/config/Reportes/img"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_NUM_SOLICITANTE" class="java.lang.String"/>
	<parameter name="P_CUENTA" class="java.lang.String"/>
	<queryString>
		<![CDATA[select s.nombre,
(SELECT e.nombres||' '||e.apellido_pat||' '||e.apellido_mat as elaborado
FROM reporte_responsable rr
JOIN empleado as e on rr.puesto_id=e.puesto_asig and rr.sucursal=e.sucursal
WHERE rr.reporte = 'checklist'
AND rr.sucursal= c.region_id
AND rr.rol = 'ELABORO'
AND rr.habilitado = TRUE
AND e.fecha_baja is null
ORDER BY rr.fecha_creacion DESC) AS ELABORO,
(SELECT e.nombres||' '||e.apellido_pat||' '||e.apellido_mat as revisado
FROM reporte_responsable rr
JOIN empleado as e on rr.puesto_id=e.puesto_asig and rr.sucursal=e.sucursal
WHERE rr.reporte = 'checklist'
AND rr.sucursal= c.region_id
AND rr.rol = 'AUTORIZO'
AND rr.habilitado = TRUE
AND e.fecha_baja is null
ORDER BY rr.fecha_creacion DESC) AS REVISO
from solicitante as s
join colonia as c on s.colonia=c.clave
where s.numero=$P{P_NUM_SOLICITANTE}]]>
	</queryString>
	<field name="nombre" class="java.lang.String"/>
	<field name="elaboro" class="java.lang.String"/>
	<field name="reviso" class="java.lang.String"/>
