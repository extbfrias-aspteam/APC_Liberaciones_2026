<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hoja_recomendaciones" pageWidth="612" pageHeight="792" whenNoDataType="NoDataSection" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3c458fd2-7729-434c-bab8-7fa4ceff770e">
	<property name="ireport.zoom" value="1.4641000000000013"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_RUTAIMAGEN" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:/CEROServicios/wildfly-10.1.0.Final/portal/config/Reportes/img"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 1]]>
	</queryString>
	<field name="?column?" class="java.lang.Integer"/>
	<pageHeader>
		<band height="101" splitType="Stretch">
			<image>
				<reportElement x="472" y="20" width="61" height="65" uuid="de740f48-3aa9-46d0-a2b4-9af2fa25efb1"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/exp_sup_emp.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="404" y="0" width="168" height="20" uuid="47313881-f322-4eed-ab9c-23c49597840a"/>
				<textElement textAlignment="Right">
					<font size="8"/>
				</textElement>
				<text><![CDATA[<hoja_recomendaciones.jasper>]]></text>
			</staticText>
			<image>
				<reportElement x="-1" y="21" width="171" height="69" uuid="3fad645c-9de3-4f15-a90a-b7cc6be7510d"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/asp.png"]]></imageExpression>
			</image>
		</band>
	</pageHeader>
	<detail>
		<band height="597" splitType="Stretch">
			<staticText>
				<reportElement x="15" y="335" width="259" height="45" uuid="a588fb48-b321-40ac-8857-abd74a70a497"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[	Comunicarse vía telefónica o acudir a sucursal con
un día de anticipación y dar aviso de la cantidad que desea
retirar en efectivo o cheque al día siguiente o solicitar le sea
transferido vía SPEI a una cuenta bancaria.]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="572" height="20" forecolor="#FFFFFF" backcolor="#0000CC" uuid="a135cb06-6840-4dc5-ad32-eb2c6d161bef"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" isBold="true"/>
				</textElement>
				<text><![CDATA[RECOMENDACIONES PARA OBTENER LOS MEJORES BENEFICIOS DE "MI AHORRO", "MI TANDA" Y "MI DEBITO"]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="36" width="572" height="20" uuid="0fc812b3-0b52-4a82-b348-0763c1612f2f"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" isBold="true"/>
				</textElement>
				<text><![CDATA[Recomendaciones para abonos o retiros de su cuenta de ahorro:]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="92" width="14" height="20" uuid="a1ef97d6-8faa-4f76-96ce-7eba6e8a80d2"/>
				<text><![CDATA[1:]]></text>
			</staticText>
			<image>
				<reportElement x="15" y="82" width="46" height="30" uuid="2663dadb-13c9-4766-8783-91e605ae77ca"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/coins.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="15" y="104" width="259" height="51" uuid="0c9c4f38-6559-4f3e-8438-e8307b69fa95"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[	Los depósitos a su cuenta de Mi ahorro y Mi Tanda, le
permitirán ir creando un patrimonio y respaldo financiero para sus
imprevistosfamiliares y créditos de ASP Integra Opciones, por lo
que se le recomienta que realice depósitos continuosa sus
cuentas.]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="181" width="14" height="20" uuid="587c3365-1faf-4a18-926d-6ddec0b4b065"/>
				<text><![CDATA[2:]]></text>
			</staticText>
			<staticText>
				<reportElement x="15" y="181" width="259" height="51" uuid="345a1c4f-7aef-4ff5-853d-3bde1e6f6ceb"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[Deberá llevar consigo su tarjeta de movimientos al momento de
acudir a realizar un depósito, retiro o solicitar un estado de cuenta,
así como su identificación oficial, en el caso de extravío o daño de
su tarjeta, podrá asistir a nuestras oficinas para solicitar un repuesto
sin costo alguno.
]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="254" width="14" height="20" uuid="461c5028-3b27-4005-a37e-e282489f855d"/>
				<text><![CDATA[3:]]></text>
			</staticText>
			<staticText>
				<reportElement x="15" y="254" width="259" height="33" uuid="8679eb02-4083-4daf-97e3-e3f10a60a1b1"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[Puede realizar depósitos a su cuenta por alguna de las diversas
redes de pago que se le indican en su tarjeta de movimientos, como
lo son Mini Sucursal “Fácil”, SPEI, o Bancos.]]></text>
			</staticText>
			<staticText>
				<reportElement x="15" y="312" width="259" height="20" uuid="0c5d597b-9d14-40a1-8ffe-97913a1d40bd"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[Puede realizar un retiro de su cuenta por alguna de las siguientes
opciones:]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="312" width="14" height="20" uuid="d3e1c462-5e83-4a1e-9919-536d359be9e1"/>
				<text><![CDATA[4:]]></text>
			</staticText>
			<image>
				<reportElement x="15" y="335" width="16" height="12" uuid="1570adce-1530-4e96-b1f1-b0ed8f4d7654"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/check-small.png"]]></imageExpression>
			</image>
			<image>
				<reportElement x="311" y="104" width="16" height="12" uuid="ec671f79-fcfb-4797-9647-607d72ea652f"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/check-small.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="311" y="104" width="259" height="45" uuid="0a6ae8d7-2690-4994-bd6e-f1bac389568c"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[		También puede realizar sus retiros
directamente en una Mini Sucursal “Fácil”, su retiro será inmediato,
sólo le será requerido su NIP]]></text>
			</staticText>
			<image>
				<reportElement x="327" y="94" width="56" height="22" uuid="1e61eaad-12da-40db-98be-200ec830cbb9"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/vf-icon.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="311" y="181" width="259" height="20" uuid="da0126b6-9b84-45ff-95a3-5a7904283026"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[Si no cuenta con su NIP, podrá acudir a nuestras oficinas donde
podrá tramitarlo sin costo.]]></text>
			</staticText>
			<staticText>
				<reportElement x="297" y="181" width="14" height="20" uuid="a3a257e6-1d9d-49c9-8c4b-4db4f92e6e77"/>
				<text><![CDATA[5:]]></text>
			</staticText>
			<staticText>
				<reportElement x="310" y="232" width="259" height="20" uuid="e6e9c198-73ff-4a02-921b-21d7e6c0fd83"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[Al momento de realizar sus depósitos deberá de revisar lo siguiente:
]]></text>
			</staticText>
			<staticText>
				<reportElement x="296" y="232" width="14" height="20" uuid="4ba0a0ef-8e30-439d-a4e4-7f8add0ce788"/>
				<text><![CDATA[6:]]></text>
			</staticText>
			<staticText>
				<reportElement x="311" y="254" width="259" height="33" uuid="a3b94e85-efde-4afc-ba0b-8fda952ea6d7"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[	Que el número de cuenta y el número de referencia que
muestra el recibo, sean los mismos que aparecen en su tarjeta de
movimientos]]></text>
			</staticText>
			<image>
				<reportElement x="310" y="252" width="16" height="12" uuid="19251120-b1b9-4cbc-957c-b87f9d567924"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/check-small.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="311" y="299" width="259" height="23" uuid="8a1fb286-8612-4313-9995-671c0c60856e"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[	Que la cantidad del depósito sea la correcta, conforme a su
requerimiento.]]></text>
			</staticText>
			<image>
				<reportElement x="310" y="299" width="16" height="12" uuid="1b665a4f-d14d-4f80-b197-5135bf011120"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/check-small.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="310" y="335" width="259" height="27" uuid="5baaa1e2-b60b-4c35-850a-dba460a4e024"/>
				<textElement textAlignment="Justified">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[	Que aparezca legiblemente la fecha, el sello y la firma del
cajero, en caso de pagar en el Banco.
]]></text>
			</staticText>
			<image>
				<reportElement x="310" y="332" width="16" height="12" uuid="db9aeff6-7277-4ef8-b4f2-6db220ccec74"/>
				<imageExpression><![CDATA[$P{P_RUTAIMAGEN}+"/check-small.png"]]></imageExpression>
			</image>
			<staticText>
				<reportElement x="1" y="481" width="570" height="13" uuid="ae5e47e4-e1b4-4c3d-aaff-3675f1419581"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="html">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[Para mayor información, favor de comunicarse al <b>01-800-462-73-73.</b>]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="494" width="570" height="13" uuid="a5d5c96f-f1fb-4977-9222-829875883b21"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="html">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[o bien ingresa a <u>www.aspintegraopciones.com</u>]]></text>
			</staticText>
			<staticText>
				<reportElement x="1" y="507" width="570" height="13" uuid="350c0b35-285c-44fa-bdf7-567d2f043ab9"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="html">
					<font fontName="Arial" size="8"/>
				</textElement>
				<text><![CDATA[y envíanos tus comentarios.]]></text>
			</staticText>
		</band>
	</detail>
