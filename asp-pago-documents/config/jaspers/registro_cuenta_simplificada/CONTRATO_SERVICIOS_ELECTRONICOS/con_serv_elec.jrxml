<jasperReport name="con_serv_elec" language="java" pageWidth="612" pageHeight="792" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="60a40d5f-426e-40b6-a8e6-e90ef905ba96">
	<property name="ireport.zoom" value="1.7715610000000086"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="672"/>
	<parameter name="P_RUTAIMAGEN" forPrompting="false" class="java.lang.String">
		<defaultValueExpression><![CDATA["\\opt\\wildfly-10.1.0.Final\\portal\\config\\Reportes\\img"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_SOLICITANTE" class="java.lang.String"/>
	<parameter name="P_SUCURSAL_ID" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String">
		<defaultValueExpression><![CDATA["/opt/wildfly-10.1.0.Final/portal/config/Reportes/contrato_ahorro/"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_EMPRESA_ID" class="java.lang.String"/>
	<parameter name="P_AGENTE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[select s.nombre as nombre_cliente_completo,case  when s.t_persona ='F' then 'Fisica' else 'Moral' end  as tipo_persona,
s.nombre_p as nombre_cliente,s.apellidos as apellido_paterno,s.apellido_m as apellido_materno,
(coalesce(s.rfc1,'')||coalesce(s.rfc2,'')||coalesce(s.rfc3,'')) as rfc,
case when coalesce(s.telefono,'')='' then coalesce(s.celular,'') else coalesce(s.telefono,'') end as telefono,
s.domicilio,c.nombre as colonia,c.cp,l.descripcion as localidad,e.nombre as estado,
s2.nombre as representante_legal,a.sucursal as sucursal_id,rg.nombre as sucursal,
a.nombre as empresa,
--a.titulo as lugar,g.responsa as responsable,
rg2.domicilio as domicilio_une,u.correo as correo_une,
cast(EXTRACT(YEAR FROM CURRENT_TIMESTAMP) as integer) as anio,
(select mes from meses where id=EXTRACT(MONTH FROM CURRENT_TIMESTAMP)) as mes,
cast(EXTRACT(DAY FROM CURRENT_TIMESTAMP) as integer) as dia,
(select r.telefono from regiones as r where r.clave=1) as numeroMatriz,
(select reca from reca_ahorro where tipo_ahorro_id=1) as reca_inversion,
(select reca from reca_ahorro where tipo_ahorro_id=2) as reca_ahorro,
(select reca from reca_ahorro where tipo_ahorro_id=3) as reca_tanda,
(select reca from reca_ahorro where tipo_ahorro_id=15) as reca_debito,
(select reca from reca_ahorro where tipo_ahorro_id=6) as reca_facil,
(select titulo from agente where clave=$P{P_AGENTE}) as lugar,
(select responsa from generales where clave=$P{P_AGENTE}) as responsable
from solicitante as s
left join representantes as r on s.numero=r.id_solicitante
left join solicitante as s2 on r.id_representante=s2.numero
join colonia as c on s.colonia=c.clave
join localidades as l on c.localidad_id=l.clave
join catmpio as m on l.catmpio_id=m.cmpiompio
join estatal as e on m.estado_id=e.clave
join regiones as rg on c.region_id=rg.clave
join agente as a on rg.clave=a.sucursal
join generales as g on a.clave=g.clave
left join regiones_une as ru on rg.region_une_id=ru.id
left join regiones as rg2 on ru.region_id=rg2.clave
left join usuarios as u on ru.empleado_responsable_id=u.no_empleado
where s.numero= $P{P_SOLICITANTE} limit 1;]]></query>
	<field name="nombre_cliente_completo" class="java.lang.String"/>
	<field name="tipo_persona" class="java.lang.String"/>
	<field name="nombre_cliente" class="java.lang.String"/>
	<field name="apellido_paterno" class="java.lang.String"/>
	<field name="apellido_materno" class="java.lang.String"/>
	<field name="rfc" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="domicilio" class="java.lang.String"/>
	<field name="colonia" class="java.lang.String"/>
	<field name="cp" class="java.lang.String"/>
	<field name="localidad" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="representante_legal" class="java.lang.String"/>
	<field name="sucursal_id" class="java.lang.String"/>
	<field name="sucursal" class="java.lang.String"/>
	<field name="empresa" class="java.lang.String"/>
	<field name="domicilio_une" class="java.lang.String"/>
	<field name="correo_une" class="java.lang.String"/>
	<field name="anio" class="java.lang.Integer"/>
	<field name="mes" class="java.lang.String"/>
	<field name="dia" class="java.lang.Integer"/>
	<field name="numeromatriz" class="java.lang.String"/>
	<field name="reca_facil" class="java.lang.String"/>
	<field name="lugar" class="java.lang.String"/>
	<field name="responsable" class="java.lang.String">
		<description><![CDATA[Funcionario o responsable de los créditos del bucket]]></description>
	</field>
