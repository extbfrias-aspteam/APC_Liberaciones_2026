				<text><![CDATA[ASP Integra Opciones]]></text>
			</element>
			<element kind="textField" uuid="c8f1401f-79dc-45ce-ada1-ecdb054783e4" x="285" y="555" width="285" height="14" fontName="DejaVu Sans" fontSize="8.0" hTextAlign="Center">
