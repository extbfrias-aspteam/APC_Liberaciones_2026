<jasperReport name="TarjetaAhorro" language="java" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8a1ff505-aa50-4113-a349-eba4b1a14099">
	<property name="ireport.zoom" value="3.797498335832415"/>
