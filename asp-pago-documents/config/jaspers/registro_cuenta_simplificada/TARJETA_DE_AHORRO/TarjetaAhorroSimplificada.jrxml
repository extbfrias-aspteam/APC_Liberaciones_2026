	<parameter name="P_RUTAIMAGEN" class="java.lang.String"/>
	<parameter name="P_CUENTA" class="java.lang.String"/>
	<parameter name="P_CLABE_INT" class="java.lang.String"/>
	<parameter name="P_REFERENCIA" class="java.lang.String"/>
	<parameter name="P_SOLICITANTE" class="java.lang.String"/>
	<parameter name="P_REGION" class="java.lang.String"/>
	<query language="sql"><![CDATA[select $P{P_CUENTA} AS cuenta,$P{P_REFERENCIA} as referencia,$P{P_CLABE_INT} as cuenta_int,
$P{P_SOLICITANTE} as solicitante,
ce.nombre as nombre_empresa,a.telefono,a.domicilio
from agente as A
left join cat_empresas as ce on ce.clave = a.empresa
where a.region_id=$P{P_REGION} LIMIT 1]]></query>
	<field name="cuenta" class="java.lang.String"/>
	<field name="referencia" class="java.lang.String"/>
