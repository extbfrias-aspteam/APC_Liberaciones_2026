<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="contrato_subreport2" pageWidth="572" pageHeight="752" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="d6027d8c-754c-46cf-a326-1240b205f224">
	<property name="ireport.zoom" value="1.1"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_PRODUCTO_ID" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select c.descripcion,ca.monto, f.descripcion as periodicidad
from productos.prcomisiones_ahorro as ca
join productos.prcomisiones as c on ca.comision_id=c.id
join nucleocentral.ncperiodicidad_comisiones as f on f.id = ca.periodicidad_id
where ca.producto_id=(select id from productos.prproductos_ahorro where clave = 'DEBITO')
and c.estatus_id = (select id from nucleocentral.ncestatus where descripcion = 'ALTA')
order by c.id asc]]>
	</queryString>
	<field name="descripcion" class="java.lang.String"/>
	<field name="monto" class="java.math.BigDecimal"/>
	<field name="periodicidad" class="java.lang.String"/>
