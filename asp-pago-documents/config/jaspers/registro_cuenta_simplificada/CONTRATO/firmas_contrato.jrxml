<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="firmas_contrato" pageWidth="220" pageHeight="200" columnWidth="220" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a423a284-cbb3-4e8b-86f3-f262bfa8d154">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NUM_SOLICITANTE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select case when s.t_persona ='F' then s.nombre else s2.nombre end  as nombre_persona
from solicitante as s
left join representantes as r on s.numero=r.id_solicitante
left join solicitante as s2 on r.id_representante=s2.numero
where s.numero=$P{P_NUM_SOLICITANTE};]]>
	</queryString>
	<field name="nombre_persona" class="java.lang.String"/>
	<detail>
		<band height="34" splitType="Stretch">
			<line>
				<reportElement x="0" y="13" width="220" height="1" uuid="9bd951ba-a5de-470d-9280-2491fb5b2e21"/>
			</line>
			<textField>
				<reportElement x="0" y="14" width="220" height="20" uuid="60c65375-e4e0-4a14-972e-93c23d8e4496"/>
				<textElement textAlignment="Center">
					<font fontName="DejaVu Sans" size="10"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{nombre_persona}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
</jasperReport>
