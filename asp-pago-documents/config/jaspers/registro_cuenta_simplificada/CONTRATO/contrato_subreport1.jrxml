	<queryString>
		<![CDATA[select a.persona_id,a.relacion_id,a.porcentaje
from ahorro.ahcuentas_beneficiarios as a
join ahorro.ahcuentas as c on a.cuenta_id=c.id
where a.estatus_id=1 and c.cuenta=$P{P_CUENTA}]]>
