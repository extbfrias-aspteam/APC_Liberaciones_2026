<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="contrato_subreport1_subreport1" pageWidth="572" pageHeight="752" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="32b9c90b-4f73-4a09-a3b4-915ba15b2585">
	<property name="ireport.zoom" value="1.1"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="P_NUM_SOLICITANTE" class="java.lang.String"/>
	<parameter name="P_RELACION_ID" class="java.lang.String"/>
	<parameter name="P_PORCENTAJE" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select s.nombre,s.domicilio,c.nombre as colonia,c.cp,l.descripcion as localidad,e.nombre as estado,
case when coalesce(s.telefono,'')='' then coalesce(s.celular,'') else coalesce(s.telefono,'') end as telefono,
s.correo,(coalesce(s.rfc1,'')||coalesce(s.rfc2,'')||coalesce(s.rfc3,'')) as rfc,
(select descripcion from cat_relacion where id=$P{P_RELACION_ID}) as relacion
from solicitante as s
join colonia as c on s.colonia=c.clave
join localidades as l on c.localidad_id=l.clave
join catmpio as m on l.catmpio_id=m.cmpiompio
join estatal as e on m.estado_id=e.clave
where s.numero=$P{P_NUM_SOLICITANTE}]]>
	</queryString>
	<field name="nombre" class="java.lang.String"/>
	<field name="domicilio" class="java.lang.String"/>
	<field name="colonia" class="java.lang.String"/>
	<field name="cp" class="java.lang.String"/>
	<field name="localidad" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="correo" class="java.lang.String"/>
	<field name="rfc" class="java.lang.String"/>
	<field name="relacion" class="java.lang.String"/>
	<detail>
