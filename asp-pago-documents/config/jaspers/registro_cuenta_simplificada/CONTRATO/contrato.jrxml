				<textFieldExpression><![CDATA["REPOSICIÓN DE TARJETA POR DETERIORO"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="253" width="247" height="27" uuid="16d77e28-8890-4699-9c8a-e6efb5116e48"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["REPOSICIÓN DE TARJETA POR ROBO Y/O EXTRAVÍO"]]></textFieldExpression>
			</textField>
			<textField>
