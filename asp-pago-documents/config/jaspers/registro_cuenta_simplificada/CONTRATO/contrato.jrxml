	<parameter name="PORCENTAJE_B" class="java.lang.String"/>
	<queryString>
		<![CDATA[select s.nombre as nombre_cliente_completo, s.t_persona as tipo_persona,
s.nombre_p as nombre_cliente,s.apellidos as apellido_paterno,s.apellido_m as apellido_materno,
(coalesce(s.rfc1,'')||coalesce(s.rfc2,'')||coalesce(s.rfc3,'')) as rfc,
case when coalesce(s.telefono,'')='' then coalesce(s.celular,'') else coalesce(s.telefono,'') end as telefono,
s.domicilio,c.nombre as colonia,c.cp,l.descripcion as localidad,e.nombre as estado,
s2.nombre as representante_legal,a.sucursal as sucursal_id,rg.nombre as sucursal,
--a.titulo as lugar,g.responsa as responsable,
rg2.domicilio as domicilio_une,u.correo as correo_une,
cast(EXTRACT(YEAR FROM CURRENT_TIMESTAMP) as integer) as anio,
(select mes from meses where id=EXTRACT(MONTH FROM CURRENT_TIMESTAMP)) as mes,
cast(EXTRACT(DAY FROM CURRENT_TIMESTAMP) as integer) as dia,
(select r.telefono from regiones as r where r.clave=1) as numeroMatriz,
(select reca from reca_ahorro where tipo_ahorro_id=1) as reca_inversion,
(select reca from reca_ahorro where tipo_ahorro_id=2) as reca_ahorro,
(select reca from reca_ahorro where tipo_ahorro_id=3) as reca_tanda,
(select reca from reca_ahorro where tipo_ahorro_id=15) as reca_debito,
(select reca from reca_ahorro where tipo_ahorro_id=6) as reca_facil,
(select titulo from agente where clave=$P{P_AGENTE}) as lugar,
(select responsa from generales where clave=$P{P_AGENTE}) as responsable,
(select c.nombre from generales as p
join agente as a on p.clave=a.clave
join cat_empresas as c on c.clave=a.empresa
where a.clave='SUCVIRTUAL') as empresa
from solicitante as s
left join representantes as r on s.numero=r.id_solicitante
left join solicitante as s2 on r.id_representante=s2.numero
join colonia as c on s.colonia=c.clave
join localidades as l on c.localidad_id=l.clave
join catmpio as m on l.catmpio_id=m.cmpiompio
join estatal as e on m.estado_id=e.clave
join regiones as rg on c.region_id=rg.clave
join agente as a on rg.clave=a.sucursal
join generales as g on a.clave=g.clave
left join regiones_une as ru on rg.region_une_id=ru.id
left join regiones as rg2 on ru.region_id=rg2.clave
left join usuarios as u on ru.empleado_responsable_id=u.no_empleado
where s.numero= $P{P_NUM_SOLICITANTE} limit 1;]]>
	</queryString>
