			<textField>
				<reportElement x="57" y="306" width="460" height="91" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<box topPadding="4" leftPadding="3"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["CONTRATO DE APERTURA DE CUENTA DE DEPOSITO A LA VISTA QUE CELEBRAN POR UNA PARTE "+$F{empresa}+", REPRESENTADA EN ESTE ACTO POR <u>"+$F{responsable}+"</u>, A QUIEN EN LO SUCESIVO SE LE DENOMINARÁ COMO “ASP INTEGRA OPCIONES” Y POR OTRA PARTE <u>"+$F{nombre_cliente_completo}+"</u>, A QUIEN EN LO SUCESIVO SE LE DENOMINARÁ COMO “EL CLIENTE”, CONVENIO QUE LAS PARTES SUJETAN A LAS SIGUIENTES DEFINICIONES, DECLARACIONES Y CLAUSULAS"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="1" y="397" width="572" height="15" uuid="f71ab462-5e28-481e-81ee-48627f817f52"/>
				<box leftPadding="2"/>
				<textElement textAlignment="Center">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<text><![CDATA[DECLARACIONES]]></text>
			</staticText>
			<textField>
				<reportElement x="73" y="430" width="441" height="247" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<box topPadding="4" leftPadding="3"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["ESCRITURA PÚBLICA NO.18220 (DIECIOCHO MIL DOSCIENTOS VEINTE), VOL.430 (CUATROCIENTOS TREINTA) DE FECHA 30 DE ABRIL DEL 2004, OTORGADA ANTE LA FE DEL LIC. OSCAR AMADOR ENCINAS ,TITULAR DE LA NOTARIA PUBLICA NO.9, DE LA PAZ, B.C.S., MEXICO, DICHA ESCRITURA ESTA INSCRITA EN EL REGISTRO PUBLICO DE LA PROP Y DEL COM DE LA PAZ, B.C.S.,CON EL FOLIO NO.11235-1 DE LA SECCION COMERCIO DEL DIA 15 DE MARZO DEL 2005 TRANSFORMANDO SU REGIMEN JURIDICO A SOCIEDAD FINANCIERA POPULAR TAL Y COMO SE DESPRENDE DE LA ESCRITURA PUBLICA NUMERO 26,037 (VEINTISEIS MIL TREINTA Y SIETE) VOLUMEN 652 (SEISCIENTOS CINCUENTA Y DOS) DE FECHA 24 DE OCTUBRE DEL 2008, LEVANTADA ANTE LA FE DEL NOTARIO PUBLICO NUMERO 9, LIC. OSCAR AMADOR ENCINAS, CON RESIDENCIA EN LA CIUDAD DE LA PAZ, BAJA CALIFORNIA SUR, DEBIDAMENTE INSCRITA ANTE EL REGISTRO PUBLICO DE LA PROPIEDAD Y DEL COMERCIO DE LA CIUDAD DE LA PAZ, BAJA CALIFORNIA SUR, BAJO EL FOLIO MERCANTIL ELECTRONICO NUMERO 11235-1 DE FECHA 24 DE OCTUBRE DEL 2008. LA C. ANGELES DOMINGUEZ QUINTERO ACREDITA LA FACULTAD CON LA COMPARECE MEDIANTE LA ESCRITURA PUBLICA NO. 35,757 (TREINTA Y CINCO MIL SETECIENTOS CINCUENTA Y SIETE), VOL.910 (NOVECIENTOS DIEZ), DE FECHA 22 DE ENERO DEL 2018, OTORGADA ANTE LA FE DEL LIC. OSCAR AMADOR ENCINAS, NOTARIO PUBLICO NO. 9, DE LA PAZ, B.C.S., INSCRITA EN EL REGISTRO PUBLICO DE LA PROPIEDAD Y DEL COMERCIO DE LA MISMA CIUDAD, MEDIANTE EL FOLIO MERCANTIL ELECTRONICO NUMERO 11235-1, DE FECHA 14 DE FEBRERO DEL 2018."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="54" y="414" width="460" height="16" uuid="f71ab462-5e28-481e-81ee-48627f817f52"/>
				<box leftPadding="2"/>
				<textElement textAlignment="Left">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<text><![CDATA[I.-DECLARA "ASP INTEGRA OPCIONES" POR CONDUCTO DE SU APODERADO LEGAL, QUE:]]></text>
			</staticText>
			<textField>
				<reportElement x="54" y="434" width="19" height="18" uuid="d630bb03-acb1-4d74-9439-0dcf093ff7c8"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["a)"]]></textFieldExpression>
			</textField>
		</band>
		<band height="678">
			<textField>
				<reportElement x="73" y="138" width="441" height="49" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["QUE CUENTA CON UNA PÁGINA EN LA RED ELECTRÓNICA DE INTERNET, UTILIZADA COMO HERRAMIENTA INFORMÁTICA PARA LA OFERTA DE SUS PRODUCTOS FINANCIEROS Y UN ENLACE INFORMATIVO HACIA SUS CLIENTES, CUYA DIRECCIÓN ES: WWW.ASPINTEGRAOPCIONES.COM ."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="191" width="460" height="18" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["II. DECLARA EL CLIENTE"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="73" y="84" width="441" height="54" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["LA CARÁTULA FORMA PARTE INTEGRANTE DEL CONTRATO DE ADHESIÓN, POR LO QUE SE ENCUENTRA INSCRITA COMO ANEXO AL CONTRATO MISMO QUE SE ENCUENTRA DEBIDAMENTE INSCRITO EN EL REGISTRO DE CONTRATOS DE ADHESIÓN DE LA CONDUSEF BAJO LOS SIGUIENTES NÚMEROS: <u>"+$F{reca_facil} +"</u>"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="73" y="210" width="441" height="55" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["POR SU PROPIO DERECHO O A TRAVÉS DE SU REPRESENTANTE O APODERADO LEGAL QUE LA INFORMACIÓN CONTENIDA EN EL ANEXO A, SON SUS DATOS GENERALES, PERSONAS AUTORIZADAS PARA DISPONER DE LOS RECURSOS DE SUS CUENTAS, Y BENEFICIARIOS ASIGNADOS."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="73" y="266" width="441" height="29" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["QUE ES SU VOLUNTAD CELEBRAR EL PRESENTE CONTRATO Y QUE CUENTA CON FACULTADES SUFICIENTES PARA ASÍ HACERLO."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="73" y="349" width="441" height="57" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["QUE ASP INTEGRA OPCIONES LE PROPORCIONÓ LOS SIGUIENTES DATOS DE LA CONDUSEF: COMISIÓN NACIONAL PARA LA PROTECCIÓN Y DEFENSA DE LOS USUARIOS DE SERVICIOS FINANCIEROS: TELÉFONO 5553400999. PÁGINA DE INTERNET: WWW.CONDUSEF.GOB.MX Y EL CORREO ASESORÍA@CONDUSEF.GOB.MX."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="404" width="457" height="40" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EXPUESTO LO ANTERIOR, LAS PARTES SE RECONOCEN LA PERSONALIDAD CON LA QUE COMPARECEN, MANIFESTANDO ESTAR DE ACUERDO DE ACUERDO EN OBLIGARSE DE CONFORMIDAD CON LAS SIGUIENTES CLAUSULAS:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="76" y="444" width="412" height="16" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Center" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["CLAUSULAS GENERALES"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="76" y="458" width="412" height="17" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Center" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["CUENTA FACIL ASP"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="477" width="457" height="74" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["PRIMERA.- DEL CONTRATO.- EN TÉRMINOS DEL PRESENTE CONTRATO, EL CLIENTE PODRÁ CONSIGNAR, A TRAVÉS DE LOS MECANISMOS QUE MÁS ADELANTE SE ESTABLECEN, DIVERSAS CANTIDADES DE DINERO QUE SERÁN RECIBIDAS POR ASP INTEGRA OPCIONES EN CALIDAD DE DEPÓSITO A LA VISTA, EL CLIENTE PODRÁ LLEVAR A CABO EN DÍAS Y HORAS HÁBILES PARA ASP INTEGRA OPCIONES LAS OPERACIONES QUE SE ENLISTAN A CONTINUACIÓN:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="559" width="425" height="16" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["APERTURA DE CUENTA DE DEPÓSITO A LA VISTA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="575" width="425" height="28" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["RETIRO DE EFECTIVO CON CARGO AL SALDO DISPONIBLE DE SU CUENTA DE DEPÓSITO A LA VISTA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="603" width="425" height="16" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["CONSULTA DE SALDOS, MOVIMIENTOS E INFORMACIÓN FINANCIERA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="619" width="425" height="16" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["PAGO DE CRÉDITOS."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="636" width="425" height="16" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["CUALQUIER OTRA OPERACIÓN QUE SE LLEGARE A AUTORIZAR."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="73" y="56" width="441" height="28" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL REGISTRO FEDERAL DE CONTRIBUYENTES DE SU REPRESENTADA ES: OEN040430H19."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="73" y="19" width="441" height="40" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["SEÑALA COMO DOMICILIO PARA TODOS LOS EFECTOS DERIVADOS DE LA CELEBRACIÓN DEL PRESENTE CONTRATO EL UBICADO EN: DELFINES SN, COL. FIDEPAZ, BAJA CALIFORNIA SUR, LA PAZ, C.P. 23090."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="19" width="19" height="18" uuid="d630bb03-acb1-4d74-9439-0dcf093ff7c8"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["b)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="56" width="19" height="18" uuid="d630bb03-acb1-4d74-9439-0dcf093ff7c8"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["c)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="84" width="19" height="17" uuid="d630bb03-acb1-4d74-9439-0dcf093ff7c8"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["d)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="138" width="19" height="18" uuid="d630bb03-acb1-4d74-9439-0dcf093ff7c8"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["e)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="210" width="19" height="17" uuid="d630bb03-acb1-4d74-9439-0dcf093ff7c8"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["a)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="266" width="19" height="18" uuid="d630bb03-acb1-4d74-9439-0dcf093ff7c8"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["b)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="349" width="19" height="18" uuid="d630bb03-acb1-4d74-9439-0dcf093ff7c8"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["d)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="73" y="297" width="441" height="53" uuid="a623bfa9-3ef6-4b8e-bd14-05cb19e9897b"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["QUE PREVIO A LA FIRMA DEL PRESENTE CONTRATO, SE LE HIZO DE SU CONOCIMIENTO EL CONTENIDO ÍNTEGRO DE ESTE DOCUMENTO, ASÍ COMO DE SUS ANEXOS, LOS CARGOS Y/O COMISIONES QUE PUDIERA CAUSAR EN TÉRMINOS DE LO SEÑALADO EN LA CLÁUSULA DÉCIMA SEGUNDA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="54" y="297" width="19" height="17" uuid="362e1a36-00f7-4155-8cee-ae350582f566"/>
				<textElement>
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["c)"]]></textFieldExpression>
			</textField>
		</band>
		<band height="678">
			<textField>
				<reportElement x="57" y="95" width="457" height="81" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["TERCERA.- DE LA AUTORIZACIÓN.- .- EL CLIENTE PODRÁ AUTORIZAR A UNA O VARIAS PERSONAS PARA QUE EN SU NOMBRE Y REPRESENTACIÓN CON EL CARÁCTER DE MANDATARIOS HAGAN USO DE LOS SERVICIOS QUE FUERAN NECESARIOS EN SU NÚMERO DE CUENTA CON SU NÚMERO DE CLIENTE (PERSONAS AUTORIZADAS). PARA TAL EFECTO, SERÁ SUFICIENTE QUE EL CLIENTE OTORGUE SU AUTORIZACIÓN ANTE ASP INTEGRA OPCIONES EN LOS FORMATOS ESTABLECIDOS QUE PARA TAL EFECTO LE PROPORCIONE A ASP INTEGRA OPCIONES."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="179" width="457" height="139" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["CUARTA.- DE LA RESPONSABILIDAD DE USO DE LA CUENTA.- EL CLIENTE SE HACE RESPONSABLE DEL BUEN USO QUE SE DE A SU CUENTA Y AL USO DE LOS SERVICIOS QUE ASP INTEGRA OPCIONES LE PROPORCIONE, POR LO CUAL SERÁ RESPONSABILIDAD DEL CLIENTE CUALESQUIERA DE LAS OPERACIONES QUE SE AUTORICEN POR EL CLIENTE O POR LAS PERSONAS AUTORIZADAS. ASP INTEGRA OPCIONES LE HACE DE SU CONOCIMIENTO EN ESTE ACTO QUE, EN CASO DE PERMITIR QUE UN TERCERO UTILICE SU CUENTA SIN HABERLO HECHO DEL CONOCIMIENTO DE ASP INTEGRA OPCIONES O BIEN LLEVE A CABO EL OCULTAMIENTO DE INFORMACIÓN, TRIANGULACIÓN, O ACTUAR A FAVOR DE UN TERCERO UTILIZANDO SU IDENTIDAD, PUEDA DAR LUGAR A QUE EL CLIENTE O EL TERCERO HAGAN USO INDEBIDO DE LA CUENTA, PODRÁ LLEGAR A CONSTITUIR LA COMISIÓN DE UN DELITO DE CONFORMIDAD CON LA LEGISLACIÓN APLICABLE EN LA MATERIA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="317" width="457" height="63" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["QUINTA.- DE LA CONFIDENCIALIDAD.- CON EXCEPCIÓN DE LOS CASOS PREVISTOS POR LA LEY, ASP INTEGRA OPCIONES NO PODRÁ DAR NOTICIAS O PROPORCIONAR INFORMACIÓN SOBRE LOS MOVIMIENTOS OPERADOS, EL ESTADO QUE GUARDE LA CUENTA DEL CLIENTE, O LAS OPERACIONES QUE A SU AMPARO SE REALICEN, SINO ÚNICAMENTE A EL CLIENTE, A SUS REPRESENTANTES LEGALES, O A LAS PERSONAS AUTORIZADAS."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="379" width="457" height="87" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL CLIENTE AUTORIZA A ASP INTEGRA OPCIONES PARA REALIZAR, EN TODO MOMENTO INVESTIGACIONES Y PROPORCIONAR REPORTES O INFORMACIÓN A LOS ORGANISMOS DE SUPERVISIÓN QUE ASP INTEGRA OPCIONES TUVIERE, O A LAS SOCIEDADES DE INFORMACIÓN CREDITICIA QUE FUERAN AUTORIZADAS POR LA SECRETARIA DE HACIENDA Y CRÉDITO PÚBLICO, ACERCA DE LAS OPERACIONES CELEBRADAS CON ASP INTEGRA OPCIONES, EL CUAL CONOCE LA NATURALEZA Y EL ALCANCE DE LA INFORMACIÓN QUE SE SOLICITARÁ Y PROPORCIONARÁ."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="467" width="457" height="53" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["SEXTA.- CANCELACIÓN.-EL CLIENTE PODRÁ SOLICITAR LA CANCELACIÓN DEL PRESENTE CONTRATO DENTRO DE LOS DIEZ DÍAS HÁBILES POSTERIORES A SU FIRMA SIN RESPONSABILIDAD, SIEMPRE Y CUANDO EL CLIENTE NO HAYA UTILIZADO U OPERADO LOS PRODUCTOS O SERVICIOS FINANCIEROS CONTRATADOS."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="521" width="457" height="115" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["SÉPTIMA.- CESION.-. ASP INTEGRA OPCIONES PODRÁ CEDER O TRANSMITIR A FAVOR DE TERCERAS PERSONAS QUE EN SU CASO CUENTEN CON LA CAPACIDAD, EN PROPIEDAD O EN GARANTÍA, LOS DERECHOS Y OBLIGACIONES DERIVADOS DE LA RELACIÓN CONTRACTUAL QUE SOSTENGA CON EL CLIENTE BASTANDO UNA NOTIFICACIÓN A ESTE ÚLTIMO, MISMA QUE SE REALIZARÁ EN UN PLAZO DE 30 (TREINTA) DÍAS NATURALES SIGUIENTES A QUE SE REALICE LA CESIÓN O TRANSMISIÓN. EL CLIENTE NO PODRÁ CEDER, TRANSFERIR, NEGOCIAR, ENAJENAR O TRANSMITIR EN FORMA ALGUNA LOS DERECHOS Y OBLIGACIONES QUE A SU FAVOR SE DERIVEN DEL PRESENTE CONTRATO ÚNICO A PERSONA ALGUNA SIN AUTORIZACIÓN PREVIA Y POR ESCRITO DE ASP INTEGRA OPCIONES."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="6" width="457" height="89" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["SEGUNDA.- DE LAS FACULTADES.-EN CUALQUIER MOMENTO ASP INTEGRA OPCIONES PODRÁ REQUERIR A EL CLIENTE LOS DOCUMENTOS QUE EXIJAN LAS LEYES Y LAS DISPOSICIONES DE CARÁCTER GENERAL Y EN ESPECIAL QUE EMITAN LAS AUTORIDADES CORRESPONDIENTES O LOS QUE ASP INTEGRA OPCIONES ESTIME NECESARIOS PARA CERCIORARSE DE LA IDENTIDAD Y DE LOS ATRIBUTOS DE LA PERSONALIDAD DE EL CLIENTE Y EN CASO DE QUE ESTOS NO SE PRESENTEN PODRÁ DAR POR TERMINADA LA RELACIÓN CON EL CLIENTE SIN PREVIO AVISO."]]></textFieldExpression>
			</textField>
		</band>
		<band height="678" splitType="Stretch">
			<textField>
				<reportElement x="57" y="302" width="457" height="33" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["ASP INTEGRA OPCIONES NO PODRÁ COBRAR A EL CLIENTE PENALIZACIÓN O COMISIÓN ALGUNA POR LA TERMINACIÓN DE PRESENTE CONTRATO."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="335" width="457" height="52" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EN CASO DE QUE ASP INTEGRA OPCIONES PRETENDA DAR POR TERMINADO EL PRESENTE CONTRATO, DEBERÁ INFORMAR TAL SITUACIÓN A EL CLIENTE DE MANERA INEQUÍVOCA, A TRAVÉS DE CUALQUIERA DE LOS MEDIOS ESTIPULADOS EN LA CLÁUSULA TRIGÉSIMA PRIMERA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="387" width="457" height="54" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL CLIENTE DEBERÁ RETIRAR EL SALDO DE LA CUENTA DENTRO DE LOS 5 (CINCO) DÍAS SIGUIENTES A LA FECHA EN QUE SURTA EFECTOS LA TERMINACIÓN DEL CONTRATO; DE LO CONTRARIO, ASP INTEGRA OPCIONES PODRÁ CONTABILIZARLOS A DISPOSICIÓN DEL CLIENTE EN LA FORMA QUE EL PRIMERO DETERMINE."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="441" width="457" height="61" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL CLIENTE CONTARÁ CON UN PERIODO DE 10 (DIEZ) DÍAS HÁBILES POSTERIORES A LA FIRMA DEL CONTRATO PARA TERMINAR ÉSTE SIN RESPONSABILIDAD ALGUNA DE SU PARTE, EN CUYO CASO ASP INTEGRA OPCIONES NO PODRÁ COBRAR COMISIÓN ALGUNA SIEMPRE Y CUANDO EL CLIENTE NO HUBIESE UTILIZADO U OPERADO NINGUNO DE LOS PRODUCTOS."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="143" width="457" height="159" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["LAS OPERACIONES DE DEPÓSITO DE DINERO A LA VISTA QUE SE DERIVEN DEL PRESENTE CONTRATO, SE DARÁN POR TERMINADA A PARTIR DE LA FECHA EN LA QUE EL CLIENTE LO SOLICITE POR ESCRITO, SIEMPRE Y CUANDO SE ATIENDAN LAS SIGUIENTES CONSIDERACIONES: I) SE CUBRAN LOS ADEUDOS Y COMISIONES DEVENGADAS HASTA ESA FECHA, DE CONFORMIDAD CON EL CLAUSULADO APLICABLE A DICHO PRODUCTO Y II) SE RETIRE EL SALDO TOTAL QUE CORRESPONDA A DICHO PRODUCTO SEGÚN REPORTE ASP INTEGRA OPCIONES EN ESE MOMENTO. ASÍ MISMO LA INSTITUCIÓN FINANCIERA DEBE DE PROPORCIONAR A EL CLIENTE UN ACUSE DE RECIBO DE CANCELACIÓN RENUNCIANDO AMBOS A DERECHOS DE COBRO RESIDUALES, QUE PUDIERAN SUBSISTIR DESPUÉS DEL MOMENTO DE LA CANCELACIÓN. LAS OPERACIONES A PLAZO FIJO NO PODRÁN TERMINARSE DE MANERA ANTICIPADA, POR LO QUE LAS PARTES RESPETARÁN LOS PLAZOS CONTRATADOS, PERO LA SOLA PRESENTACIÓN DE LA SOLICITUD BASTARÁ PARA EVITAR SE RENUEVE ALGÚN PLAZO FIJO."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="67" width="457" height="76" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL CLIENTE DEBERÁ PRESENTAR UNA SOLICITUD POR ESCRITO, EN CUALQUIER SUCURSAL DE ASP INTEGRA OPCIONES, ESTA A SU VEZ ENTREGARÁ UN ACUSE DE RECIBO CON FOLIO A EL CLIENTE. ASP INTEGRA OPCIONES DEBERÁ SOLICITAR SE LE MUESTRE ALGUNA IDENTIFICACIÓN OFICIAL DE LAS SEÑALADAS EN LA CLÁUSULA DÉCIMA SEXTA DEL PRESENTE CONTRATO, CON EL FIN SE CERCIORARSE DE LA AUTENTICIDAD Y VERACIDAD DE EL CLIENTE QUE FORMULE LA SOLICITUD RESPECTIVA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="24" width="457" height="43" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["OCTAVA.- VIGENCIA Y TERMINACIÓN.- LA DURACIÓN DEL CONTRATO ES INDEFINIDA, PUDIENDO CUALQUIERA DE LAS PARTES DARLO POR TERMINADO, EN FORMA INMEDIATA, DE ACUERDO CON LO SIGUIENTE:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="502" width="457" height="43" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["NOVENA.- DE LA DENOMINACIÓN DE LA MONEDA.- LOS DEPÓSITOS REALIZADOS POR EL CLIENTE HABRÁN DE SER EN MONEDA NACIONAL Y ASP INTEGRA OPCIONES RESTITUIRÁ LAS SUMAS PRESTADAS EN LA MISMA MONEDA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="546" width="457" height="64" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["DÉCIMA.-  EFECTOS EN CASO DE DEFUNCIÓN.- EL CLIENTE DESIGNA COMO BENEFICIARIOS EN CASO DE FALLECIMIENTO A LOS SEÑALADOS EN EL ANEXO A ADJUNTO AL PRESENTE  CONTRATO, PUDIENDO REALIZAR LOS CAMBIOS QUE DESEE EN CUALQUIER TIEMPO, SIEMPRE Y CUANDO HAYA CUMPLIDO CON LOS REQUISITOS ESTABLECIDOS POR ASP INTEGRA OPCIONES."]]></textFieldExpression>
			</textField>
		</band>
		<band height="678">
			<textField>
				<reportElement x="57" y="456" width="457" height="54" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["TARJETA FÍSICA.- EN ESTE ACTO EL CLIENTE MANIFIESTA EXPRESAMENTE SU CONFORMIDAD Y CONOCIMIENTO RESPECTO DE TODAS Y CADA UNA DE LAS COMISIONES A LAS QUE SERÁ SUJETO POR EL USO DE TARJETA FÍSICA, LAS CUALES SE SEÑALAN A CONTINUACIÓN:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="403" width="457" height="53" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["D) INACTIVIDAD DE CUENTA.- EN CASO DE QUE LA CUENTA PRESENTE 12 MESES DE INACTIVIDAD (SIN TRANSACCIONES DE DEPÓSITO, RETIRO O CONSULTA), SE DEBERÁ CUBRIR POR CONCEPTO DE COMISIÓN POR INACTIVIDAD DE CUENTA LA CANTIDAD DE $4.31 (CUATRO PESOS 31/100 M.N.) SIN IVA DE FORMA MENSUAL."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="316" width="457" height="87" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["C) RETIRO VÍA SPEI .- EL SISTEMA DE PAGOS ELECTRÓNICOS INTERBANCARIOS, ES UN SISTEMA DESARROLLADO Y OPERADO POR EL BANCO DE MÉXICO QUE PERMITE REALIZAR TRANSFERENCIAS ELECTRÓNICAS DE FONDOS ENTRE CUENTAS DE DEPÓSITO BANCARIAS. EL CLIENTE PODRÁ SOLICITAR EL RETIRO DE FONDOS DE SU CUENTA DE DEPÓSITO A TRAVÉS DE SPEI HACIA LA CUENTA DE DEPÓSITO QUE INDIQUE, POR EL CUAL DEBERÁ CUBRIR EL COSTO ES DE $4.31 (CUATRO PESOS 31/100 M.N.) SIN IVA POR CADA DISPOSICIÓN QUE INSTRUYA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="275" width="457" height="41" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["B) REIMPRESIÓN/REEXPEDICIÓN DE ESTADO DE CUENTA.- EL CLIENTE, PODRÁ SOLICITAR LA REIMPRESIÓN Y/O REEXPEDICIÓN DEL ESTADO DE CUENTA, CUYO COSTO ES DE $2.59 (DOS PESOS 59/100 M.N.) SIN IVA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="184" width="457" height="89" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["A) CONSULTA DE SALDO.- EL CLIENTE, PODRÁ CONSULTAR DE MANERA GRATUITA SU SALDO EN SUCURSALES DE ASP INTEGRA OPCIONES, ASÍ MISMO CONTARA CON DOS CONSULTAS MENSUALES DE MANERA GRATUITA A TRAVÉS DE CORRESPONSALES FINANCIEROS AUTORIZADOS, A PARTIR DE LA TERCERA CONSULTA DE SALDO EN EL MES REALIZADA A TRAVÉS DE CORRESPONSALES FINANCIEROS AUTORIZADOS EL CLIENTE DEBERÁ CUBRIR POR CONCEPTO DE COMISIÓN LA CANTIDAD DE $4.31 (CUATRO PESOS 31/100 M.N.) SIN IVA POR CADA NUEVA CONSULTA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="141" width="457" height="41" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["DÉCIMA SEGUNDA.- COMISIONES.- EL CLIENTE SE OBLIGA A PAGAR A ASP INTEGRA OPCIONES POR CONCEPTO DE COMISIÓN LAS CANTIDADES QUE SE DERIVEN DE LAS SIGUIENTES OPERACIONES:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="122" width="457" height="17" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["DÉCIMA PRIMERA. - RENDIMIENTOS.- ESTE CONTRATO NO GENERARÁ RENDIMIENTOS."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="91" width="457" height="30" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["A PARTIR DE QUE SE PRESENTE LA DOCUMENTACIÓN QUE ACREDITE EL FALLECIMIENTO DEL CLIENTE, CESA SU RESPONSABILIDAD POR EL USO DE LA TARJETA ASIGNADA."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="36" width="457" height="54" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["PARA REALIZAR EL CAMBIO DE BENEFICIARIOS EL CLIENTE DEBERÁ ACUDIR A LA SUCURSAL EN LA QUE APERTURA SU CUENTA Y LLENAR LOS FORMATOS QUE PARA TAL EFECTO SE LE PROPORCIONARAN Y EN EL QUE DETERMINARA EL PORCENTAJE CORRESPONDIENTE A CADA BENEFICIARIO DESIGNADO."]]></textFieldExpression>
			</textField>
		</band>
		<band height="678">
			<textField>
				<reportElement x="57" y="295" width="457" height="38" uuid="5406f1a8-ecb8-4c03-9add-fcceb3b34805"/>
				<textElement textAlignment="Justified" markup="html">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["CONSULTA DE SALDOS Y DISPOSICIÓN DE EFECTIVO EN CAJEROS DE OTRAS ENTIDADES FINANCIERAS, LA COMISIÓN DEPENDERÁ DE LO ESTABLECIDO POR AQUELLAS EN DONDE SE REALICEN DICHAS OPERACIONES."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="333" width="457" height="50" uuid="d6bb15ea-696b-40e1-8bb6-968973c9433b"/>
				<textElement textAlignment="Justified">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL CLIENTE ACEPTA QUE LAS COMISIONES AQUÍ MOSTRADAS SON LAS VIGENTES A LA FIRMA DEL PRESENTE CONTRATO, NO OBSTANTE, ENTIENDE QUE ESTAS SON SUSCEPTIBLES DE MODIFICACIÓN, DE CONFORMIDAD CON LOS TÉRMINOS PACTADOS EN EL PRESENTE CONTRATO Y EN LAS DISPOSICIONES LEGALES APLICABLES."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="384" width="457" height="39" uuid="09a2d502-0a91-498d-8124-345820c46860"/>
				<textElement textAlignment="Justified">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["LAS OPERACIONES REALIZADAS A TRAVÉS DE LOS CORRESPONSALES FINANCIEROS PODRÁN GENERAR UNA COMISIÓN ADICIONAL, CONSULTE ANTES DE REALIZAR SU OPERACIÓN."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="423" width="456" height="46" uuid="093b3383-7790-4a03-9fcd-a06d77d2ba3f"/>
				<textElement textAlignment="Justified">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL CLIENTE AUTORIZA EXPRESAMENTE A ASP INTEGRA OPCIONES PARA COBRAR LAS COMISIONES SEÑALADAS EN LA PRESENTE CLAUSULA MEDIANTE CARGO A SU CUENTA, EN EL ENTENDIDO DE QUE SI EL SALDO ES INSUFICIENTE, EL CLIENTE DEBERÁ CUBRIR LA COMISIÓN EN EFECTIVO."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="472" width="457" height="42" uuid="cd74b9ca-c4f7-4933-a2f6-3750f026112f"/>
				<textElement textAlignment="Justified">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL CLIENTE PODRÁ CONSULTA LAS COMISIONES VIGENTES EN CUALQUIER SUCURSAL DE ASP INTEGRA OPCIONES Y EN EL PORTAL ASP INTEGRA OPCIONES EN INTERNET: HTTPS://WWW.ASPINTEGRAOPCIONES.COM."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="512" width="457" height="84" uuid="b24554f1-446d-436e-abc1-a67b3abd6bff"/>
				<textElement textAlignment="Justified">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["ASP INTEGRA OPCIONES PODRÁ INCREMENTAR EL IMPORTE DE LAS COMISIONES ANTERIORMENTE SEÑALADAS, ASÍ COMO ESTABLECER NUEVAS COMISIONES, PREVIA NOTIFICACIÓN AL CLIENTE, A TRAVÉS DE AVISO PUBLICADO EN SUS OFICINAS; A TRAVÉS DE SU PÁGINA DE INTERNET, Y PREVIA NOTIFICACIÓN ENVIADA A EL CLIENTE A TRAVÉS DE CUALQUIERA DE LOS MEDIOS SEÑALADOS EN LA CLÁUSULA TRIGÉSIMO PRIMERO, CUALQUIERA DE ELLOS CON AL MENOS 30 (TREINTA) DÍAS DE ANTICIPACIÓN A QUE SURTAN EFECTOS LAS MISMAS."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="57" y="595" width="457" height="82" uuid="9b7345a2-224b-4882-a22f-bfcf1fd0b12f"/>
				<textElement textAlignment="Justified">
					<font fontName="DejaVu Sans"/>
				</textElement>
				<textFieldExpression><![CDATA["EL CLIENTE QUE NO ESTÉ DE ACUERDO CON EL INCREMENTO O CON LAS NUEVAS COMISIONES PODRÁ SOLICITAR LA TERMINACIÓN DEL CONTRATO DENTRO DE LOS 30 (TREINTA) DÍAS POSTERIORES AL AVISO ARRIBA SEÑALADO, SIN RESPONSABILIDAD ALGUNA A SU CARGO, TRAS LO CUAL ASP INTEGRA OPCIONES LE DEBERÁ ENTREGAR EL SALDO DISPONIBLE DE LA CUENTA SIN APLICAR COMISIÓN ADICIONAL ALGUNA, CON EXCEPCIÓN DE LOS ADEUDOS QUE YA SE HUBIEREN GENERADO A LA FECHA EN QUE EL CLIENTE RETIRE EL CITADO SALDO."]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="68" y="49" width="435" height="1" uuid="d2eaed70-1854-45c5-93b6-2db0ec45a26a"/>
			</line>
			<textField>
				<reportElement mode="Opaque" x="67" y="33" width="436" height="16" forecolor="#FFFFFF" backcolor="#000000" uuid="01750b4f-8936-4d05-98c7-d6cafea33e28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA["COMISIONES"]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="67" y="48" width="1" height="234" uuid="fd8f2f06-a4a3-4af4-a7bb-b81ebbed62fe"/>
			</line>
			<line>
				<reportElement x="502" y="48" width="1" height="233" uuid="d3a02aad-04c5-41c2-a61d-6d130163a36e"/>
			</line>
			<textField>
				<reportElement mode="Opaque" x="68" y="50" width="246" height="16" backcolor="#CCCCCC" uuid="7ba8f972-912d-44f2-9a26-1c00ca175fe3"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["TIPO DE COMISIÓN"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Opaque" x="314" y="50" width="90" height="16" backcolor="#CCCCCC" uuid="43080618-e7a9-439d-9b9d-e02b3990f765"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["PERIODICIDAD"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Opaque" x="404" y="50" width="98" height="16" backcolor="#CCCCCC" uuid="bc778e70-cab4-40b1-875d-ff6bafb44d9e"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["MONTO"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="66" width="247" height="28" uuid="9b39219f-d48d-485f-ad77-090fb2189bf0"/>
				<textFieldExpression><![CDATA["ADMINISTRACIÓN O MANEJO DE CUENTA (A PARTIR MES 13)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="95" width="247" height="26" uuid="b1ea9165-ec4d-49bb-8a35-bcdceaafc608"/>
				<textFieldExpression><![CDATA["COMISIÓN POR EMISIÓN DE MEDIOS DE DISPOSICIÓN. TDD."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="314" y="66" width="90" height="28" uuid="7b1a83ff-e164-4df3-84e5-e37b22d2dfe8"/>
				<textElement textAlignment="Center"/>
				<textFieldExpression><![CDATA["MENSUAL"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="404" y="66" width="98" height="28" uuid="bb7ecfb1-6e02-4fdb-a410-535c090c0266"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["$10.00"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="121" width="247" height="55" uuid="c23d8f65-0cfb-4faf-9469-5e396bf4dbbf"/>
				<textFieldExpression><![CDATA["TRANSFERENCIA INTERBANCARIA A CUENTAS DE OTRAS INSTITUCIONES DESDE ASP PAGO, SIN COMISIÓN UNA TRANSACCIÓN AL DÍA, A PARTIR DE LA SEGUNDA SE COBRA LA COMISIÓN."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="176" width="247" height="17" uuid="a1fb0aa6-a4a8-485e-9731-2277600a87ba"/>
				<textFieldExpression><![CDATA["INACTIVIDAD DE LA CUENTA"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="193" width="247" height="29" uuid="0ec26775-1361-47df-aa8e-eca185cecc15"/>
				<textFieldExpression><![CDATA["ACLARACIÓN IMPROCEDENTE DE LA CUENTA (DE TRANSACCIONES REALIZADAS EN CAJERO)"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="67" y="222" width="247" height="15" uuid="3f21e569-2d59-418a-9933-841b710cd46e"/>
				<textFieldExpression><![CDATA["ACLARACIÓN IMPROCEDENTE DE LA CUENTA"]]></textFieldExpression>
			</textField>
