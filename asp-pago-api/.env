# HOST servidor de conetenedores
HOST_CONTAINER=<ruta_contenedor>

# Zona horaria
TZ=America/Mexico_City

# Ips para generacion de jaspers en asp-pago-documents
# Se debe colocar aqui ya que se le deben pasar estas ips para que el contenedor pueda resolver los dns
# Si se colocan en el .env.documents el valor de las variables queda como vacio
DB_PROCREA_IP=<ip_bd_procrea>
DB_CERO_IP=<ip_bd_cerp>

# Host Mule STI (generación de CLABE en asp-pago-onb)
# Se debe colocar aqui ya que se le debe pasar esta ip para que el contenedor pueda resolver el dns
# Si se coloca en el .env.onb el valor de la variable queda como vacio
MULE_STI_IP=<ip_mule_sti>