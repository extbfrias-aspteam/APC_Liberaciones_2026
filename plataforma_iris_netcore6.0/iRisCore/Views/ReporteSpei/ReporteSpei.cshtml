
@{
    ViewData["Title"] = "Reporte Spei";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/1.7.1/css/buttons.dataTables.min.css" rel="stylesheet" />
}

<h5>B2B - Reporte SPEI</h5>
<div id="emailHelp" class="form-text">Visualización de la Información de la Operación Spei.</div>
<div class="card-box">
    <div class="card-body">
        <form>
            <div class="row g-4">
                <div class="col-sm-3">
                    <select class="form-select" name="tipoSpei" id="tipoSpei" aria-label="Default select example">
                        <option selected>Seleccione Operación</option>
                        <option value="IN">IN</option>
                        <option value="OUT"> OUT</option>
                    </select>
                </div>
                <div class="col-sm-3">
                    <input name="fecha" id="fecha" class="form-control" type="date" />
                </div>
                <div class="col-sm-3">
                    <input class="form-control" type="text" name="claveRastreo" id="claveRastreo" placeholder="Clave de Rastreo" aria-label="default input example">
                </div>
                <div class="col-sm-3">
                    <button type="submit" id="ExecuteRequest" class="btn btn-success">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

<br />

<div class="row gx-5 visually-hidden" id="tabla">

    <table id="example" class="display" style="width:100%">
        <thead>
            <tr>
                <th>Fecha Operación</th>
                <th>Fecha Aplicación</th>
                <th>Clave Rastreo</th>
                <th>Banco Origen</th>
                <th>Clabe Origen</th>
                <th>Nombre Emisor</th>
                <th>Banco Destino</th>
                <th>Clabe Destino</th>
                <th>Nombre Beneficiario</th>
                <th>Monto</th>
                <th>Concepto Pago</th>
                <th>Referencia</th>
                <th>Estatus Operación</th>
                <th>Motivo de Estatus</th>
                <th>UDN</th>
            </tr>
        </thead>
    </table>
</div>

