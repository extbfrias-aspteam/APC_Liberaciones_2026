
@{
    ViewData["Title"] = "WSTraspasoTarjeta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h5>Traspaso entre Tarjetas</h5>
<div id="emailHelp" class="form-text">WebService que permitirá realizar traspaso de saldo entre tarjetas.</div>


<div class="card-box">
    <div class="card-body">
        <form class="" id="Formulario">

            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="form-floating mb-1">
                        <input class="form-control" type="password" name="numeroTarjetaOrigen" id="numeroTarjetaOrigen" maxlength="16" placeholder="Número de Tarjeta Origen" aria-label="default input example">
                        <label for="floatingInput">Tarjeta Origen</label>
                    </div>
                    
                </div>
                <div class="col-sm-4">
                    <div class="form-floating mb-1">
                        <input class="form-control" type="password" name="numeroTarjetaDestino" id="numeroTarjetaDestino" maxlength="16" placeholder="Número de Tarjeta Destino" aria-label="default input example">
                        <label for="floatingInput">Tarjeta Destino</label>
                    </div>
                    
                </div>
                <div class="col-sm-4">
                    <div class="form-floating mb-1">
                        <input class="form-control" type="text" name="importe" id="importe" placeholder="Importe del Traspaso" maxlength="6" aria-label="default input example">
                        <label for="floatingInput">Importe Traspaso</label>
                    </div>                    
                </div>
            </div>
            <br />
            <div class="row g-2">
                <div class="col-sm-2">
                    <div class="form-floating mb-1">
                        <input class="form-control" type="text" name="referenciaNumerica" id="referenciaNumerica" maxlength="7" placeholder="Referencia" aria-label="default input example">
                        <label for="floatingInput">Referencia Numérica</label>
                    </div>                    
                </div>
                <div class="col-sm-10">
                    <div class="form-floating mb-1">
                        <input class="form-control" type="text" name="observaciones" id="observaciones" maxlength="50" placeholder="Observaciones" aria-label="default input example">
                        <label for="floatingInput">Observaciones</label>
                    </div>                   
                </div>
            </div>
            <br />
            <div class="row g-1">
                <div class="col-sm-4">
                    <button type="submit" id="ExecuteRequest" class="btn btn-success">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación</button>
                </div>
            </div>
        </form>
    </div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">

    var js = jQuery.noConflict(true);

    js(document).ready(function () {

        js(document).on('click', '.confirm', function () {
            var myH2 = document.getElementsByTagName('h2')[0].innerHTML;
            if (myH2 == 'Exito') {               
                js("#Formulario")[0].reset();
            }
        });


        js('#ExecuteRequest').on("click", function (event) {
            event.preventDefault();
            js("#spin").removeClass("visually-hidden");
            js("#ExecuteRequest").attr('disabled', true);

            var url = "@Url.Action("WSTraspasoTarjeta","WSTraspasoTarjeta")";

            var info = new Object();
            info.numeroTarjetaOrigen = js("#numeroTarjetaOrigen").val();
            info.numeroTarjetaDestino = js("#numeroTarjetaDestino").val();
            info.importe = js("#importe").val();            
            info.refNumerica = js("#referenciaNumerica").val();
            info.observaciones = js("#observaciones").val();

            js.ajax({
                type: "POST",
                url: url,
                dataType: "json",
                data: info,
                success: function (data) {
                   
                    if (data.codigo != 0) {
                        swal({
                            title: "Error",
                            text: data.mensaje,
                            type: "warning",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }
                    else {

                        swal({
                            title: "Exito",
                            text: "Traspaso aplicado. Id Solicitud:" + data.idSolicitud + " - Tarjeta Origen: " + js("#numeroTarjetaOrigen").val() + " - Importe Traspasado: " + data.importe + ' - Saldo Final: ' + data.saldoFinal + ' - Tarjeta Destino: ' + data.tarjeta,
                            type: "success",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }
                    js("#ExecuteRequest").attr('disabled', false);
                    js("#spin").addClass("visually-hidden");
                }
            });

        });


    });
</script>
