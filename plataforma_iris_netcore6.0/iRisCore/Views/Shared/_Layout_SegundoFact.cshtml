<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="~/images/iris.ico">
    <title>@ViewData["Title"] - iRisCore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/iRisCore.styles.css" asp-append-version="true" />
    <link href="~/fonts/fontawesome-free-6.4.0-web/css/fontawesome.css" rel="stylesheet" />
    <link href="~/fonts/fontawesome-free-6.4.0-web/css/solid.css" rel="stylesheet" />
    <link href="~/fonts/fontawesome-free-6.4.0-web/css/brands.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
    <link href="~/css/sweetalert.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header>
        <nav class="megamenu">
            <ul class="megamenu-nav d-flex justify-content-center" role="menu">
                <li class="nav-item">
                    <h5><a class="nav-link" asp-area="" asp-controller="Home" asp-action="SegundoFactAut"><i class="fa fa-eye"></i> iRisCore</a></h5>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Salir">Cerrar Sesión</a>
                </li>

            </ul>
            @* <div class="megamenu-background" id="megamenu-background"></div> *@
        </nav>

        @*  <div class="megamenu-dim" id="megamenu-dim"></div>  *@


    </header>

    <div class="container">
        <br />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src='https://cdnjs.cloudflare.com/ajax/libs/jquery.hoverintent/1.9.0/jquery.hoverIntent.min.js'></script>
    <script src='https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.11/lodash.min.js'></script>

    <script src="~/js/index.js"></script>

    <script src="~/js/sweetalert.min.js"></script>
    <script src="~/js/jquery.sweet-alert.init.js"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
