    // cargar tipo de calle
    document.addEventListener('DOMContentLoaded', function () {
        // Cache para almacenar los datos ya cargados
      //  let tiposDomicilioCache = null;
        let cargando = false;

        // Función principal para cargar todos los selects
        window.cargarTodosLosTipos = function () {
            // Si ya estamos cargando, no hacer nada
            if (cargando) return;

            cargando = true;


           
            // Si ya tenemos los datos en cache, usarlos directamente
            if (tiposDomicilioCache) {
                actualizarSelects(tiposDomicilioCache);
                cargando = false;
                return;
            }

            // Mostrar estado de carga en todos los selects
            ['tipoCallePrincipal', 'tipoEntreCalle1', 'tipoEntreCalle2', 'tipoNumExt', 'tipoNumInt'].forEach(id => {
                const select = document.getElementById(id);
                if (select) {
                    select.innerHTML = '<option value="" selected disabled>Cargando...</option>';
                }
            });

            fetch('/ConsultaMA/ConsultaTipoDomicilio', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
                .then(response => {
                    cargando = false;
                    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                    return response.json();
                })
                .then(data => {
                    if (data.codigo === 0) {
                        console.log('Datos recibidos:', data);
                        tiposDomicilioCache = data; // Almacenar en cache
                        actualizarSelects(data);
                    } else {
                        mostrarErrorEnSelects(data.mensaje || "Error en los datos recibidos");
                    }
                })
                .catch(error => {
                    cargando = false;
                    console.error('Error al cargar tipos de domicilio:', error);
                    mostrarErrorEnSelects("Error al conectar con el servidor");
                });
        };

        // Función para actualizar todos los selects con los datos
        function actualizarSelects(data) {
            try {
                // Calle principal (clave 3)
                actualizarSelect('tipoCallePrincipal', data.data, { include: true, clave: 3 });
                // Calles transversales (clave 3)
                actualizarSelect('tipoEntreCalle1', data.data, { include: true, clave: 3 });
                actualizarSelect('tipoEntreCalle2', data.data, { include: true, clave: 3 });
                // Números (excluir clave 3)
                actualizarSelect('tipoNumExt', data.data, { include: false, clave: 3 });
                actualizarSelect('tipoNumInt', data.data, { include: false, clave: 3 });

            } catch (error) {
                console.error('Error al actualizar selects:', error);
                mostrarErrorEnSelects("Error al procesar los datos");
            }
        }

        // Función mejorada para actualizar un select individual
        function actualizarSelect(selectId, items, filtro) {
            const select = document.getElementById(selectId);
            if (!select) {
                console.warn(`Select con ID ${selectId} no encontrado`);
                return;
            }

            try {
                // Filtrar los items según el tipo de filtro
                let tiposFiltrados;
                if (filtro.include) {
                    // Incluir solo los items con la clave especificada
                    tiposFiltrados = items.filter(item => item.clave === filtro.clave);
                } else {
                    // Excluir los items con la clave especificada
                    tiposFiltrados = items.filter(item => item.clave !== filtro.clave);
                }

                if (tiposFiltrados.length === 0) {
                    console.warn(`No se encontraron items para el filtro en select ${selectId}`);
                    select.innerHTML = '<option value="" selected disabled>No hay opciones disponibles</option>';
                    return;
                }

                let options = '<option value="" selected disabled>Seleccione tipo</option>';
                tiposFiltrados.forEach(tipo => {
                    options += `<option value="${tipo.id}">${tipo.descripcion}</option>`;
                });

                select.innerHTML = options;
               
            } catch (error) {
                console.error(`Error al actualizar ${selectId}:`, error);
                select.innerHTML = '<option value="" selected disabled>Error al cargar</option>';
            }
        }

        // Función para mostrar error en todos los selects (sin cambios)
        function mostrarErrorEnSelects(mensaje) {
            ['tipoCallePrincipal', 'tipoEntreCalle1', 'tipoEntreCalle2', 'tipoNumExt', 'tipoNumInt'].forEach(id => {
                const select = document.getElementById(id);
                if (select) {
