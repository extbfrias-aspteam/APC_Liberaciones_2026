    // Función para generar el domicilio completo
    function generarDomicilioJS(
        cat_dom1, descrip1,
        cat_dom2, descrip2,
        cat_dom3, descrip3,
        cat_dom4, descrip4,
        cat_dom5, descrip5
    ) {
        // Verificar si tenemos los datos de abreviaciones
        if (!tiposDomicilioCache || !Array.isArray(tiposDomicilioCache.data)) {
            console.warn("Datos de tipos de domicilio no disponibles");
            return "";
        }

        // Obtener abreviaciones
        const getAbreviacion = (descripcion) => {
            const tipo = tiposDomicilioCache.data.find(item => item.descripcion === descripcion);
            return tipo ? tipo.abreviacion || "" : "";
        };

        let cat1 = getAbreviacion(cat_dom1);
        let cat2 = getAbreviacion(cat_dom2);
        let cat3 = getAbreviacion(cat_dom3);
        let cat4 = getAbreviacion(cat_dom4);
        let cat5 = getAbreviacion(cat_dom5);

        let des1 = descrip1.trim();
        const des2 = descrip2.trim();
        const des3 = descrip3.trim();
        let des4 = descrip4 === '0' ? '' : descrip4.trim();
        let des5 = descrip5 === '0' ? '' : descrip5.trim();

        // S/C o s/c => se omite calle
        if (des1.toLowerCase() === 's/c') {
            des1 = '';
            cat1 = '';
        }

        // Si cat4 y cat5 están vacíos, se asigna 'S/N' a cat4
        if (!cat4 && !cat5) {
            cat4 = 'S/N';
        }

        let domicilio_final = '';

        if (cat_dom2 && cat_dom3) {
            domicilio_final = `${cat1} ${des1.toUpperCase()} ENTRE ${cat2} ${des2.toUpperCase()} Y ${cat3} ${des3.toUpperCase()}`;
            if (cat_dom4 || cat_dom5 || cat4 === 'S/N') {
                domicilio_final += `, ${cat4} ${des4.toUpperCase()} ${cat5} ${des5.toUpperCase()}`;
            }
        } else if (cat_dom2 && !cat_dom3) {
            domicilio_final = `${cat1} ${des1.toUpperCase()} Y ${cat2} ${des2.toUpperCase()}`;
            if (cat_dom4 || cat_dom5 || cat4 === 'S/N') {
                domicilio_final += `, ${cat4} ${des4.toUpperCase()} ${cat5} ${des5.toUpperCase()}`;
            }
        } else if (!cat_dom2 && !cat_dom3) {
            domicilio_final = `${cat1} ${des1.toUpperCase()}`;
            if (cat_dom4 || cat_dom5 || cat4 === 'S/N') {
                if (des1) domicilio_final += ',';
                domicilio_final += ` ${cat4} ${des4.toUpperCase()} ${cat5} ${des5.toUpperCase()}`;
            }
        }

        // Limpiar espacios dobles y al inicio
        return domicilio_final.replace(/\s+/g, ' ').trim();
    }

