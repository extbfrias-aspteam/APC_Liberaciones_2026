            });
        }

       
        if (modal && modal.classList.contains('show')) {
            cargarTodosLosTipos();
  
            setTimeout(() => {
              

             
              
            }, 150);
        }

    

    });

    // validar

    function validarEntreCalle(input) {
        // Obtener el ID del input
        const inputId = input.id;

        // Obtener elementos de error usando el ID del input
        const errorCaracteres = document.getElementById(`${inputId}-error-caracteres`);
        const errorLongitud = document.getElementById(`${inputId}-error-longitud`);

        // Validar que existen los elementos de error
        if (!errorCaracteres || !errorLongitud) {
            console.error('No se encontraron los elementos de error para el input:', inputId);
            return false;
        }

        // Expresión regular para validación
        const regex = /^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s\.,\-#]*$/;
        let valor = input.value;
        let esValido = true;

        // Resetear mensajes de error
        errorCaracteres.style.display = 'none';
        errorLongitud.style.display = 'none';
        input.classList.remove('is-invalid');

        // Validar caracteres permitidos
        if (valor && !regex.test(valor)) {
            input.value = valor.replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s\.,\-#]/g, '');
            errorCaracteres.style.display = 'block';
            input.classList.add('is-invalid');
            esValido = false;
        }

        // Validar longitud máxima
        if (valor.length > 100) {
            input.value = valor.substring(0, 100);
            errorLongitud.style.display = 'block';
            input.classList.add('is-invalid');
            esValido = false;
        }

        return esValido;
    }
