@using iRisModel
@{
    ViewData["Title"] = "ConsultaMA";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Estilos {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.3/font/bootstrap-icons.min.css" rel="stylesheet">

}

<h5>Información del Cuentahabiente [Cuenta y Medios de Disposición]</h5>
<div id="emailHelp" class="form-text">Información de la cuenta y los medios de disposición asociados.</div>
<div class="card-box">
    <div class="card-body">
        <form>
            <div class="row g-3">
                <div class="col-sm-3">
                    <select class="form-select" name="claveProducto" id="claveProducto" aria-label="Default select example">
                        <option value="N" selected>Seleccione el producto</option>
                        @if (ViewBag.Productos != null)
                        {
                            List<ProductoModel> oProducto = (List<ProductoModel>)ViewBag.Productos;
                            foreach (ProductoModel item in oProducto)
                            {
                                <option value=@item.claveProducto>@item.descProducto</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-sm-3">
                    <select class="form-select" name="tipoBusqueda" id="tipoBusqueda" aria-label="Default select example">
                        <option selected>Tipo de búsqueda</option>
                        <option value="RFC">RFC</option>
                        <option value="CURP">CURP</option>
                        <option value="Tel">Teléfono</option>
                        <option value="ASP">Cuenta ASP</option>
                        <option value="CLABE">Cuenta Clabe</option>
                        <option value="PAN">PAN</option>
                        <option value="correo">Correo</option>
                    </select>
                </div>
                <div class="col-sm-3">
                    <input class="form-control" type="text" name="valorBusqueda" id="valorBusqueda" placeholder="Valor..." aria-label="default input example">
                </div>
                <div class="col-sm-3">
                    <button type="submit" class="btn btn-success" id="ExecuteRequest" disabled>
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<br />

<div class="card visually-hidden" id="cuentahabiente">
    <div class="card-header"><strong>Información del Cuentahabiente </strong></div>

    <div class="card-body">

        <div class="row g-12">
            <div class="col-sm-3">
                <strong><label>Nombre Completo</label></strong>
            </div>
            <div class="col-sm-3">
                <span id="nombreCompleto"></span>
                <span id="numero" style="display: none;"></span>

                <span id="modalDireccion1" style="display: none;"></span>
            </div>
            <div class="col-sm-3">
                <strong><label>Fecha de Nacimiento</label></strong>
            </div>
            <div class="col-sm-3">
                <span id="fechaNacimiento"></span>
            </div>
        </div>
        <br />
        <div class="row g-12">
            <div class="col-sm-3">
                <strong><label>Dirección</label></strong>
            </div>
            <div class="col-sm-8 d-flex justify-content-between align-items-center">
                <span id="direccion" class="" style="max-width: 100%;"></span>
            </div>
            <div class="col-sm-1 d-flex justify-content-between align-items-center">
                <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modifyDireccion" ><i class="bi bi-pencil"></i> </button>
            </div>

        </div>
        <br />

        <div class="row g-12">
            <div class="col-sm-3 d-flex justify-content-between align-items-center">
                <strong><label>CURP</label></strong>
            </div>
            <div class="col-sm-3 d-flex justify-content-between align-items-center">
                <span id="curp"></span>&nbsp;<button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modifyCurp"><i class="bi bi-pencil"></i></button>
            </div>
            <div class="col-sm-3 d-flex justify-content-between align-items-center">
                <strong><label>RFC</label></strong>
            </div>
            <div class="col-sm-3 d-flex justify-content-between align-items-center">
                <span id="rfc"></span>&nbsp;<button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modifyRfc"><i class="bi bi-pencil"></i></button>
            </div>
        </div>
        <br />

        <div class="row g-12">
            <div class="col-sm-3">
                <strong><label>Ocupación</label></strong>
            </div>
            <div class="col-sm-3">
                <span id="ocupacion"></span>
            </div>
            <div class="col-sm-3">
                <strong><label>e-Mail</label></strong>
            </div>
            <div class="col-sm-3 d-flex justify-content-between align-items-center">
                <span id="email"></span>&nbsp;<button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modifyEmail"><i class="bi bi-pencil"></i></button>
            </div>
        </div>
        <br />

        <div class="row g-12">
            <div class="col-sm-3">
                <strong><label>Teléfono</label></strong>
            </div>
            <div class="col-sm-3 d-flex justify-content-between align-items-center">

                <span id="telefono"></span>&nbsp;<button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modifyTelefono"><i class="bi bi-pencil"></i></button>
            </div>
            <div class="col-sm-3">
                <strong><label>Sexo</label></strong>
            </div>
            <div class="col-sm-3">
                <span id="sexo"></span>
            </div>
        </div>
        <br />
        <div class="row g-12">
            <div class="col-sm-3">
                <strong><label>Lugar de Nacimiento</label></strong>
            </div>
            <div class="col-sm-3">
                <span id="lugarNacimiento"></span>
            </div>
            <div class="col-sm-3">
                <strong><label>Nivel Cuenta</label></strong>
            </div>
            <div class="col-sm-3">
                <span id="nivelCuenta"></span>
            </div>

        </div>

    </div>
    <div class="card-footer"><strong><label>Saldo</label></strong> &nbsp; <span id="saldo"></span></div>
</div>
<br />

<div class="row gx-5 visually-hidden" id="tabla">
    <table id="example" class="display" style="width:100%">
        <thead>
            <tr>
                <th>Medio</th>
                <th>Card_ID</th> 
                <th>Clave</th>
                <th>Estatus</th>
                <th>Manufactura</th>
                <th>Producto</th>
            </tr>
        </thead>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="modifyCurp" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modifyCurplLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modifyCurpLabel">Modificar CURP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" class="form-control text-uppercase" id="curpCH" placeholder="CURP" maxlength="18">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button id="guardarCurp" type="button" class="btn btn-success">
                    <span id="spinCurp" class="spinner-border spinner-border-sm visually-hidden"></span>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modifyRfc" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modifyRfcLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modifyRfcLabel">Modificar RFC</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" class="form-control text-uppercase" id="rfcCH" placeholder="RFC" maxlength="13">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button id="guardarRfc" type="button" class="btn btn-success">
                    <span id="spinRfc" class="spinner-border spinner-border-sm visually-hidden"></span>Guardar
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Modal para Teléfono -->
<div class="modal fade" id="modifyTelefono" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modifyTelefonoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modifyTelefonoLabel">Modificar Teléfono</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="tel" class="form-control" id="telefonoCH" placeholder="Teléfono (10 dígitos)" maxlength="10" pattern="[0-9]{10}">
                    <span id="lblErrorTel" style="color:red"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button id="guardarTelefono" type="button" class="btn btn-success">
                    <span id="spinTelefono" class="spinner-border spinner-border-sm visually-hidden"></span>Guardar
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Modal para Email -->
<div class="modal fade" id="modifyEmail" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modifyEmailLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modifyEmailLabel">Modificar Email</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                  
                    <input type="email" class="form-control" id="emailCH" placeholder="Correo electrónico" required>
                     <span id="lblError" style="color:red"></span>
                    <div id="emailError" class="invalid-feedback" style="display: none;">Por favor ingrese un correo electrónico válido</div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button id="guardarEmail" type="button" class="btn btn-success">
                    <span id="spinEmail" class="spinner-border spinner-border-sm visually-hidden"></span>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Dirección -->
<div class="modal fade" id="modifyDireccion" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modifyDireccionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modifyDireccionLabel">Modificar Dirección</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-12">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">
                               
                                <select class="form-select" id="tipoCallePrincipal">
                                    <option value="" selected disabled>Cargando...</option>
                                </select>
                            </div>
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="direccionCH" placeholder="Descripción" maxlength="100"
                                       oninput="validarEntreCalle(this)">
                                <div id="direccionCH-error-caracteres" class="text-danger small mt-1" style="display: none;">
                                    Solo se permiten letras, números y los siguientes caracteres especiales: . , - #
                                </div>
                                <div id="direccionCH-error-longitud" class="text-danger small mt-1" style="display: none;">
                                    Máximo 100 caracteres permitidos
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">
                              
                                <select class="form-select" id="tipoEntreCalle1">
                                    <option value="" selected disabled>Cargando...</option>
                                </select>
                            </div>
                            <div class="col-md-9">
                                <input type="text" class="form-control" id="entreCalle1" placeholder="Descripción" maxlength="100"
                                       oninput="validarEntreCalle(this)">
                                <div id="entreCalle1-error-caracteres" class="text-danger small mt-1" style="display: none;">
                                    Solo se permiten letras, números y los siguientes caracteres especiales: . , - #
                                </div>
                                <div id="entreCalle1-error-longitud" class="text-danger small mt-1" style="display: none;">
                                    Máximo 100 caracteres permitidos
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">
                              
                                <select class="form-select" id="tipoEntreCalle2">
                                    <option value="" selected disabled>Cargando...</option>
                                </select>
                            </div>
                            <div class="col-md-9">
                              
                                <input type="text" class="form-control" id="entreCalle2" placeholder="Descripción" maxlength="100"
                                       oninput="validarEntreCalle(this)">
                                <div id="entreCalle2-error-caracteres" class="text-danger small mt-1" style="display: none;">
                                    Solo se permiten letras, números y los siguientes caracteres especiales: . , - #
                                </div>
                                <div id="entreCalle2-error-longitud" class="text-danger small mt-1" style="display: none;">
                                    Máximo 100 caracteres permitidos
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">

                                <select class="form-select" id="tipoNumExt">
                                    <option value="" selected disabled>Cargando...</option>
                                </select>
                            </div>
                            <div class="col-md-4">

                                <input type="text" class="form-control" id="numExt" placeholder="Descripción" maxlength="100"
                                       oninput="validarEntreCalle(this)">
                                <div id="numExt-error-caracteres" class="text-danger small mt-1" style="display: none;">
                                    Solo se permiten letras, números y los siguientes caracteres especiales: . , - #
                                </div>
                                <div id="numExt-error-longitud" class="text-danger small mt-1" style="display: none;">
                                    Máximo 100 caracteres permitidos
                                </div>
                            </div>
                            <div class="col-md-5">
                            </div>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">

                                <select class="form-select" id="tipoNumInt">
                                    <option value="" selected disabled>Cargando...</option>
                                </select>
                            </div>
                            <div class="col-md-4">

                                <input type="text" class="form-control" id="numInterior" placeholder="Descripción " maxlength="100"
                                       oninput="validarEntreCalle(this)">
                                <div id="numInterior-error-caracteres" class="text-danger small mt-1" style="display: none;">
                                    Solo se permiten letras, números y los siguientes caracteres especiales: . , - #
                                </div>
                                <div id="numInterior-error-longitud" class="text-danger small mt-1" style="display: none;">
                                    Máximo 100 caracteres permitidos
                                </div>
                            </div>
                            <div class="col-md-5">
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label for="cpCH" class="form-label">Codigo postal</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="cpCH" placeholder="Codigo postal" maxlength="5">
                            <span id="loadingCP" class="input-group-text visually-hidden">
                                <span class="spinner-border spinner-border-sm"></span>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label for="estadoCH" class="form-label">Estado</label>
                        <input type="text" class="form-control" id="estadoCH" readonly>
                    </div>
                    <div class="col-md-4">
                        <label for="municipioCH" class="form-label">Municipio/Alcaldía</label>
                        <input type="text" class="form-control" id="municipioCH" readonly>
                    </div>
                    <div class="col-md-4">
                        
                        <label for="localidadCH" class="form-label">Localidad</label>
                       
                        <input type="text" class="form-control" id="localidadCH" readonly>
                    </div>
                    <div class="col-md-4">

                        <label for="coloniaCH" class="form-label">Colonia</label>

                       
                        <select class="form-select" id="coloniaCH">
                            <option value="" selected disabled>Cargando...</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                      
                                   <span id="coloniaId" style="display: none;"></span>
                    </div>
                    <div class="col-md-12">
                        <label for="direccionConcatenada" class="form-label">Dirección</label>
                        <input class="form-control" id="direccionConcatenada" rows="3" placeholder="" readonly></input>
                    </div>
                    <div class="col-md-12">
                        <label for="referenciaAdicional" class="form-label">Referencias adicionales</label>
                        <textarea class="form-control" id="referenciaAdicional" rows="3" placeholder="Ejemplo: Casa color azul con portón negro, al lado de una tienda de abarrotes, frente al parque..."></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button id="guardarDireccion" type="button" class="btn btn-success">
                    <span id="spinDireccion" class="spinner-border spinner-border-sm visually-hidden"></span>
                    Guardar
                </button>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<script type="text/javascript">
    var js = jQuery.noConflict(true);

    js(document).ready(function () {
        js('#claveProducto').on('change', function () {
            var selectedValue = $(this).val();

            if (selectedValue != 'N') {
                js("#ExecuteRequest").attr('disabled', false);
            }
            else {
                js("#ExecuteRequest").attr('disabled', true);
            }
        });

        const modalCurp = new bootstrap.Modal(document.getElementById('modifyCurp'))
        const modalRfc = new bootstrap.Modal(document.getElementById('modifyRfc'))
      
        const modalTelefono = new bootstrap.Modal(document.getElementById('modifyTelefono'))
        const modalEmail = new bootstrap.Modal(document.getElementById('modifyEmail'))


        const modalDireccion = new bootstrap.Modal(document.getElementById('modifyDireccion'))
       


        modalTelefono._element.addEventListener('hidden.bs.modal', () => {
            js("#telefonoCH").val("");
        })
        modalEmail._element.addEventListener('hidden.bs.modal', () => {
            js("#emailCH").val("");
        })


        modalDireccion._element.addEventListener('hidden.bs.modal', () => {
            js("#direccionCH").val("");
            js("#numInterior").val("");
            js("#numExt").val("");
            js("#cpCH").val("");
            js("#estadoCH").val("");
            js("#municipioCH").val("");
            js("#coloniaCH").val("");
            js("#entreCalle1").val("");
            js("#codigoPostal").val("");
            js("#entreCalle2").val("");
            js("#referenciaAdicional").val("");

            js("#localidadCH").val("");
            js("#direccionConcatenada").val("");

        })

        modalCurp._element.addEventListener('hidden.bs.modal', () => {
            js("#curpCH").val("");
        })

        modalRfc._element.addEventListener('hidden.bs.modal', () => {
            js("#rfcCH").val("");
        })

        js(document).on("change", '#tipoBusqueda', function () {
            js("#valorBusqueda").val("");
            js("#tabla").addClass("visually-hidden");
            js("#cuentahabiente").addClass("visually-hidden");
        });
        $('#modifyDireccion').on('hidden.bs.modal', function () {
            $('#ExecuteRequest').click();
        });
        let datosDomi = null;



        function decodeHtmlEntities(text) {
            var textArea = document.createElement('textarea');
            textArea.innerHTML = text;
            return textArea.value;
        }
        let solicitanteNum = null;
        js('#ExecuteRequest').on("click", function (event) {
            event.preventDefault();
            js("#spin").removeClass("visually-hidden");
            js("#ExecuteRequest").attr('disabled', true);

            var url = "@Url.Action("ConsultaMA", "ConsultaMA")";

            var data = new Object();
            data.claveProducto = js("#claveProducto").val();
            data.tipoBusqueda = js("#tipoBusqueda").val();
            data.valorBusqueda = js("#valorBusqueda").val();

            js.ajax({
            type: "POST",
            url: url,
            dataType: "json",

            data: data,
            success: function (data) {
                console.log(data);

                if (data.codigo != 0) {
                    var mensajeLimpio = decodeHtmlEntities(data.mensaje);
                    swal({
                        title: "Error",
                        text: mensajeLimpio,
                        type: "warning",
                        showCancelButton: false,
                        confirmButtonColor: "#DD6B55",
                        closeOnConfirm: false
                    });
                    js("#valorBusqueda").val("");
                    js("#tabla").addClass("visually-hidden");
                    js("#cuentahabiente").addClass("visually-hidden");
                }
                else {
                    js("#cuentahabiente").removeClass("visually-hidden");
                    js("#nombreCompleto").text(data.nombreCompleto);
                    js("#numero").text(data.numero);
                     solicitanteNum = data.numero;
                     var direc =  consultarDomicilioSolicitante(data.numero);


                    console.log(" es direc" , direc);
                  //  $('#direccionCH').val(direc);


                    js("#fechaNacimiento").text(data.fechaNacimiento);
                    js("#direccion").text(direc);
                    js("#curp").text(data.curp);
                    js("#lugarNacimiento").text(data.lugarNacimiento);
                    js("#rfc").text(data.rfc);
                    js("#ocupacion").text(data.ocupacion);
                    js("#email").text(data.correoElectronico);
                    js("#telefono").text(data.telefono);
                    js("#sexo").text(data.sexo);
                    js("#nivelCuenta").text(data.nivelCuenta);



                    var value = data.saldoCuenta;
                    js("#saldo").text(currencyFormatter({ currency: "USD", value }));

                    js("#tabla").removeClass("visually-hidden");

                    js('#example').dataTable({
                        destroy: true,
                        responsive: true,
                        scrollX: true,
                        ordering: true,
                        paging: true,
                        language: {
                            "url": "../lib/Spanish.json"
                        },
                        data: data.mediosDisposicion,
                        columns: [
                            { 'data': 'medio' },
                            { data: 'cardId', defaultContent: 'N/D' }, 
                            { 'data': 'clave' },
                            { 'data': 'estatus' },
                            { 'data': 'tipo' },
                            { 'data': 'tipoProducto' }
                        ]
                    });
