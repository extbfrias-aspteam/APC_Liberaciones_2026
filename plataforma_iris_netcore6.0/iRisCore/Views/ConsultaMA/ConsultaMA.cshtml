        // Función para actualizar la dirección concatenada
        function actualizarReferencias() {
            const tipoCalle = js("#tipoCallePrincipal option:selected").text();
            const calle = document.getElementById('direccionCH').value;
            const tipoEntre1 = js("#tipoEntreCalle1 option:selected").text();
            const entre1 = document.getElementById('entreCalle1').value;
            const tipoEntre2 = js("#tipoEntreCalle2 option:selected").text();
            const entre2 = document.getElementById('entreCalle2').value;
            const tipoNum = js("#tipoNumExt option:selected").text();
            const numExt = document.getElementById('numExt').value;
            const tipoInt = js("#tipoNumInt option:selected").text();
            const numInt = document.getElementById('numInterior').value;

            // Actualizar el textarea con la dirección generada
            document.getElementById('direccionConcatenada').value = generarDomicilioJS(
                tipoCalle, calle,
                tipoEntre1, entre1,
                tipoEntre2, entre2,
                tipoNum, numExt,
                tipoInt, numInt
            );
        }

        // Función para generar el domicilio completo
        function generarDomicilioJS(
            cat_dom1, descrip1,
            cat_dom2, descrip2,
            cat_dom3, descrip3,
            cat_dom4, descrip4,
            cat_dom5, descrip5
        ) {
            // Verificar si tenemos los datos de abreviaciones
            if (!tiposDomicilioCache || !Array.isArray(tiposDomicilioCache.data)) {
                console.warn("Datos de tipos de domicilio no disponibles");
                return "";
            }

            // Obtener abreviaciones
            const getAbreviacion = (descripcion) => {
                const tipo = tiposDomicilioCache.data.find(item => item.descripcion === descripcion);
                return tipo ? tipo.abreviacion || "" : "";
            };

            let cat1 = getAbreviacion(cat_dom1);
            let cat2 = getAbreviacion(cat_dom2);
            let cat3 = getAbreviacion(cat_dom3);
            let cat4 = getAbreviacion(cat_dom4);
            let cat5 = getAbreviacion(cat_dom5);

            let des1 = descrip1.trim();
            const des2 = descrip2.trim();
            const des3 = descrip3.trim();
            let des4 = descrip4 === '0' ? '' : descrip4.trim();
            let des5 = descrip5 === '0' ? '' : descrip5.trim();

            // S/C o s/c => se omite calle
            if (des1.toLowerCase() === 's/c') {
                des1 = '';
                cat1 = '';
            }

            // Si cat4 y cat5 están vacíos, se asigna 'S/N' a cat4
            if (!cat4 && !cat5) {
                cat4 = 'S/N';
            }

