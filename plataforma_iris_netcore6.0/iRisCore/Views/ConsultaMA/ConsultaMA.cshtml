    // Función para buscar datos del CP
    function consultarDatosCP(cp) {
        console.log("Iniciando consulta para CP:", cp);
        js('#loadingCP').removeClass('visually-hidden');
        resetCPFields();

        $.ajax({
            url: '@Url.Action("ConsultarCodigoPostal", "ConsultaMA")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ cp: cp }),
            success: function (response) {
                console.log("Respuesta cruda:", response);

                if (!response) {
                    swal("Error", "No se recibió respuesta del servidor", "error");
                    return;
                }

                if (response.codigo === 0 ) {
                    console.log("Datos recibidos:", response.data);

                    if (!response.data || !response.data.length) {
                      swal("Advertencia", "No hay colonias para este CP", "warning");
                      return;
                    }

                    // Llenar campos
                    $('#estadoCH').val(response.data[0].estado);
                    $('#municipioCH').val(response.data[0].municipio);
                    $('#codigoPostal').val(response.data[0].cp);
                    $('#localidadCH').val(response.data[0].localidad);
                    $('#coloniaId').val(response.data[0].clave);
                  //  $('#coloniaCH').val(response.data[0].colonia);
                    // Llenar select
                    var $select = $('#coloniaCH').empty();
                 $select.append('<option value="">Seleccione...</option>');

                    $.each(response.data, function (i, colonia) {
                        $select.append($('<option>', {
                            value: colonia.clave,
                            text: colonia.colonia
                        }));
                    });

                    $select.prop('disabled', false);
                } else if (response.codigo === 1) {
                    swal("Advertencia", response.mensaje, "warning");   // <--- arreglado aquí
                } else {
                    swal("Error", response.mensaje || "Error desconocido", "error");
                }
