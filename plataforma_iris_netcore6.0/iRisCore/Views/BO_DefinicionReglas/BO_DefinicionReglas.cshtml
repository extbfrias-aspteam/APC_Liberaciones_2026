@{
    ViewData["Title"] = "BO_DefinicionReglas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Estilos {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/select/1.3.1/css/select.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <style>
        .dt-button {
            display: none !important;
            /* Oculta el botón de exportación */
        }
    </style>
}

<h5>Definición de Reglas</h5>
<div class="form-text">Esta vista permitirá Administrar la definición de las reglas para la prevención de fraudes.</div>

<div class="card-box">
    <div class="card-body">
        <div class="p-4 bg-white shadow-sm mb-5 rounded table-responsive">
            <table id="tblReglas" class="table table-striped table-borderless" style="width:100%">
                <thead>
                    <tr>
                        <th>Identificador</th>
                        <th>Nombre de la Regla</th>
                        <th>Estatus</th>
                        <th>Fecha de Aplicación</th>
                        <th>Usuario</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<input type="hidden" id="idRegla" value="" />
<!-- MODAL CONFIGURAR REGLA MMP -->
<div class="modal fade" tabindex="-1" id="modalConfReglaMMP">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Configurar Reglas MMP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="mb-3">
                    <div class="d-flex gap-3">
                        <div class="col-5">
                            <select class="form-select" name="participantes" id="participantes" disabled>
                                <option value="-1" selected disabled>Seleccione al participante...</option>
                            </select>
                            <div class="form-text">Participante</div>
                        </div>
                        <div class="col">
                            <input type="text" inputmode="decimal" step="0.01" autocomplete="off" class="form-control" id="monto" placeholder="Monto" maxlength="12" />
                            <div class="form-text">Monto</div>
                        </div>
                        <div class="col">
                            <input type="text" inputmode="decimal" step="0.01" autocomplete="off" class="form-control" id="montoConf" placeholder="Confirmar Monto" maxlength="12" />
                            <div class="form-text">Confirmar Monto</div>
                        </div>
                        <div class="col">
                            <button type="button" class="btn btn-primary rounded-1" id="btnNuevaConf" onclick="guardarConfReglaMMP()">
                                <i class="fa-solid fa-plus"></i>&nbsp;Nuevo&nbsp;<span id="spnNuevaConf" class="spinner-border spinner-border-sm visually-hidden"></span>
                            </button>
                            <button type="button" class="btn btn-primary rounded-1 visually-hidden" id="btnGuardarConf" onclick="guardarConfReglaMMP()">
                                Guardar&nbsp;<span id="spnGuardarConf" class="spinner-border spinner-border-sm visually-hidden"></span>
                            </button>
                            <button type="button" class="btn btn-secondary rounded-1 visually-hidden" id="btnLimpiarConf" onclick="limpiarConfReglaMMP()">
                                Limpiar
                            </button>
                            <!-- <button type="button" class="btn btn-success rounded-1 visually-hidden" id="btnActualizarConcepto" onclick="guardarConcepto()">
                                Actualizar&nbsp;<span id="spnActualizarConcepto" class="spinner-border spinner-border-sm visually-hidden"></span>
                            </button> -->
                        </div>
                    </div>

                </form>
                <!-- TABLA PARTICIPANTES CONFIGURADOS DE LA REGLA -->
                <table id="tblConfigReglasMMP" class="table table-striped table-borderless text-nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>Sel</th>
                            <th>Participante</th>
                            <th>Monto</th>
                            <th>Fecha</th>
                            <th>Estatus</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- MODAL AUTORIZAR REGLA MMP -->
<div class="modal fade" tabindex="-1" id="modalAuthReglaMMP">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Autorizar Reglas MMP</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- TABLA PARTICIPANTES CONFIGURADOS DE LA REGLA -->
                <table id="tblAuthReglasMMP" class="table table-striped table-borderless text-nowrap" style="width:100%">
                    <thead>
                        <tr>
                            <th>Participante</th>
                            <th>Monto</th>
                            <th>Fecha</th>
                            <th>Estatus</th>
                            <th class="text-center">Autorizar</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/select/1.3.1/js/dataTables.select.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.1.0/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.1.0/js/buttons.html5.min.js"></script>

<script type="text/javascript">
    var canAuthorize = @((ViewBag.CanAuthorize ?? false).ToString().ToLower()); // true/false JS
    var js = jQuery.noConflict(true);
    let modalConfReglaMMP, modalAuthReglaMMP;

    let rawMonto = '', rawMontoConf = '';

    js(document).ready(function () {
        tblReglas = js('#tblReglas').DataTable({
            processing: true,
            destroy: true,
            responsive: true,
            scrollX: true,
            ordering: true,
            paging: true,
            language: {
                "url": "../lib/Spanish.json",
                processing: ""
            },
            columns: [
                { data: 'idRegla' },
                {
                    data: 'nombreRegla',
                    render: function (data, type, row) {
                        return data ? data : "N/A";
                    }
                },
                { data: 'estatus' },
                { data: 'fechaAplicacion' },
                { data: 'usuario' },
                {
                    data: null,
                    orderable: false,
                    className: "text-nowrap ",
                    render: function (data, type, row) {
                        var btnAuth = `<button class="btn btn-outline-none p-0 mx-1" onclick="showModalAuthReglaMMP(event, ${row.idRegla})" title="Ahutorizar Reglas por Participante"><i class="fa-solid fa-user-tie"></i></button>`

                        return `<div class="text-center">
                            <button class="btn btn-outline-none p-0 mx-1" onclick="showModalConfReglaMMP(event, ${row.idRegla})" title="Configurar Reglas por Participantes">
                                <i class="fa-solid fa-gear"></i>
                            </button>${canAuthorize ? btnAuth : ""}
                        </div>
                    `;
                    }
                }
            ],
        });

        tblConfigReglasMMP = js('#tblConfigReglasMMP').DataTable({
            processing: true,
            destroy: true,
            responsive: true,
            scrollX: true,
            ordering: true,
            paging: true,
            language: {
                "url": "../lib/Spanish.json",
                processing: ""
            },
            columns: [
                {
                    data: null,
                    defaultContent: '',
                    orderable: false,
                    className: 'select-checkbox',
                    targets: 0
                },
                {
                    data: 'nombre',
                    render: function (data, type, row) {
                        return data ? data : "N/A";
                    }
                },
                {
                    data: 'monto',
                    render: function (data, type, row) {
                        return currencyMxnFormatter(data);
                    }
                },
                { data: 'fechaCreacion' },
                { data: 'estatus' }
            ],
            select: {
                style: 'single',
                selector: 'td:first-child'
            }
        });

        tblAuthReglasMMP = js('#tblAuthReglasMMP').DataTable({
            processing: true,
            destroy: true,
            responsive: true,
            scrollX: true,
            ordering: true,
            paging: true,
            language: {
                "url": "../lib/Spanish.json",
                processing: ""
            },
            columns: [
                {
                    data: 'nombre',
                    render: function (data, type, row) {
                        return data ? data : "N/A";
                    }
                },
                {
                    data: 'monto',
                    render: function (data, type, row) {
                        return currencyMxnFormatter(data);
                    }
                },
                { data: 'fechaCreacion' },
                { data: 'estatus' },
                {
                    data: null,
                    orderable: false,
                    className: "text-nowrap ",
                    render: function (data, type, row) {
                        if (row.estatus == 'Pendiente')
                            return `<div class="text-center"><button class="btn btn-outline-none p-0 mx-1 btn-auth" title="Autorizar Regla">
                                            <i class="fa-solid fa-check"></i>
                                        </button></div>`;
                        else return "";
                    }
                }
            ],
        });

        tblConfigReglasMMP.on('select deselect', function () {
            onSelectDeselect();
        });

        modalConfReglaMMP = new bootstrap.Modal(document.getElementById('modalConfReglaMMP'));
        modalAuthReglaMMP = new bootstrap.Modal(document.getElementById('modalAuthReglaMMP'));

        participantes.disabled = true;

        js('#tblAuthReglasMMP tbody').on('click', '.btn-auth', function (event) {
            event.preventDefault();
            const button = event.currentTarget;
            const row = tblAuthReglasMMP.row($(button).closest('tr')).data();
            var data = new Object();
            data.idPendiente = row.idPendiente;
            data.usuario = "";

            swal({
                title: "Confirmación",
                html: true,
                text: `¿Deseas autorizar el límite de <span class="fw-bold">${currencyMxnFormatter(row.monto)}</span> del participante <span  class="fw-bold">${row.nombre}</span>?`,
                type: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#DD6B55",
                confirmButtonText: "Autorizar",
                cancelButtonText: "Cancelar",
                closeOnConfirm: true
            }, function (isConfirm) {
                if (isConfirm) {
                    const inner = button.innerHTML;
                    button.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
                    button.disabled = true;

                    ajaxCall("GET", "SetAuthConfig", "BO_DefinicionReglas", data, (result) => {
                        swal({
                            type: 'success',
                            title: 'Éxito',
                            text: result.mensaje,
                            confirmButtonText: 'Aceptar',
                            confirmButtonColor: "#0B6E4F",
                        });
                        setTblAuthReglasMMP();
                    }, () => {
                        button.innerHTML = inner;
                        button.disabled = true;
                    });
                }
            });
        });

        js('#monto, #montoConf').on('input', function (event) {
            btnLimpiarConf.classList.remove("visually-hidden")
        });

        $('#participantes').on('change', function () {
            const idPblu = $(this).val();
            limpiarConfReglaMMP();
            setTblConfReglasMMP(idPblu);
            participantes.value = idPblu;
            btnLimpiarConf.classList.remove('visually-hidden');
        });

        setTimeout(() => {
            js('#tblReglas_processing').show();
        }, 100)

        //Carga reglas
        ajaxCall("GET", "GetReglas", "BO_DefinicionReglas", null, (result) => {
            tblReglas.clear();
            tblReglas.rows.add(result.data);
            tblReglas.draw();
        }, () => {
            js('#tblReglas_processing').hide();
        });

        //Carga Participantes
        ajaxCall("GET", "GetParticipantes", "BO_DefinicionReglas", null, (result) => {
            participantes.innerHTML = "";
            participantes.insertAdjacentHTML("beforeend", '<option value="-1" selected disabled>Seleccione al participante...</option>');
            participantes.disabled = result.data.length == 0;

            if (result.data.length > 0) {
                result.data.sort((a, b) => {
                    const nombreA = a.descripcion?.toLowerCase() || a.nombreComercial?.toLowerCase() || "";
                    const nombreB = b.descripcion?.toLowerCase() || b.nombreComercial?.toLowerCase() || "";
                    return nombreA.localeCompare(nombreB);
                });
            }

            js.each(result.data, function (index, udn) {
                let option = document.createElement("option");
                option.value = udn.id;
                option.textContent = udn.descripcion.trim();
                participantes.appendChild(option);
            });
        });
    });

    //#region Modal Configurar Reglas MMP
    function showModalConfReglaMMP(event, idRegla) {
        event.preventDefault();

        if (idRegla == 4) {
            idRegla.value = idRegla;
            limpiarConfReglaMMP();
            modalConfReglaMMP.show();
            setTimeout(() => { tblConfigReglasMMP.clear().draw(); }, 200);
        }
    }

    function setTblConfReglasMMP(idPblu) {
        const req = new Object();
        req.idPblu = idPblu;
        req.estatus = "";

        js('#tblConfigReglasMMP_processing').show();
        disableRowSelection();
        tblConfigReglasMMP.clear().draw();
        ajaxCall("POST", "GetConfigs", "BO_DefinicionReglas", req, (result) => {
            tblConfigReglasMMP.clear();
            tblConfigReglasMMP.rows.add(result.data);
            tblConfigReglasMMP.draw();
        }, () => {
            js('#tblConfigReglasMMP_processing').hide();
            enableRowSelection();
        });
    }

    function limpiarConfReglaMMP() {
        participantes.selectedIndex = 0;

        monto.value = montoConf.value = rawMonto = rawMontoConf = '';

        btnNuevaConf.disabled = btnGuardarConf.disabled = btnLimpiarConf.disabled = false;
        btnNuevaConf.classList.remove('visually-hidden');
        btnGuardarConf.classList.add('visually-hidden');
        btnLimpiarConf.classList.add('visually-hidden');
        spnGuardarConf.classList.add('visually-hidden');
        spnNuevaConf.classList.add('visually-hidden');

        tblConfigReglasMMP.clear().draw();
    }

    function guardarConfReglaMMP() {
        const inputs = [
            monto,
            montoConf,
        ];
        const selects = [{
            element: participantes,
            defaultText: "Seleccione al participante..."
        },];

        if (validarCamposGenerico(inputs, selects, null)) {
            if (validarMontos(rawMonto, rawMontoConf)) {
                btnNuevaConf.disabled = btnGuardarConf.disabled = btnLimpiarConf.disabled = true;
                spnNuevaConf.classList.remove("visually-hidden");
                spnGuardarConf.classList.remove("visually-hidden");

                const idPblu = participantes.value;

                var data = new Object();
                data.idParticipante = idPblu;
                data.monto = rawMonto;
                data.usuario = "";

                ajaxCall("GET", "SetConfig", "BO_DefinicionReglas", data, (result) => {
                    swal({
                        type: 'success',
                        title: 'Éxito',
                        text: result.mensaje,
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: "#0B6E4F",
                    });
                    setTblConfReglasMMP(idPblu);
                    limpiarConfReglaMMP();
                }, () => {
                    btnNuevaConf.disabled = btnGuardarConf.disabled = btnLimpiarConf.disabled = false;
                    spnNuevaConf.classList.add("visually-hidden");
                    spnGuardarConf.classList.add("visually-hidden");
                    participantes.value = idPblu;
                });
            }
        }
    }

    function enableRowSelection() {
        js('#tblConfigReglasMMP tbody').on('click', 'tr', function () {
            if (!js(event.target).hasClass("select-checkbox")) {
                var row = tblConfigReglasMMP.row(this);
                if (js(this).hasClass('selected'))
                    row.deselect();
                else
                    row.select();
            }
        });
    }

    function disableRowSelection() {
        js('#tblConfigReglasMMP tbody').off('click', 'tr');
    }

    function onSelectDeselect() {
        var anySelected = tblConfigReglasMMP.row({ selected: true }).count() > 0;

        if (anySelected) {
            const row = tblConfigReglasMMP.row({ selected: true }).data();
            const estado = row.estatus;
            rawMonto = rawMontoConf = row.monto.toString().replace(/[^\d.]/g, '');

            participantes.value = row.idParticipante;
            monto.value = '*'.repeat(rawMonto.length);
            montoConf.value = '*'.repeat(rawMonto.length);

            btnNuevaConf.classList.add("visually-hidden");
            btnGuardarConf.classList.remove("visually-hidden");
            btnLimpiarConf.classList.remove("visually-hidden");
        } else {
            //limpiarEncabezados();
        }

        //btnResolverAlerta.disabled = !anySelected;
    }

    monto.addEventListener('blur', (e) => {
        const raw = e.target.value.replace(/[^\d.]/g, '');
        rawMonto = raw;
        monto.value = '*'.repeat(rawMonto.length);

        if (rawMontoConf.length > 0)
            validarMontos(rawMonto, rawMontoConf);
    });

    monto.addEventListener('focus', () => {
        monto.value = rawMonto;
    });

    montoConf.addEventListener('blur', (e) => {
        const raw = e.target.value.replace(/[^\d.]/g, '');
        rawMontoConf = raw;
        montoConf.value = '*'.repeat(rawMontoConf.length);

        if (rawMonto.length > 0)
            validarMontos(rawMonto, rawMontoConf);
    });

    montoConf.addEventListener('focus', () => {
        montoConf.value = rawMontoConf;
    });

    function validarMontos(montoA, montoB) {
        if (parseFloat(montoA) !== parseFloat(montoB)) {
            swal({
                type: 'error',
                title: 'Error',
                text: "Los montos no coinciden",
                confirmButtonText: 'Aceptar',
                confirmButtonColor: "#DD6B55",
            });
            return false;
        }
        return true;
    }
    //#endregion

    //#region Modal Autorizar Reglas MMP
    function showModalAuthReglaMMP(event, idRegla) {
        event.preventDefault();

        if (idRegla == 4) {
            idRegla.value = idRegla;
            modalAuthReglaMMP.show();
            setTimeout(() => {
                tblAuthReglasMMP.clear().draw();
                setTblAuthReglasMMP();
            }, 200);
        }
    }

    function setTblAuthReglasMMP() {
        const req = new Object();
        req.idPblu = 0;
        req.estatus = "Pendiente";

        js('#tblAuthReglasMMP_processing').show();
        ajaxCall("POST", "GetAuths", "BO_DefinicionReglas", req, (result) => {
            tblAuthReglasMMP.clear();
            tblAuthReglasMMP.rows.add(result.data);
            tblAuthReglasMMP.draw();
        }, () => {
            js('#tblAuthReglasMMP_processing').hide();
        });
    }
    //#endregion

    //#region General
    function ajaxCall(type, task, controller, data, successFunction, finallyFunction) {
        js.ajax({
            type: type,
            url: '@Url.Action("__TASK__", "__CONTROLLER__")'
                .replace("__TASK__", task)
                .replace("__CONTROLLER__", controller),
            dataType: "json",
            data: data,
            success: function (data) {
                if (data.result.codigo == 1)
                    successFunction(data.result);
                else
                    //console.error('Error:', data.result.mensaje);
                    swal({
                        type: 'error',
                        title: 'Error',
                        text: data.result.mensaje,
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: "#DD6B55",
                    });
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
            }
        }).always(finallyFunction);
    }

    // Función para validar todos los campos vacios
    function validarCamposGenerico(inputs, selects, checkbox = null) {

        // Validación de campos vacíos
        const camposVacios = inputs.length > 0 && inputs.every(input => input.value.trim() == "") && (!!checkbox ? !checkbox.checked : true);

        // Validación de selects con valores por defecto
        const selectsInvalidos = selects.some(select => select.element.options[select.element.selectedIndex].text == select.defaultText);

        // Condición para mostrar el mensaje de advertencia
        if (camposVacios || selectsInvalidos) {
            swal({
                type: 'warning',
                title: 'Formulario vacío',
                text: 'El formulario no puede enviarse con campos vacíos ni con valores predeterminados en las listas desplegables.',
                confirmButtonText: 'Aceptar',
                confirmButtonColor: "#DD6B55",
            });
            return false;
        }
        return true;
    }

    function currencyMxnFormatter(value) {
        return new Intl.NumberFormat('es-MX', {
            style: 'currency',
            currency: 'MXN',
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        }).format(value);
    }
    //#endregion
</script>