@{
    ViewData["Title"] = "BO_MonitorAleras";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Estilos {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/select/1.3.1/css/select.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <style>
        .dt-button {
            display: none !important;
            /* Oculta el botón de exportación */
        }
    </style>
}

<h5>Monitor de Alertas</h5>
<div class="form-text">Esta vista permitirá Administrar las alertas generadas para la prevención de fraudes.</div>

<div class="card-box">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-xl-5">
                <select class="form-select" name="participantes" id="participantes" disabled>
                    <option value="-1" selected disabled>Seleccione al participante...</option>
                </select>
                <div class="form-text">Participante</div>
            </div>
            <div class="col-xl-2">
                <input class="form-control" id="clabe" placeholder="CLABE" />
                <div class="form-text">CLABE</div>
            </div>
            <div class="col-xl-2">
                <input class="form-control" id="cveRastreo" placeholder="Clave Rastreo" />
                <div class="form-text">Clave Rastreo</div>
            </div>
            <div class="col-xl-3">
                <button type="button" class="btn btn-success rounded-1" id="btnBuscar" disabled style="max-width: 10em;">
                    Buscar&nbsp;<span id="spnBuscar" class="spinner-border spinner-border-sm visually-hidden"></span>
                </button>
                <button type="button" class="btn btn-secondary rounded-1 visually-hidden" id="btnLimpiarBusqueda">
                    Limpiar
                </button>
            </div>
            <div class="col-xl-6">
                <input class="form-control" id="titular" placeholder="Titular" disabled />
                <div class="form-text">Titular</div>
            </div>
            <div class="col-xl-2">
                <input class="form-control" id="fechaAlta" placeholder="Fecha Alta" disabled />
                <div class="form-text">Fecha Alta</div>
            </div>
        </div>
    </div>
</div>

<div class="p-4 bg-white shadow-sm mb-5 rounded table-responsive">
    <div class="row mb-4">
        <div class="col-12 text-start">
            <button type="button" id="btnResolverAlerta" class="btn btn-warning" disabled>
                Resolver Alerta&nbsp;<span id="spnResolverAlerta" class="spinner-border spinner-border-sm visually-hidden"></span>
            </button>
        </div>
    </div>
    <table id="tblAlertas" class="table table-striped table-borderless text-nowrap" style="width:100%">
        <thead>
            <tr>
                <th>Sel</th>
                <th>Id Alerta</th>
                <th>Clabe</th>
                <th>Clave Rastreo</th>
                <th>Fecha Operación</th>
                <th>Monto</th>
                <th>Estatus</th>
                @* <th>Acciones</th> *@
            </tr>
        </thead>
    </table>
</div>

<input type="hidden" id="claveRastreo" value="" />
<!-- MODAL RESOLVER ALERTA -->
<div class="modal fade" tabindex="-1" id="modalAlerta">
    <div class="modal-dialog modal-dialog-centered modal-md modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Resolver Alerta <strong id="idAlerta"></strong></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="mb-3">
                    <div class="row gap-3">
                        <div class="col-12">
                            <select class="form-select" name="nuevoEstado" id="nuevoEstado" disabled>
                                <option value="-1" selected disabled>Seleccione el nuevo estado...</option>
                            </select>
                            <div class="form-text">Nuevo Estado</div>
                        </div>
                        <div class="col-12">
                            <textarea class="form-control" id="resolucion" placeholder="Resolución" rows="4" maxlength="160"></textarea>
                            <div class="form-text">Resolución</div>
                        </div>
                        <div class="col-12">
                            <textarea class="form-control" id="detalles" placeholder="Detalles" rows="4" maxlength="160"></textarea>
                            <div class="form-text">Detalles</div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-1" id="btnCancelarAlerta" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" class="btn btn-primary rounded-1" id="btnGuardarAlerta">
                    Guardar&nbsp;<span id="spnGuardarAlerta" class="spinner-border spinner-border-sm visually-hidden"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/select/1.3.1/js/dataTables.select.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.1.0/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.1.0/js/buttons.html5.min.js"></script>

<script type="text/javascript">
    var canAuthorize = @((ViewBag.CanAuthorize ?? false).ToString().ToLower());
    var js = jQuery.noConflict(true);
    let modalAlerta;
    let rawMonto = '', rawMontoConf = '', rawIdPblu = '', rawClabe = '', rawCveRas = '';

    js(document).ready(function () {
        tblAlertas = js('#tblAlertas').DataTable({
            processing: true,
            destroy: true,
            responsive: true,
            scrollX: true,
            ordering: true,
            paging: true,
            language: {
                "url": "../lib/Spanish.json",
                processing: ""
            },
            columns: [
                {
                    data: null,
                    defaultContent: '',
                    orderable: false,
                    className: 'select-checkbox',
                    targets: 0
                },
                { data: 'idAlerta' },
                { data: 'clabe' },
                { data: 'claveRastreo' },
                { data: 'fechaCreacion' },
                {
                    data: null,
                    render: function (data, type, row) {
                        return currencyMxnFormatter(row.monto);
                    },
                },
                { data: 'estatus' },

            ],
            columnDefs: [
                {
                    targets: 2,
                    type: 'date' // O 'datetime' si usas hora
                }
            ],
            order: [[2, 'desc']],
            select: {
                style: 'single',
                selector: 'td:first-child'
            }
        });

        modalAlerta = new bootstrap.Modal(document.getElementById('modalAlerta'));

        js('#tblAlertas_processing').show();

        tblAlertas.on('select deselect', function () {
            onSelectDeselect();
        });

        js("#participantes").attr('disabled', true);

        disableRowSelection()
        ajaxCall("GET", "GetParticipantes", "BO_MonitorAlertas", null, (result) => {
            participantes.innerHTML = "";
            participantes.insertAdjacentHTML("beforeend", '<option value="-1" selected disabled>Seleccione al participante...</option>');
            participantes.disabled = result.data.length == 0;

            if (result.data.length > 0) {
                result.data.sort((a, b) => {
                    const nombreA = a.descripcion?.toLowerCase() || a.nombreComercial?.toLowerCase() || "";
                    const nombreB = b.descripcion?.toLowerCase() || b.nombreComercial?.toLowerCase() || "";
                    return nombreA.localeCompare(nombreB);
                });
            }
            if (result.data.length > 0) {
                let option = document.createElement("option");
                option.value = 0;
                option.textContent = "Todos";
                participantes.appendChild(option);
                participantes.disabled = false;
            }

            js.each(result.data, function (index, udn) {
                let option = document.createElement("option");
                option.value = udn.id;
                option.textContent = udn.descripcion.trim();
                participantes.appendChild(option);
            });

        }, () => {
            enableRowSelection();
        });
    });

    function enableRowSelection() {
        js('#tblAlertas tbody').on('click', 'tr', function () {
            if (!js(event.target).hasClass("select-checkbox")) {
                var row = tblAlertas.row(this);
                if (js(this).hasClass('selected'))
                    row.deselect();
                else
                    row.select();
            }
        });
    }

    function disableRowSelection() {
        js('#tblAlertas tbody').off('click', 'tr');
    }

    function setTblAlertas() {
        disableRowSelection();
        btnBuscar.disabled = btnLimpiarBusqueda.disabled = true;
        btnLimpiarBusqueda.classList.remove("visually-hidden");
        spnBuscar.classList.remove("visually-hidden");
        js('#tblAlertas_processing').show();

        var data = new Object();
        data.idParticipante = rawIdPblu;
        data.clabe = rawClabe;
        data.claveRastreo = rawCveRas;

        ajaxCall("POST", "GetAlertas", "BO_MonitorAlertas", data, (result) => {
            tblAlertas.clear();
            tblAlertas.rows.add(result.data);
            tblAlertas.draw();
            //onSelectDeselect();
        }, () => {
            js('#tblAlertas_processing').hide();
            btnBuscar.disabled = btnLimpiarBusqueda.disabled = false;
            //btnLimpiarBusqueda.classList.add("visually-hidden");
            spnBuscar.classList.add("visually-hidden");
            enableRowSelection();
        });
    }

    function onSelectDeselect() {
        var anySelected = tblAlertas.row({ selected: true }).count() > 0;

        if (anySelected) {
            const row = tblAlertas.row({ selected: true }).data();
            const estado = row.estatus;
            participantes.value = row.idPblu;
            clabe.value = row.clabe;
            cveRastreo.value = row.claveRastreo;
            fechaAlta.value = row.fechaClabe;
            titular.value = row.titularClabe;

            if (estado === "Pendiente" || estado === "Baja Prioridad")
                anySelected = true;
            else if (estado === "Alta Prioridad")
                anySelected = canAuthorize;
            else if (estado === "Validada" || estado === "Bloqueada")
                anySelected = false;

            btnBuscar.disabled = btnLimpiarBusqueda.disabled = false;
            btnLimpiarBusqueda.classList.remove("visually-hidden");
        } else
            limpiarEncabezados();

        btnResolverAlerta.disabled = !anySelected;
    }

    js("#btnResolverAlerta").on('click', '', function (event) {
        //#region Modal Alerta
        event.preventDefault();

        limpiar();
        const row = tblAlertas.row({ selected: true }).data();
        const estadoActual = row.estatus;
        idAlerta.innerText = row.idAlerta;
        claveRastreo.value = row.claveRastreo;

        function llenarSelect(estadoActual, canAuthorize) {
            let opciones = [];

            switch (estadoActual) {
                case "Pendiente":
                    opciones.push("Baja Prioridad", "Alta Prioridad");
                    if (canAuthorize) opciones.push("Validada", "Bloqueada");
                    break;

                case "Baja Prioridad":
                    opciones.push("Alta Prioridad");
                    if (canAuthorize) opciones.push("Validada", "Bloqueada");
                    break;

                case "Alta Prioridad":
                    if (canAuthorize) opciones.push("Validada", "Bloqueada");
                    break;

                case "Validada":
                case "Bloqueada":
                    // No se llena el select
                    return;
            }

            // Quitar el estado actual si está presente
            opciones = opciones.filter(e => e !== estadoActual);

            // Agregar opciones al select
            opciones.forEach(opcion => {
                const opt = document.createElement("option");
                opt.value = opcion;
                opt.text = opcion;
                nuevoEstado.appendChild(opt);
                nuevoEstado.disabled = false;
            });
        }

        llenarSelect(estadoActual, canAuthorize)

        modalAlerta.show();
    });

    js("#btnGuardarAlerta").on('click', '', function (event) {
        const inputs = [resolucion, detalles];
        const selects = [{
            element: nuevoEstado,
            defaultText: "Seleccione el nuevo estado..."
        },];

        if (validarCamposGenerico(inputs, selects, null)) {
            btnGuardarAlerta.disabled = true;
            spnGuardarAlerta.classList.remove("visually-hidden");

            var data = new Object();
            data.claveRastreo = claveRastreo.value;
            data.nuevoEstado = nuevoEstado.value;
            data.resolucion = resolucion.value;
            data.detalles = detalles.value;
            data.usuario = "";

            //limpiarEncabezados();
            ajaxCall("POST", canAuthorize ? "SetAlertaAdm" : "SetAlerta", "BO_MonitorAlertas", data, (result) => {
                setTblAlertas();
                swal({
                    type: 'success',
                    title: 'Éxito',
                    text: result.mensaje,
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: "#0B6E4F",
                });
                modalAlerta.hide();
                setTimeout(() => {
                    limpiar();
                }, 500)
            }, () => {
                btnGuardarAlerta.disabled = false;
                spnGuardarAlerta.classList.add("visually-hidden");
            });
        }
    });

    js("#btnCancelarAlerta").on('click', '', function (event) {
        setTimeout(() => {
            limpiar();
        }, 500)
    });

    js("#btnBuscar").on('click', '', function (event) {
        rawIdPblu = participantes.selectedIndex == 0 ? 0 : participantes.value;
        rawClabe = clabe.value;
        rawCveRas = cveRastreo.value;

        setTblAlertas();
    });

    js("#btnLimpiarBusqueda").on('click', '', function (event) {
        limpiarEncabezados();
    });

    js('#participantes').on('change', function () {
        btnBuscar.disabled = btnLimpiarBusqueda.disabled = false;
        btnLimpiarBusqueda.classList.remove("visually-hidden");
    });

    js("#clabe, #cveRastreo").on('input', function (event) {
        if (clabe.value.trim() == '' && cveRastreo.value.trim() == '' && participantes.selectedIndex <= 0) {
            btnBuscar.disabled = true;
            btnLimpiarBusqueda.classList.add("visually-hidden");
        }
        else {
            btnBuscar.disabled = false;
            btnLimpiarBusqueda.classList.remove("visually-hidden");
        }
    });

    function limpiarEncabezados() {
        btnBuscar.disabled = true;
        btnLimpiarBusqueda.classList.add("visually-hidden");
        tblAlertas.rows({ selected: true }).deselect();
        participantes.selectedIndex = 0;
        clabe.value = fechaAlta.value = titular.value = idAlerta.innerText = claveRastreo.value = cveRastreo.value = "";
    }

    function limpiar() {
        resolucion.value = detalles.value = "";
        nuevoEstado.selectedIndex = 0;
        nuevoEstado.options.length = 1;
        nuevoEstado.disabled = true;
        btnGuardarAlerta.disabled = false;
        spnGuardarAlerta.classList.add('visually-hidden');
    }

    //#endregion

    //#region General
    function ajaxCall(type, task, controller, data, successFunction, finallyFunction) {
        js.ajax({
            type: type,
            url: '@Url.Action("__TASK__", "__CONTROLLER__")'
                .replace("__TASK__", task)
                .replace("__CONTROLLER__", controller),
            dataType: "json",
            data: data,
            success: function (data) {
                if (data.result.codigo == 1)
                    successFunction(data.result);
                else
                    //console.error('Error:', data.result.mensaje);
                    swal({
                        type: 'error',
                        title: 'Error',
                        text: data.result.mensaje,
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: "#DD6B55",
                    });
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
            }
        }).always(finallyFunction);
    }

    // Función para validar todos los campos vacios
    function validarCamposGenerico(inputs, selects, checkbox = null) {

        // Validación de campos vacíos
        const camposVacios = inputs.length > 0 && inputs.every(input => input.value.trim() == "") && (!!checkbox ? !checkbox.checked : true);

        // Validación de selects con valores por defecto
        const selectsInvalidos = selects.some(select => select.element.options[select.element.selectedIndex].text == select.defaultText);

        // Condición para mostrar el mensaje de advertencia
        if (camposVacios || selectsInvalidos) {
            swal({
                type: 'warning',
                title: 'Formulario vacío',
                text: 'El formulario no puede enviarse con campos vacíos ni con valores predeterminados en las listas desplegables.',
                confirmButtonText: 'Aceptar',
                confirmButtonColor: "#DD6B55",
            });
            return false;
        }
        return true;
    }

    function currencyMxnFormatter(value) {
        return new Intl.NumberFormat('es-MX', {
            style: 'currency',
            currency: 'MXN',
            minimumFractionDigits: 2,
            maximumFractionDigits: 2,
        }).format(value);
    }
    //#endregion
</script>