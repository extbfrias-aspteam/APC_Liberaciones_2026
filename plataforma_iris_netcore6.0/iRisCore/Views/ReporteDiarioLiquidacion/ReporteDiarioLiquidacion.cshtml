
@{
    ViewData["Title"] = "ReporteDiarioLiquidacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Estilos {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<h5>Reporte Diario de Liquidación</h5>
<div id="emailHelp" class="form-text">Visualización de la Información del Reporte de Liquidación.</div>
<div class="card-box">
    <div class="card-body">
        <form class="">
            <div class="row g-2">
                <div class="col-sm-6">
                    <input class="form-control" type="file" name="fileUpload" id="fileUpload">
                </div>

                <div class="col-sm-6">
                    <button type="submit" id="ExecuteRequest" class="btn btn-success">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación</button>
                </div>
            </div>
        </form>
    </div>
</div>

<br />

<div class="row gx-5 visually-hidden" id="tabla">

    <table id="example" class="display" style="width:100%">
        <thead>
            <tr>
                <th>CveMovo</th>
                <th>Movto</th>
                <th>MovtoOrigin</th>
                <th>Tarjeta</th>
                <th>CodigoTx</th>
                <th>Comercio</th>
                <th>Ciudad</th>
                <th>Pais</th>
                <th>MCC</th>
                <th>Referencia</th>
                <th>ImporteAut</th>
                <th>MonedaAut</th>
                <th>ImporteOtraMoneda</th>
                <th>OtraMoneda</th>
                <th>ImporteCompensado</th>
                <th>MonedaCompensacion</th>
                <th>Autorizacion</th>
                <th>FechaAut</th>
                <th>FechaPresentacion</th>
                <th>FechaProcesamiento</th>
                <th>FechaJuliana</th>
                <th>Compensada</th>
            </tr>
        </thead>
    </table>
</div>

<div class="row">
    <div class="col-md-6 col-lg-4">
        <div class="text-center">
            <h3 class="text-dark" id="sCompensada"></h3>
            <p class="text-muted">Total Compensadas</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="text-center">
            <h3 class="text-danger" id="sDevuelta"></h3>
            <p class="text-muted">Total Devueltas</p>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="text-center">
            <h3 class="text-dark" id="sLiquidacion"></h3>
            <p class="text-muted">Total Liquidación</p>
        </div>
    </div>

</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

<script type="text/javascript">

    var js = jQuery.noConflict(true);
    js(document).ready(function () {

        js('#ExecuteRequest').on("click", function (event) {
            event.preventDefault();
            js("#spin").removeClass("visually-hidden");
            js("#ExecuteRequest").attr('disabled', true);

            var input = document.getElementById("fileUpload"); //get file input id
            var files = input.files; //get files
            var formData = new FormData(); //create form

            for (var i = 0; i != files.length; i++) {
                formData.append("files", files[i]); //loop through all files and append
            }

            $.ajax(
                {
                    url: "/ReporteDiarioLiquidacion/ReadFileNLQ",
                    data: formData, // send it as formData
                    processData: false,
                    contentType: false,
                    type: "POST", //type is post as we will need to post files
                    success: function (data) {                       
                        js("#tabla").removeClass("visually-hidden");
                        js('#example').dataTable({
                            destroy: true,
                            responsive: true,
                            scrollX: true,
                            ordering: true,
                            paging: true,
                            language: {
                                "url": "//cdn.datatables.net/plug-ins/9dcbecd42ad/i18n/Spanish.json"
                            },
                            data: data,
                            columns: [
                                { 'data': 'claveMovimiento' },
                                { 'data': 'movimiento' },
                                { 'data': 'movimientoOriginal' },
                                { 'data': 'tarjeta' },
                                { 'data': 'codigoTx' },
                                { 'data': 'comercio' },
                                { 'data': 'ciudad' },
                                { 'data': 'pais' },
                                { 'data': 'mcc' },
                                { 'data': 'referencia' },
                                { 'data': 'importeAut' },
                                { 'data': 'monedaAut' },
                                { 'data': 'importeOtraMoneda' },
                                { 'data': 'otraMoneda' },
                                { 'data': 'importeCompensado' },
                                { 'data': 'monedaCompensacion' },
                                { 'data': 'autorizacion' },
                                { 'data': 'fechaAut' },
                                { 'data': 'fechaPresentacion' },
                                { 'data': 'fechaProcesamiento' },
                                { 'data': 'fechaJuliana' },
                                { 'data': 'compensada' }
                            ],
                            columnDefs:
                                [
                                    {
                                        targets: 6,
                                        render: js.fn.dataTable.render.number(',', '.', 2, '')
                                    }
                                ]
                        });
                        js("#ExecuteRequest").attr('disabled', false);
                        js("#spin").addClass("visually-hidden");
                    }
                }
            );


            

