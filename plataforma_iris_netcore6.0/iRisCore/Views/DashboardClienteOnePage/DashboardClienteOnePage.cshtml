@using iRisModel;
@{
    ViewData["Title"] = "Dashboard OnePage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
@*     <link href="~/css/icons.css" rel="stylesheet" /> *@
}


<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Nuevo Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <input type="text" class="form-control" name="nombre" id="nombre" placeholder="Nombre Comercial" maxlength="60">
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="form-group">
                            <input type="text" class="form-control" name="razonSocial" id="razonSocial" placeholder="Razón Social" maxlength="100">
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <input type="text" class="form-control" name="rfc" id="rfc" placeholder="RFC" maxlength="15">
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="form-group">
                            <input type="text" class="form-control" name="direccionFiscal" id="direccionFiscal" placeholder="Dirección Fiscal" maxlength="100">
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <select class="form-select" name="idIdioma" id="idIdioma" aria-label="Default select example">
                                <option selected>Seleccione Idioma</option>
                                @if (ViewBag.Idioma != null)
                                {
                                    List<IdiomaModel> oNivel = (List<IdiomaModel>)ViewBag.Idioma;
                                    foreach (IdiomaModel item in oNivel)
                                    {
                                        <option value=@item.idIdioma>@item.descripcion</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <div class="form-group">
                            <input type="text" class="form-control" name="horarioFinal" id="horarioFinal" placeholder="Horario de Atención" maxlength="60">
                        </div>
                    </div>

                </div>
                <br />
                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="tieneTraductor" id="tieneTraductor">
                                <label class="form-check-label" for="flexCheckDefault">
                                    Traductor
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <input type="text" class="form-control" name="numeroCliente" id="numeroCliente" placeholder="Número de Cliente" maxlength="10">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <input type="text" class="form-control" name="numeroCuenta" id="numeroCuenta" placeholder="Número de Cuenta" maxlength="10">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <input type="text" class="form-control" name="cuentaClabe" id="cuentaClabe" placeholder="Cuenta CLABE" maxlength="18">
                        </div>
                    </div>
                </div>
                <br />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="form-group">
                                <select class="form-select" name="tipoCliente" id="tipoCliente" aria-label="Default select example">
                                    <option selected>Tipo de Cliente</option>
                                    @if (ViewBag.TipoCliente != null)
                                    {
                                        List<TipoClienteSpeiModel> oNivel = (List<TipoClienteSpeiModel>)ViewBag.TipoCliente;
                                        foreach (TipoClienteSpeiModel item in oNivel)
                                        {
                                            <option value=@item.idTipoCliente>@item.descripcionTipoCliente</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <select class="form-select" name="estatusCliente" id="estatusCliente" aria-label="Default select example">
                                <option selected>Estatus</option>
                                <option value="OPE">Operando</option>
                                <option value="IMP">Implementación</option>
                                <option value="INA">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <input type="text" class="form-control" name="modeloNegocio" id="modeloNegocio" placeholder="URL Modelo de Negocio" maxlength="100">
                        </div>
                    </div>
                </div>

            </div>


            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="ExecuteSaveInfo">Guardar</button>
            </div>
        </div>
    </div>
</div>


<h5>Dashboard OnePage B2B</h5>


<button type="button" id="ExecuteNew" data-bs-toggle="modal" data-bs-target="#staticBackdrop" class="btn btn-success waves-effect waves-light">+ Nuevo Participante Spei</button>
<button type="button" id="ExecuteExport" class="btn btn-warning waves-effect waves-light">Exportar XLS</button>
