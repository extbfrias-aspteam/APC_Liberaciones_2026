﻿@{
    ViewData["Title"] = "FormularioOpciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
   
}
@section Estilos {
    <link href="~/css/icons.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="~/css/bootstrap-datepicker.css" rel="stylesheet" />
    <link href="~/fonts/fontawesome-webfont.woff2">
}
<style>
    .card {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .card img {
            width: 25%; /* Reducción del tamaño de la imagen */
            margin: 0 auto; /* Centrado horizontal */
        }

    .card-title, .card-text {
        text-align: center; /* Centrado del texto */

    }

    .card-footer {
        background-color: white; /* Fondo blanco */
        border-top: none; /* Sin borde superior */
    }

    .nav-link {
        text-align: center; /* Centrar el enlace */
    }
</style>
<div class="container">
    <div class="row">
<h5>Formularios AN</h5>
<div id="emailHelp" class="form-text">
    Formularios AN para reportar la participación indirecta a la autoridad
</div>

    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-3 mb-4">
            <div class="card">
                <div class="card-header">
                    Apéndice AN 1.1
                </div>
                <br />
                <img src="../images/BO_imagenes/contrato.png" class="resize-image" />

                <div class="card-body">
                    <p class="card-text">Formulario para reportar al Administrador la celebración de contratos de Servicios de PI</p>



                </div>
                <div class="card-footer">
                    <a asp-controller="BO_Formulario" asp-action="BO_Formulario" asp-route-opcion="1" class="nav-link">Ingresar...</a>
                </div>
            </div>
        </div>
        <div class="col-3 mb-4">
            <div class="card">
                <div class="card-header">

                    Apéndice AN 1.2
                </div> <br />
                <img src="../images/BO_imagenes/nuevos.png" class="resize-image" />
                <div class="card-body">
                    <p class="card-text">Formulario para reportar al Administrador la información de los conjuntos CLABE que hayan sido asignados bajo el esquema de PI</p>

                </div>
                <div class="card-footer">
                    <a asp-controller="BO_Formulario" asp-action="BO_Formulario" asp-route-opcion="2" class="nav-link">Ingresar...</a>
                </div>
            </div>
        </div>
        <div class="col-3 mb-4">
            <div class="card">
                <div class="card-header">

                    Apéndice AN 1.3
                </div> <br />
                <img src="../images/BO_imagenes/bajas.png" class="resize-image" />
                <div class="card-body">
                    <p class="card-text">Formulario para reportar al Administrador la información de los conjuntos CLABE que hayan sido dados de baja en el esquema de PI</p>

                </div>
                <div class="card-footer">
                    <a asp-controller="BO_Formulario" asp-action="BO_Formulario" asp-route-opcion="3" class="nav-link">Ingresar...</a>
                </div>
            </div>
        </div>
        <div class="col-3 mb-4">

            <!--
            <div class="card">
                <div class="card-header">

                    <h5 class="card-title">Apéndice AN 1.6</h5>
                </div> <br />
                <img src="../images/BO_imagenes/limites.png" class="resize-image" />
                <div class="card-body">
                    <p class="card-text">Formulario de reporte al Administrador sobre los limites operativos establecidos en la 9a. Bis 9</p>

                </div>
                <div class="card-footer">
                    <a asp-controller="BO_Formulario" asp-action="BO_Formulario" asp-route-opcion="6" class="nav-link">Ingresar...</a>
                </div>
            </div>-->
        </div>
    </div>
</div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>