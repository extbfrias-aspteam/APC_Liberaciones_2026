@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
  
  
    <script>
        $(document).ready(function () {
            var opcionSeleccionada = '@ViewBag.OpcionSeleccionada';
            $('#1, #2, #3, #6').hide();
            $('#' + opcionSeleccionada).show();
        });
    </script>


        
    <!-- formulario uno   -->
    <script type="text/javascript">
        $(document).ready(function () {
            // Inicializar DataTable
            var table = $('#exampleFor1').DataTable({
                language: {
                    "url": "../lib/Spanish.json"
                },
                columns: [
                    { data: "idParticipantes" },
                    { data: "clabe" },
                    { data: "razonSocial" },
                    { data: "estatus" },
                    {
                        data: null,
                        render: function (data, type, row) {
                            var generateWordUrl = '/BO_Formulario/GenerateWord?idParticipante=' + row.idParticipantes;
                            var generaPdfUrl = '/BO_Formulario/GeneraPdfFormulario1?idParticipante=' + row.idParticipantes;

                            // Inicializar las variables con los botones
                            var lapizButton = '<i type="button" id="lapiz" class="bi bi-pencil btn-modal" data-id="' + row.idParticipantes + '" data-descripcion="' + row.razonSocial + '" style="margin-right: 10px;"></i>';
                            var wordButton = '<a id="word" href="' + generateWordUrl + '"><img src="../images/BO_imagenes/word.png" style="width:12%; margin-right: 10px;"></a>';
                            var pdfButton = '<a id="pdf" href="' + generaPdfUrl + '"><img src="../images/BO_imagenes/pdf.png" style="width:12%;"></a>';

                            // Ocultar botones basados en el estatus
                            if (row.estatus === "Validado") {
                                // Si está validado, mostrar solo los botones Word y PDF
                                return wordButton + pdfButton;
                            } else {
                                // Si no está validado, mostrar solo el botón de edición (lapiz)
                                return lapizButton;
                            }
                        }
                    }
                ]
            });

       
            // Al presionar el botón de consulta
            $('#btnConsultarFiltro').click(function () {
                var fechaInicio = $('#fechaInicio').val();
                var fechaFinal = $('#fechaFinal').val();

                // Mostrar spinner
                $('#spin').removeClass('d-none');

                // Validar que las fechas no estén vacías
                if (!fechaInicio || !fechaFinal) {
                    swal({
                        title: "Fechas requeridas",
                        text: "Por favor, selecciona ambas fechas.",
                        icon: "warning",
                        button: "Aceptar"
                    });
                    $('#spin').addClass('d-none');
                    return;
                }

                // Realizar la solicitud AJAX al controlador
                $.ajax({
                    url: '/BO_Formulario/parIndirectosFiltro',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        FechaInicio: fechaInicio,
                        FechaActual: fechaFinal
                    }),
                    success: function (response) {
                        // Limpiar la tabla antes de llenarla
                        table.clear().draw();

                        // Verificar si la respuesta tiene datos
                        if (response.data && response.data.length > 0) {
                            // Llenar la tabla con los nuevos datos
                            table.rows.add(response.data).draw();
                        } else {
                            swal({
                                title: "Sin registros",
                                text: "No se encontraron registros para las fechas seleccionadas.",
                                icon: "info",
                                button: "Aceptar"
                            });
                        }

                        // Ocultar spinner
                        $('#spin').addClass('d-none');
                    },
                    error: function (xhr, status, error) {
                        console.error('Error en la solicitud:', error);
                        swal({
                            title: "Error",
                            text: "Ocurrió un error al consultar los datos.",
                            icon: "error",
                            button: "Aceptar"
                        });

                        // Ocultar spinner
                        $('#spin').addClass('d-none');
                    }
                });
            });

        });
        $(document).on('click', '.btn-modal', function () {
            var participanteId = $(this).data('id');
            $('#participanteId').val(participanteId);

            $.ajax({
                url: '/BO_Formulario/ParticipanteId',
                method: 'POST',
                data: { id: participanteId },
                success: function (response) {
                    if (response.data && response.data.length > 0) {

                        var participante = response.data[0];

                        // Asignar valores a los campos del formulario
                        $('#clabe').val(participante.clabe);
                        $('#razonSocial').val(participante.razonSocial);
                        $('#rfc').val(participante.rfc);

                        // Formatear 'fechaCelebracion' a mm/dd/yyyy
                        if (participante.fechaCelebracion) {
                            let fechaPartes = participante.fechaCelebracion.split(" ")[0]; // "YYYY-MM-DD"
                            let [anio, mes, dia] = fechaPartes.split("-");
                            $('#fechaCelebracion').val(`${mes}/${dia}/${anio}`); // Formato mm/dd/yyyy
                        }

                        // Formatear 'inicioServicio' a mm/dd/yyyy
                        if (participante.inicioServicio) {
                            let fechaPartes = participante.inicioServicio.split(" ")[0]; // "YYYY-MM-DD"
                            let [anio, mes, dia] = fechaPartes.split("-");
                            $('#inicioServicio').val(`${mes}/${dia}/${anio}`);
                        }

                        // Formatear 'terminoServicio' a mm/dd/yyyy
                        if (participante.terminoServicio) {
                            let fechaPartes = participante.terminoServicio.split(" ")[0]; // "YYYY-MM-DD"
                            let [anio, mes, dia] = fechaPartes.split("-");
                            $('#terminoServicio').val(`${mes}/${dia}/${anio}`);
                        }

                        // Obtener solo los días de 'duracionContrato'
                        if (participante.duracionContrato) {
                            let dias = participante.duracionContrato.split(" ")[0]; // Extrae solo el número de días
                            $('#duracionContrato').val(dias);
                        }

                        $('#tercia').val(participante.tercia);
                        $('#nomComerciaMarca').val(participante.nomComerciaMarca);
                        $('#proveedor').val(participante.proveedor);

                        // Mostrar el modal
                        $('#participanteModal').modal('show');
                    } else {
                        alert("No se encontraron datos para este participante.");
                    }
                },
                error: function () {
                    alert("Ocurrió un error al obtener los datos del participante.");
                }
            });
        });



        $(document).on('click', '#confirmar', function () {
            var participanteId = $('#participanteId').val();

            $.ajax({
                url: '/BO_Formulario/ActualizarId',
                method: 'POST',
                data: { id: participanteId },
                success: function (response) {
                    if (response.success) {
                        swal({
                            title: "Éxito",
                            text: response.message,
                            type: "success",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: true
                        }, function () {
                            // Cerrar el modal después de confirmar el mensaje de éxito
                            $('#participanteModal').modal('hide');

                            // Ejecutar la acción del botón btnConsultarFiltro para actualizar la tabla
                            $('#btnConsultarFiltro').click();
                        });
                    } else {
                        swal("Error", response.message, "error");
                    }
                },
                error: function () {
                    swal("Error", "Ocurrió un error al realizar la actualización.", "error");
                }
            });
        });



    
    
    </script>
    <!-- formulario fin uno   -->
    <!-- formulario dos   -->
