@{
    ViewData["Title"] = "BO_OnePages";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Estilos {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/select/1.3.1/css/select.dataTables.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <style>
        .dt-button {
            display: none !important;
            /* Oculta el botón de exportación */
        }
    </style>
}

<h5>One Pages Participante SPEI</h5>
<div class="form-text">Esta vista permitirá realizar consulta y generación de los Estados de Cuenta por participante.</div>

<div class="card-box">
    <div class="card-body">
        <form id="formulario">
            <div class="row g-3">
                <div class="col-sm-5">
                    <select class="form-select" name="participantes" id="participantes" disabled>
                        <option value="-1" selected disabled>Seleccione al participante...</option>
                    </select>
                </div>
                <div class="col-sm-3">
                    <button type="submit" class="btn btn-success rounded-1" id="consultarOnePages" disabled>
                        <span id="spnConsultarOnePages" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Consultar One Pages
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="mt-2 align-self-end d-flex justify-content-end">
    <button type="button" class="bg-warning border-0 p-2" data-bs-toggle="modal" data-bs-target="#modalConceptos">
        Conceptos Comerciales
    </button>
</div>
<input type="hidden" id="idPblu" value="" />

<div class="p-4 bg-white shadow-sm mb-5 rounded table-responsive">
    <table id="tblOnePages" class="table table-striped table-borderless" style="width:100%">
        <thead>
            <tr>
                <th>Participante</th>
                <th>Nombre Comercial</th>
                <th>Razón Social</th>
                <th>Clabe</th>
                <th>Estatus</th>
                <th>Acciones</th>
            </tr>
        </thead>
    </table>
</div>

<!-- MODAL CONCEPTOS COMERCIALES-->
<div class="modal fade" tabindex="-1" id="modalConceptos">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Conceptos Comerciales</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="mb-5">
                    <div class="d-flex gap-3 mb-2">
                        <div class="mb-3 w-25">
                            <input type="text" autocomplete="off" class="form-control" id="claveConcepto" placeholder="Clave" maxlength="10" />
                            <input type="hidden" id="idConcepto" value="" />
                            <div class="form-text">Clave</div>
                        </div>
                        <div class="mb-3 w-100">
                            <input type="text" autocomplete="off" class="form-control" id="nombreConcepto" placeholder="Concepto" maxlength="50" />
                            <div class="form-text">Concepto</div>
                        </div>
                        <div class="mb-3 w-75">
                            <select class="form-select" id="activoConcepto">
                                <option disabled selected>Seleccione el estatus...</option>
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                            <div class="form-text">Estatus</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary rounded-1" id="btnNuevoConcepto" onclick="guardarConcepto()">
                        <i class="fa-solid fa-plus"></i>&nbsp;Nuevo&nbsp;<span id="spnNuevoConcepto" class="spinner-border spinner-border-sm visually-hidden"></span>
                    </button>
                    <button type="button" class="btn btn-secondary rounded-1 visually-hidden" id="btnLimpiarConcepto" onclick="limpiarConceptos()">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-success rounded-1 visually-hidden" id="btnActualizarConcepto" onclick="guardarConcepto()">
                        Actualizar&nbsp;<span id="spnActualizarConcepto" class="spinner-border spinner-border-sm visually-hidden"></span>
                    </button>
                </form>
                <!-- TABLA CONCEPTOS COMERCIALES-->
                <table id="tblConceptos" class="table table-striped table-borderless" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Clave</th>
                            <th>Concepto</th>
                            <th>Estatus</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- MODAL ACTUALIZAR INFORMACIÓN B2B-->
<div class="modal fade" tabindex="-1" id="modalInformacionB2B">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Actualizar Información B2B</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="row g-4 row-gap-1" id="formInformacionB2B">
                    <div class="col-md-3">
                        <input type="text" class="form-control" id="nombreComercialB2B" placeholder="Nombre Comercial" disabled />
                        <div class="form-text">Nombre Comercial</div>
                    </div>
                    <div class="col-md-9">
                        <input type="text" class="form-control" id="razonSocialB2B" placeholder="Razón Social" disabled />
                        <div class="form-text">Razón Social</div>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" id="rfcB2B" placeholder="RFC" disabled />
                        <div class="form-text">RFC</div>
                    </div>
                    <div class="col-md-9">
                        <input type="text" class="form-control" id="direccionFiscalB2B" placeholder="Dirección Fiscal" disabled />
                        <div class="form-text">Dirección Fiscal</div>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" id="idiomaB2B" placeholder="Idioma" />
                        <div class="form-text">Idioma</div>
                        <!--<select class="form-select" id="idiomaB2B" maxlength="20">
                            <option selected>Seleccione Idioma</option>
                        </select>-->
                    </div>
                    <div class="col-md-9">
                        <input type="text" class="form-control" id="horarioDeAtencionB2B" placeholder="Horario de Atención" maxlength="50" />
                        <div class="form-text">Horario de Atención</div>
                    </div>
                    <div class="col-md-3 col-md-3 d-flex align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="traductorB2B" />
                            <label class="form-check-label" for="traductor"> Traductor </label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" id="numeroDeClienteB2B" placeholder="Número de Cliente" disabled />
                        <div class="form-text">Número de Cliente</div>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" id="numeroDeCuentaB2B" placeholder="Número de Cuenta" disabled />
                        <div class="form-text">Número de Cuenta</div>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control" id="cuentaClabeB2B" placeholder="Cuenta CLABE" disabled />
                        <div class="form-text">Cuenta CLABE</div>
                    </div>
                    <div class="col-md-6">
                        <input type="text" class="form-control" id="tipoDeClienteB2B" placeholder="Tipo Cliente" disabled />
                        <div class="form-text">Tipo Cliente</div>
                    </div>
                    <div class="col-md-6">
                        <input type="text" class="form-control" id="estatusB2B" placeholder="Estado" disabled />
                        <div class="form-text">Estado</div>
                    </div>
                    <div class="col-md-12">
                        <input type="text" class="form-control" id="urlB2B" placeholder="URL Modelo de Negocio" maxlength="250" />
                        <div class="form-text">URL Modelo de Negocio</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <!--<button type="button" class="btn btn-secondary rounded-1" data-bs-dismiss="modal" id="btnCancelarB2B" onclick="cancelarB2B()">
                    Cancelar
                </button>-->
                <button type="button" class="btn btn-primary rounded-1" id="btnActualizarB2B" onclick="guardarInformacionB2B()">
                    Actualizar&nbsp;<span class="spinner-border spinner-border-sm" id="spnActualizarB2B" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>
<!-- MODAL INFORMACIÓN DEL CONTRATO B2B -->
<div class="modal fade" tabindex="-1" id="modalInformacionContrato">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Información del Contrato B2B</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row row-gap-4 form-group">
                    <div class="col-md-3">
                        <div class="input-group date" id="datepicker" data-provide="datepicker">
                            <input type="text" class="form-control" placeholder="mm/dd/yyyy" id="fechaEmision" disabled />
                            <span class="input-group-append">
                                <span class="input-group-text bg-white h-100 rounded-0">
                                    <i class="fa fa-calendar form-control-icon"></i>
                                </span>
                            </span>
                        </div>
                        <div class="form-text">Fecha de emisión</div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group date" id="datepicker" data-provide="datepicker">
                            <input type="date" class="form-control" placeholder="mm/dd/yyyy" id="fechaTermino" />
                            <span class="input-group-append">
                                <span class="input-group-text bg-white h-100 rounded-0">
                                    <i class="fa fa-calendar form-control-icon"></i>
                                </span>
                            </span>
                        </div>
                        <div class="form-text" id="addon2">Fecha de término</div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group date" id="datepicker" data-provide="datepicker">
                            <input type="date" class="form-control" placeholder="mm/dd/yyyy" id="fechaAnexos" />
                            <span class="input-group-append">
                                <span class="input-group-text bg-white h-100 rounded-0">
                                    <i class="fa fa-calendar form-control-icon"></i>
                                </span>
                            </span>
                        </div>
                        <div class="form-text" id="addon3">Fecha de anexos/Addendas</div>
                    </div>
                    <div class="col-md-3">
                        <div class="input-group date" id="datepicker" data-provide="datepicker">
                            <input type="date" class="form-control" placeholder="mm/dd/yyyy" id="fechaConvenio" />
                            <span class="input-group-append">
                                <span class="input-group-text bg-white h-100 rounded-0">
                                    <i class="fa fa-calendar form-control-icon"></i>
                                </span>
                            </span>
                        </div>
                        <div class="form-text" id="addon4">Fecha de convenio modificatorio</div>
                    </div>
                    <div class="col-md-12 mt-4">
                        <select id="productoContratado" class="form-select">
                            <option disabled selected>Seleccione el producto contratado...</option>
                        </select>
                        <div class="form-text">Producto Contratado</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnActualizarContratoB2B" onclick="guardarContratoB2B()">
                    Actualizar&nbsp;<span class="spinner-border spinner-border-sm" id="spnActualizarContratoB2B" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>
<!-- MODAL CONDICIONES COMERCIALES-->
<div class="modal fade" tabindex="-1" id="modalCondiciones">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Condiciones Comerciales</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row row-gap-5 mb-5 form-group">
                    <input type="hidden" id="idCondicion" value="" />
                    <div class="mb-4 col-md-5">
                        <select class="form-select" id="conceptosCondicion" disabled>
                            <option selected>Seleccione el concepto...</option>
                        </select>
                        <div class="form-text">Concepto</div>
                    </div>
                    <div class="col-md-3">
                        <input type="number" autocomplete="off" class="form-control" id="precio" placeholder="Precio Unitario" maxlength="10" setp="0.01" />
                        <div class="form-text">Precio Unitario</div>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-success rounded-1" id="btnAgregarCondicion" onclick="guardarCondicion()">
                            Agregar concepto&nbsp;<span id="spnAgregarCondicion" class="spinner-border spinner-border-sm visually-hidden"></span>
                        </button>
                        <button type="button" class="btn btn-success rounded-1 visually-hidden" id="btnActualizarCondicion" onclick="guardarCondicion()">
                            Actualizar concepto&nbsp;<span id="spnActualizarCondicion" class="spinner-border spinner-border-sm visually-hidden"></span>
                        </button>
                        <button type="button" class="btn btn-secondary rounded-1 visually-hidden" id="btnLimpiarCondicion" onclick="limpiarCondicion()">
                            Limpiar
                        </button>
                    </div>
                    <div class="col-md-5">
                        <select class="form-select" id="cobrosCondicion" disabled>
                            <option selected>Seleccione el tipo de cobro...</option>
                        </select>
                        <div class="form-text">Tipo de cobro</div>
                    </div>
                    <div class="col-md-3">
                        <input type="number" autocomplete="off" class="form-control" id="meses" placeholder="Meses a diferir" maxlength="3" setp="1" />
                        <div class="form-text">Meses a diferir</div>
                    </div>
                </div>
                <!-- TABLA CONDICIONES COMERCIALES -->
                <table class="table table-striped table-borderless mb-4" id="tblCondiciones" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Clave</th>
                            <th>Concepto</th>
                            <th>Tipo Cobro</th>
                            <th>Precio Unitario</th>
                            <th>Meses a Diferir</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <!-- SECCIÓN TARIFA SPEI OUT -->
                <h5 class="modal-title mb-1">Tarifa Spei Out</h5>
                <div class="row row-gap-5 mb-3 form-group">
                    <input type="hidden" id="idTarifa1" value="" />
                    <div class="col-md-3">
                        <input type="number" autocomplete="off" class="form-control" id="de1" placeholder="De" maxlength="10" setp="1" />
                        <div class="form-text">Min. operaciones</div>
                    </div>
                    <div class="col-md-3">
                        <input type="number" autocomplete="off" class="form-control" id="a1" placeholder="A" maxlength="10" setp="1" />
                        <div class="form-text">Máx. operaciones</div>
                    </div>
                    <div class="col-md-2">
                        <input type="number" autocomplete="off" class="form-control" id="precio1" placeholder="Precio Unitario" maxlength="10" step="0.01" />
                        <div class="form-text">Precio Unitario</div>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-success rounded-1" id="btnAgregarParametro1" onclick="guardarParametro(1)">
                            Agregar parámetro&nbsp;<span id="spnAgregarParametro1" class="spinner-border spinner-border-sm visually-hidden"></span>
                        </button>
                        <button type="button" class="btn btn-success rounded-1 visually-hidden" id="btnActualizarParametro1" onclick="guardarParametro(1)">
                            Actualizar parámetro&nbsp;<span id="spnActualizarParametro1" class="spinner-border spinner-border-sm visually-hidden"></span>
                        </button>
                        <button type="button" class="btn btn-secondary rounded-1 visually-hidden" id="btnLimpiarParametro1" onclick="limpiarParametro(1)">
                            Limpiar
                        </button>
                    </div>
                </div>
                <!-- TABLA TARIFA SPEI OUT -->
                <table class="table table-striped table-borderless mb-4" id="tblTarifas1">
                    <thead>
                        <tr>
                            <th>De</th>
                            <th>A</th>
                            <th>Precio Unitario</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <!-- SECCIÓN TARIFA SPEI IN -->
                <h5 class="modal-title mb-1">Tarifa Spei In</h5>
                <div class="row row-gap-5 mb-3 form-group">
                    <input type="hidden" id="idTarifa2" value="" />
                    <div class="col-md-3">
                        <input type="number" autocomplete="off" class="form-control" id="de2" placeholder="De" maxlength="10" setp="1" />
                        <div class="form-text">Min. operaciones</div>
                    </div>
                    <div class="col-md-3">
                        <input type="number" autocomplete="off" class="form-control" id="a2" placeholder="A" maxlength="10" setp="1" />
                        <div class="form-text">Máx. operaciones</div>
                    </div>
                    <div class="col-md-2">
                        <input type="number" autocomplete="off" class="form-control" id="precio2" placeholder="Precio Unitario" maxlength="10" step="0.01" />
                        <div class="form-text">Precio Unitario</div>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-success rounded-1" id="btnAgregarParametro2" onclick="guardarParametro(2)">
                            Agregar parámetro&nbsp;<span id="spnAgregarParametro2" class="spinner-border spinner-border-sm visually-hidden"></span>
                        </button>
                        <button type="button" class="btn btn-success rounded-1 visually-hidden" id="btnActualizarParametro2" onclick="guardarParametro(2)">
                            Actualizar parámetro&nbsp;<span id="spnActualizarParametro2" class="spinner-border spinner-border-sm visually-hidden"></span>
                        </button>
                        <button type="button" class="btn btn-secondary rounded-1 visually-hidden" id="btnLimpiarParametro2" onclick="limpiarParametro(2)">
                            Limpiar
                        </button>
                    </div>
                </div>
                <!-- TABLA TARIFA SPEI IN -->
                <table class="table table-striped table-borderless mb-4" id="tblTarifas2">
                    <thead>
                        <tr>
                            <th>De</th>
                            <th>A</th>
                            <th>Precio Unitario</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- MODAL CONTACTOS-->
<div class="modal fade" tabindex="-1" id="modalContactos">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Contactos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="idContacto" value="">
                <form class="mb-5">
                    <div class="d-flex gap-3 mb-2">
                        <div class="mb-3 w-50">
                            <input type="text" autocomplete="off" class="form-control" id="nombreContactos" placeholder="Nombre" maxlength="50" />
                            <div class="form-text">Nombre</div>
                        </div>
                        <div class="mb-3 w-50">
                            <input type="text" autocomplete="off" class="form-control" id="areaContactos" placeholder="Área" maxlength="50" />
                            <div class="form-text">Área</div>
                        </div>
                        <div class="mb-3 w-50">
                            <input type="text" autocomplete="off" class="form-control" id="puestoContactos" placeholder="Puesto" maxlength="50" />
                            <div class="form-text">Puesto</div>
                        </div>
                    </div>
                    <div class="d-flex gap-3 mb-2">
                        <div class="mb-3 w-50">
                            <input type="tel" autocomplete="off" class="form-control" id="telefonoContactos" placeholder="Teléfono" maxlength="10" />
                            <div class="form-text">Teléfono</div>
                        </div>
                        <div class="mb-3 w-50">
                            <input type="tel" autocomplete="off" class="form-control" id="whatsappContactos" placeholder="WhatsApp" maxlength="10" />
                            <div class="form-text">WhatsApp</div>
                        </div>
                        <div class="mb-3 w-50">
                            <input type="email" autocomplete="off" class="form-control" id="correoContactos" placeholder="Correo" maxlength="250" />
                            <div class="form-text">Correo</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary rounded-1" id="btnAgregarContacto" onclick="guardarContacto()">
                        <i class="fa-solid fa-plus"></i>&nbsp;Nuevo<span id="spnAgregarContacto" class="spinner-border spinner-border-sm visually-hidden"></span>
                    </button>
                    <button type="button" class="btn btn-success rounded-1 visually-hidden" id="btnActualizarContacto" onclick="guardarContacto()">
                        Actualizar&nbsp;<span id="spnActualizarContacto" class="spinner-border spinner-border-sm visually-hidden"></span>

                    </button>
                    <button type="button" class="btn btn-secondary rounded-1 visually-hidden" id="btnLimpiarContacto" onclick="limpiarContacto()">
                        Limpiar
                    </button>
                </form>
                <!-- TABLA CONTACTOS-->
                <table id="tblContactos" class="table table-striped table-borderless" style="width:100%">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Área</th>
                            <th>Puesto</th>
                            <th>Teléfono</th>
                            <th>WhatsApp</th>
                            <th>Correo</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/select/1.3.1/js/dataTables.select.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.1.0/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.1.0/js/buttons.html5.min.js"></script>

<script type="text/javascript">
    var js = jQuery.noConflict(true);
    let modalDataModified = false; // Variable para rastrear si se modificó algo en el modal
    let tblConceptos, tblOnePages, tblCondiciones, tblContactos, tblTarifas1, tblTarifas2;
    let modalConceptos, modalInformacionB2B, modalInformacionContrato, modalCondiciones, modalContactos;

    js(document).ready(function () {
        //#region Tablas
        tblOnePages = js('#tblOnePages').DataTable({
            destroy: true,
            responsive: true,
            scrollX: true,
            ordering: true,
            paging: true,
            language: {
                "url": "../lib/Spanish.json"
            },
            columns: [
                { data: 'idPblu' },
                {
                    data: 'nombreComercial',
                    render: function (data, type, row) {
                        return data ? data : "N/A";
                    }
                },
                { data: 'razonSocial' ,
