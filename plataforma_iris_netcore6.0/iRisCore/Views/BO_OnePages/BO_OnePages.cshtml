    function guardarCondicion() {
        const inputs = [
            meses,
            precio,
        ];
        const selects = [
            {
                element: conceptosCondicion,
                defaultText: "Seleccione el concepto..."
            },
            {
                element: cobrosCondicion,
                defaultText: "Seleccione el tipo de cobro..."
            },
        ];

        if (validarCamposGenerico(inputs, selects, null)) {
            btnAgregarCondicion.disabled = btnActualizarCondicion.disabled = btnLimpiarCondicion.disabled = true;
            spnAgregarCondicion.classList.remove("visually-hidden");
            spnActualizarCondicion.classList.remove("visually-hidden");

            var data = new Object();
            data.id_condicion_comercial = idCondicion.value;
            data.id_concepto_comercial = conceptosCondicion.value;
            data.idPblu = idPblu.value;
            data.id_tipo_cobro = cobrosCondicion.value;
            data.precio_unitario = precio.value;
            data.meses = meses.value;
            data.activo = true;
            data.usuario = "";

            ajaxCall("GET", "SetCondicion", "BO_OnePages", data, (data) => {
                successSave();

                btnAgregarCondicion.disabled = btnActualizarCondicion.disabled = btnLimpiarCondicion.disabled = false;
                spnAgregarCondicion.classList.add("visually-hidden");
                spnActualizarCondicion.classList.add("visually-hidden");
                limpiarCondicion();
                cargarTblCondiciones(idPblu.value);
            });
        }
    }

    function limpiarCondicion() {
        idCondicion.value = "";
        conceptosCondicion.selectedIndex = 0;
        cobrosCondicion.selectedIndex = 0;
        meses.value = "";
        precio.value = "";

        btnAgregarCondicion.classList.remove('visually-hidden');
        btnActualizarCondicion.classList.add('visually-hidden');
        btnLimpiarCondicion.classList.add('visually-hidden');
        spnAgregarCondicion.classList.add("visually-hidden");
        spnActualizarCondicion.classList.add("visually-hidden");
    }

    function editarCondicion(id) {
        limpiarCondicion();
        let data = tblCondiciones.rows().data().toArray();
        let registro = data.find(item => item.id_condicion_comercial == id);

        if (registro) {
            idCondicion.value = id;
            conceptosCondicion.value = registro.id_concepto_comercial.id_concepto_comercial;
            cobrosCondicion.value = registro.id_tipo_cobro.id_tipo_cobro;
            meses.value = registro.meses;
            precio.value = registro.precio_unitario;

            btnAgregarCondicion.classList.add('visually-hidden');
            btnActualizarCondicion.classList.remove('visually-hidden');
            btnLimpiarCondicion.classList.remove('visually-hidden');

        } else {
            alert('No se encontró la condición.');
        }
    }

    function guardarParametro(tipoTarifa) {
        const inputs = [
            document.getElementById('de' + tipoTarifa),
            document.getElementById('a' + tipoTarifa),
            document.getElementById('precio' + tipoTarifa)
        ];
        const selects = [];

        if (validarCamposGenerico(inputs, selects, null)) {
            var data = new Object();
            data.id_tarifa_comercial = document.getElementById('idTarifa' + tipoTarifa).value;
            data.idPblu = idPblu.value;
            data.id_tipo_tarifa_comercial = tipoTarifa;
            data.min_operaciones = document.getElementById('de' + tipoTarifa).value;
            data.max_operaciones = document.getElementById('a' + tipoTarifa).value;
            data.precio_unitario = document.getElementById('precio' + tipoTarifa).value;
            data.activo = true;
            data.usuario = "";

            const tblTarifa = tipoTarifa == 1 ? tblTarifas1 : tblTarifas2;

            if (seSolapaParametro(data, tblTarifa.rows().data().toArray())) {
                let mensaje = "El parámetro se solapa con un parámetro existente.";
                const min = Number(data.min_operaciones);
                const max = Number(data.max_operaciones);

                if (min > max)
                    mensaje = "El máximo de operaciones no puede ser menor al mínimo de operacines."

                swal({
                    type: 'error',
                    title: 'Error',
                    text: mensaje,
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: "#DD6B55",
                });
            }
            else {
                document.getElementById('btnAgregarParametro' + tipoTarifa).setAttribute("disabled", true);
                document.getElementById('btnActualizarParametro' + tipoTarifa).setAttribute("disabled", true);
                document.getElementById('spnAgregarParametro' + tipoTarifa).classList.remove("visually-hidden");
                document.getElementById('spnActualizarParametro' + tipoTarifa).classList.remove("visually-hidden");

                ajaxCall("GET", "SetTarifa", "BO_OnePages", data, (data) => {
                    successSave();

                    cargarTblTarifas(idPblu.value, tipoTarifa, tblTarifa);
                    limpiarParametro(tipoTarifa);
                });
            }
        }
    }

    function limpiarParametro(tipoTarifa) {
        document.getElementById('idTarifa' + tipoTarifa).value = '';
        document.getElementById('de' + tipoTarifa).value = '';
        document.getElementById('a' + tipoTarifa).value = '';
        document.getElementById('precio' + tipoTarifa).value = '';
        document.getElementById('btnActualizarParametro' + tipoTarifa).classList.add('visually-hidden');
        document.getElementById('btnAgregarParametro' + tipoTarifa).classList.remove('visually-hidden');
        document.getElementById('btnLimpiarParametro' + tipoTarifa).classList.add('visually-hidden');
        document.getElementById('spnAgregarParametro' + tipoTarifa).classList.add("visually-hidden");
        document.getElementById('spnActualizarParametro' + tipoTarifa).classList.add("visually-hidden");
        document.getElementById('btnAgregarParametro' + tipoTarifa).removeAttribute("disabled");
        document.getElementById('btnActualizarParametro' + tipoTarifa).removeAttribute("disabled");
    }

    function editarParametro(tipoTarifa, idTarifaComercial) {
        limpiarParametro(tipoTarifa);
        let data = js('#tblTarifas' + tipoTarifa).DataTable().rows().data().toArray();
        let registro = data.find(item => item.id_tarifa_comercial == idTarifaComercial);

        if (registro) {
            document.getElementById('idTarifa' + tipoTarifa).value = registro.id_tarifa_comercial;
            document.getElementById('de' + tipoTarifa).value = registro.min_operaciones;
            document.getElementById('a' + tipoTarifa).value = registro.max_operaciones;
            document.getElementById('precio' + tipoTarifa).value = registro.precio_unitario;

            document.getElementById('btnActualizarParametro' + tipoTarifa).classList.remove('visually-hidden');
            document.getElementById('btnAgregarParametro' + tipoTarifa).classList.add('visually-hidden');
            document.getElementById('btnLimpiarParametro' + tipoTarifa).classList.remove('visually-hidden');
            document.getElementById('spnAgregarParametro' + tipoTarifa).classList.add("visually-hidden");
            document.getElementById('spnActualizarParametro' + tipoTarifa).classList.add("visually-hidden");
        } else {
            alert('No se encontró el parámetro.');
        }
    }

    function seSolapaParametro(nuevo, existentes) {
        // Convertir a número
        const min = Number(nuevo.min_operaciones);
        const max = Number(nuevo.max_operaciones);

        if (min > max)
            return true;

        return existentes.some(param => {
            const minExistente = Number(param.min_operaciones);
            const maxExistente = Number(param.max_operaciones);

            if (nuevo.id_tarifa_comercial.length > 0 && nuevo.id_tarifa_comercial == param.id_tarifa_comercial)
                return false;

            return min <= maxExistente && max >= minExistente;
        });
    }
