        spnActualizarContratoB2B.classList.add("visually-hidden");
    }

    function guardarContratoB2B() {
        const inputs = [
            @* fechaTermino,
            fechaAnexos,
            fechaConvenio, *@
        ];

        const selects = [
            @* {
                element: productoContratado,
                defaultText: "Seleccione el producto contratado..."
            } *@
            ];

        if (validarCamposGenerico(inputs, selects, null)) {
            btnActualizarContratoB2B.disabled = true;
            spnActualizarContratoB2B.classList.remove("visually-hidden");

            var data = new Object();
            data.idPblu = idPblu.value;
            data.fechaTermino = fechaTermino.value;
            data.fechaAddenda = fechaAnexos.value;
            data.fechaConvenio = fechaConvenio.value;
            data.idProductoContratado = productoContratado.selectedIndex != 0 ? productoContratado.value : null;
            data.usuario = "";

            ajaxCall("GET", "SetContratoB2B", "BO_OnePages", data, (data) => {
                successSave();

                btnActualizarContratoB2B.disabled = false;
                spnActualizarContratoB2B.classList.add("visually-hidden");

                cargarTblOnePages(() => {
                    cargarInformacionB2B(idPblu.value);
                });
            });
