    //#region Contactos
    function showModalContactos(event, id) {
        event.preventDefault();
        idPblu.value = id;

        limpiarContacto();
        cargarTblContactos(id)

        modalContactos.show();
    }

    function cargarTblContactos(id) {
        const req = new Object();
        req.idPblu = id;

        ajaxCall("GET", "GetContactos", "BO_OnePages", req, (data) => {
            tblContactos.clear();
            tblContactos.rows.add(data);
            tblContactos.draw();
        });
    }

    function guardarContacto() {
        const inputs = [
            nombreContactos,
            areaContactos,
            puestoContactos,
            telefonoContactos,
            whatsappContactos,
            correoContactos,
        ];
        const selects = [];

        if (validarCamposGenerico(inputs, selects, null)) {
            btnAgregarContacto.disabled = btnActualizarContacto.disabled = btnLimpiarContacto.disabled = true;
            spnAgregarContacto.classList.remove("visually-hidden");
            spnActualizarContacto.classList.remove("visually-hidden");

            var data = new Object();
            data.id_contacto = idContacto.value;
            data.nombre = nombreContactos.value;
            data.area = areaContactos.value;
            data.puesto = puestoContactos.value;
            data.telefono = telefonoContactos.value;
            data.whatsapp = whatsappContactos.value;
            data.correo = correoContactos.value;
            data.idPblu = idPblu.value;
            data.usuario = "";
            data.estatus = true;

            ajaxCall("GET", "SetContacto", "BO_OnePages", data, (data) => {
                btnAgregarContacto.disabled = btnActualizarContacto.disabled = btnLimpiarContacto.disabled = false;
                spnAgregarContacto.classList.add("visually-hidden");
                spnActualizarContacto.classList.add("visually-hidden");
                limpiarContacto();
                cargarTblContactos(idPblu.value);
            });
        }
    }

    function limpiarContacto() {
        idContacto.value = "";
        nombreContactos.value = "";
        areaContactos.value = "";
        puestoContactos.value = "";
        telefonoContactos.value = "";
        whatsappContactos.value = "";
        correoContactos.value = "";
        btnActualizarContacto.classList.add('visually-hidden');
        btnAgregarContacto.classList.remove('visually-hidden');
        btnLimpiarContacto.classList.add('visually-hidden');
    }

    function editarContactos(id) {
        limpiarContacto();
        let data = tblContactos.rows().data().toArray();
        let registro = data.find(item => item.id_contacto == id);

        if (registro) {
            idContacto.value = registro.id_contacto
            nombreContactos.value = registro.nombre;
            areaContactos.value = registro.area;
            puestoContactos.value = registro.puesto;
            telefonoContactos.value = registro.telefono;
            whatsappContactos.value = registro.whatsapp;
            correoContactos.value = registro.correo;

            btnActualizarContacto.classList.remove('visually-hidden');
            btnAgregarContacto.classList.add('visually-hidden');
            btnLimpiarContacto.classList.remove('visually-hidden');

        } else {
            alert('No se encontró el contacto.');
        }
    }

    //#endregion

    //#region General

    function ajaxCall(type, task, controller, data, successFunction) {
        js.ajax({
            type: type,
            url: '@Url.Action("__TASK__", "__CONTROLLER__")'
                .replace("__TASK__", task)
                .replace("__CONTROLLER__", controller),
            dataType: "json",
            data: data,
            success: function (data) {
                if (data.result.codigo == 1)
                    successFunction(data.result.data);
                else
                    //console.error('Error:', data.result.mensaje);
                    swal({
                        type: 'error',
                        title: 'Error',
                        text: data.result.mensaje,
                        confirmButtonText: 'Aceptar',
                        confirmButtonColor: "#DD6B55",
                    });
            },
            error: function (xhr, status, error) {
                console.error('Error:', error);
            }
        });
    }

    // Función para validar todos los campos vacios
    function validarCamposGenerico(inputs, selects, checkbox = null) {

        // Validación de campos vacíos
        const camposVacios = inputs.length > 0 && inputs.every(input => input.value.trim() == "") && (!!checkbox ? !checkbox.checked : true);

        // Validación de selects con valores por defecto
        const selectsInvalidos = selects.some(select => select.element.options[select.element.selectedIndex].text == select.defaultText);

        // Condición para mostrar el mensaje de advertencia
        if (camposVacios || selectsInvalidos) {
            swal({
                type: 'warning',
                title: 'Formulario vacío',
                text: 'El formulario no puede enviarse con campos vacíos ni con valores predeterminados en las listas desplegables.',
                confirmButtonText: 'Aceptar',
                confirmButtonColor: "#DD6B55",
            });
            return false;
        }
        return true;
    }

    //Función para detectar datos ingresados al formulario y no eliminarlos al refrescar pestaña
    function configurarEventosModales(modalIds) {
        modalIds.forEach(modalId => {
            const modalElement = document.getElementById(modalId);

            if (modalElement) {
                // Detectar cambios en inputs, selects o checkboxes dentro del modal
                modalElement.addEventListener('input', () => {
                    modalDataModified = true;
                });

                // Detectar cierre del modal y resetear la variable
                modalElement.addEventListener('hidden.bs.modal', () => {
                    modalDataModified = false;
                });
            } else {
                console.warn(`El modal con ID "${modalId}" no existe.`);
            }
        });
    }

    function handlerBeforeUnload(event) {
        if (modalDataModified) {
            event.preventDefault();
            event.returnValue = 'Hay cambios sin guardar. ¿Está seguro de que desea salir?';
        }
    }

    const modalIds = [
        'modalConceptos',
        'modalInformacionB2B',
        'modalInformacionContrato',
        'modalCondiciones',
        'modalContactos',
    ];

    configurarEventosModales(modalIds);

    // Interceptar el evento de recarga o cierre del navegador
    window.beforeUnloadHandler = function (event) {
        if (modalDataModified) {
            event.preventDefault();
            event.returnValue = 'Hay cambios sin guardar. ¿Está seguro de que desea salir?';
        }
    };

    window.addEventListener('beforeunload', window.beforeUnloadHandler);

    function successSave() {
        swal({
            type: 'success',
            title: '¡Éxito!',
            text: 'La información se guardó correctamente.',
            confirmButtonText: 'Aceptar',
            confirmButtonColor: "#0B6E4F",
        });
    }
    //#endregion

</script>