    function guardarConcepto() {
        const inputs = [
            claveConcepto,
            nombreConcepto,
        ];
        const selects = [
            {
                element: activoConcepto,
                defaultText: "Seleccione el estatus..."
            },
        ];

        if (validarCamposGenerico(inputs, selects, null)) {
            btnNuevoConcepto.disabled = btnActualizarConcepto.disabled = btnLimpiarConcepto.disabled = true;
            spnNuevoConcepto.classList.remove("visually-hidden");
            spnActualizarConcepto.classList.remove("visually-hidden");

            var data = new Object();
            data.id_concepto_comercial = idConcepto.value;
            data.concepto = nombreConcepto.value;
            data.clave = claveConcepto.value;
            data.activo = activoConcepto.value;

            ajaxCall("GET", "SetConceptos", "BO_OnePages", data, (data) => {
                successSave();

                btnNuevoConcepto.disabled = btnActualizarConcepto.disabled = btnLimpiarConcepto.disabled = false;
                spnNuevoConcepto.classList.add("visually-hidden");
                spnActualizarConcepto.classList.add("visually-hidden");
                limpiarConceptos();
                cargarTblConceptos();
            });
        }
    }

    function limpiarConceptos() {
        idConcepto.value = '';
        claveConcepto.value = '';
        nombreConcepto.value = '';
        activoConcepto.selectedIndex = 0;
        btnNuevoConcepto.classList.remove('visually-hidden');
        btnActualizarConcepto.classList.add('visually-hidden');
        btnLimpiarConcepto.classList.add('visually-hidden');
        spnNuevoConcepto.classList.add('visually-hidden');
        spnActualizarConcepto.classList.add('visually-hidden');
    }

    function editarConcepto(id) {
        limpiarConceptos();
        // Obtener el registro por ID de los datos cargados en la tabla
        let data = tblConceptos.rows().data().toArray();
        let registro = data.find(item => item.id_concepto_comercial == id);

        if (registro) {
            idConcepto.value = id;
            claveConcepto.value = registro.clave;
            nombreConcepto.value = registro.concepto;
            activoConcepto.value = registro.activo;
            btnActualizarConcepto.classList.remove('visually-hidden');
            btnNuevoConcepto.classList.add('visually-hidden');
            btnLimpiarConcepto.classList.remove('visually-hidden');
        } else {
            alert('No se encontró el concepto comercial.');
        }
    }
