        ajaxCall("GET", "GetParticipantes", "BO_OnePages", null, (data) => {
            participantes.innerHTML = "";
            participantes.insertAdjacentHTML("beforeend", '<option value="-1" selected disabled>Seleccione el participante...</option>');
            participantes.disabled = !Array.isArray(data) || data.length === 0;

            if (!Array.isArray(data)) return;

            // Filtrar registros válidos (no null ni undefined)
            let participantesValidos = data.filter(p => p !== null && typeof p === 'object');

            // Ordenar antes de insertar
            participantesValidos.sort((a, b) => {
                const nombreA = (a.razonSocial || a.nombreComercial || "N/A").toLowerCase().trim();
                const nombreB = (b.razonSocial || b.nombreComercial || "N/A").toLowerCase().trim();
                return nombreA.localeCompare(nombreB);
            });

            if (participantesValidos.length > 0) {
                let option = document.createElement("option");
                option.value = 0;
                option.textContent = "Todos";
                participantes.appendChild(option);
            }

            // Insertar opciones con "N/A" si no hay nombre
            participantesValidos.forEach((udn) => {
                let option = document.createElement("option");
                option.value = udn.idPblu ?? ""; // por si acaso
                let texto = udn.razonSocial?.trim() || udn.nombreComercial?.trim() || "N/A";
                option.textContent = texto;
                participantes.appendChild(option);
            });
        });

