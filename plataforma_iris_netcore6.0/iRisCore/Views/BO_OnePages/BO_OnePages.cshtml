    function cargarContratoB2B(id) {
        let data = tblOnePages.rows().data().toArray();
        let registro = data.find(item => item.idPblu == id);
        if (registro) {
            fechaEmision.value = registro.fechadeEmision;
            fechaTermino.value = registro.fechadeTermino;
            fechaAnexos.value = registro.fechadeAnexosAdendas;
            fechaConvenio.value = registro.fechaconveniomodificatiorio;
            if (registro.idProductoContratado)
                productoContratado.value = registro.idProductoContratado;
            else productoContratado.selectedIndex = 0;
        } else {
            alert("No se encontró el registro.");
        }
    }

    function limpiarContratoB2B() {
        fechaTermino.value = "";
        fechaAnexos.value = "";
