
@{
    ViewData["Title"] = "Reenvío del Código de Seguridad Personal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h5>Reenvío del Código de Seguridad Personal</h5>


<div class="card-box">
    <div class="card-body">
        <form class="" id="Formulario">

            <div class="row g-3">

                <div class="col-sm-4">
                    <input class="form-control" type="text" name="numeroTelefonico" id="numeroTelefonico" placeholder="Número Telefónico" maxlength="10" aria-label="default input example">
                </div>
                <div class="col-sm-4">
                    <button type="submit" id="ExecuteRequest" class="btn btn-success" disabled>
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">

    var js = jQuery.noConflict(true);

    js(document).ready(function () {

        js(document).on('click', '.confirm', function () {
            var myH2 = document.getElementsByTagName('h2')[0].innerHTML;
            if (myH2 == 'Exito') {
                js("#Formulario")[0].reset();
                js("#ExecuteRequest").attr('disabled', true);
            }
        });

        var tel = document.getElementById("numeroTelefonico");
        tel.addEventListener("input", function () {
            if (tel.value.length == 10) {
                js("#ExecuteRequest").attr('disabled', false);
            } else {
                js("#ExecuteRequest").attr('disabled', true);
            }
        });

        js('#ExecuteRequest').on("click", function (event) {
            event.preventDefault();

            js("#spin").removeClass("visually-hidden");
            js("#ExecuteRequest").attr('disabled', true);

            var url = "@Url.Action("ReenvioSMS","ReenvioSMS")";

            var model = new Object();
            model.telefono = js("#numeroTelefonico").val();

            js.ajax({
                type: "POST",
                url: url,
                dataType: "json",
                data: model,
                success: function (data) {
                    if (data.codigo != 0) {
                        swal({
                            title: "Error",
                            text: data.mensaje,
                            type: "warning",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }
                    else {

                        swal({
                            title: "Exito",
                            text: "ASP Pago - " + data.mensaje + " - Teléfono asociado: " + js("#numeroTelefonico").val(),
                            type: "success",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });

                    }
                    js("#ExecuteRequest").attr('disabled', false);
                    js("#spin").addClass("visually-hidden");

                }
            });

        });
    });
</script>



