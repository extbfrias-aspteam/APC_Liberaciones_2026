
@{
    ViewData["Title"] = "WSAsignarNIP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h5>Asignación de NIP</h5>
<div id="emailHelp" class="form-text">WebService que permitirá asignar el nip a la tarjeta física.</div>
<div class="card-box">
    <div class="card-body">
        <form class="" id="Formulario">

            <div class="row g-3">
                <div class="col-sm-4">
                    <input class="form-control" type="password" name="numeroTarjeta" id="numeroTarjeta" placeholder="Número de Tarjeta" aria-label="default input example">
                </div>
                <div class="col-sm-4">
                    <input class="form-control" type="password" name="nip" id="nip" placeholder="Número de Identificación Personal" aria-label="default input example">
                </div>
                <div class="col-sm-4">
                    <button type="submit" id="ExecuteRequest" class="btn btn-success">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">

    var js = jQuery.noConflict(true);

    js(document).ready(function () {



        js('#ExecuteRequest').on("click", function (event) {
            event.preventDefault();
            js("#spin").removeClass("visually-hidden");
            js("#ExecuteRequest").attr('disabled', true);

            var url = "@Url.Action("WSAsignarNIP","WSAsignarNIP")";

            var data = new Object();
            data.numeroTarjeta = js("#numeroTarjeta").val();
            data.nip = js("#nip").val();

            js.ajax({
                type: "POST",
                url: url,
                dataType: "json",
                data: data,
                success: function (data) {
                    if (data.codigo != 0) {
                        swal({
                            title: "Error",
                            text: data.mensaje,
                            type: "warning",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }
                    else {

                        swal({
                            title: "Exito",
                            text: data.mensaje,
                            type: "success",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                        js("#Formulario")[0].reset();
                    }
                    js("#ExecuteRequest").attr('disabled', false);
                    js("#spin").addClass("visually-hidden");
                }
            });

        });
    });
</script>


