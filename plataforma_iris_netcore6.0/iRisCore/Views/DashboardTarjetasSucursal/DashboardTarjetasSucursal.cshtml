    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Inventario de Tarjetas</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                   
                    <div class="col-md-8">
