@using iRisModel;

@{
    ViewData["Title"] = "DashboardTarjetasSucursal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Estilos {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
}


<!--Inicio Modal pre-Asignar Tarjeta a sucursales -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Pre-Asignar Tarjetas a Sucursal</h5>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="field-1" class="control-label"><strong>Sucursal</strong></label>
                            <select class="form-select" name="items" id="sucursalModal" aria-label="Default select example">
                                <option selected>Seleccione la sucursal</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="field-1" class="control-label"><strong>Cantidad a distribuir</strong></label>
                            <input type="text" class="form-control" name="cantidadAsignar" id="cantidadAsignar" placeholder="Cantidad" maxlength="8">
                        </div>
                    </div>
               </div>
               <br />
               <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="field-1" class="control-label"><strong>Nombre del personal que recibirá el paquete de tarjetas</strong></label>
                            <input type="text" class="form-control" name="quienRecibe" id="quienRecibe" placeholder="Nombre de la persona que recibirá el paquete" maxlength="100">
                        </div>
                    </div>                   
                </div>
                <br />
                <div class="row">                   
                    <div class="col-md-12 text-center">
                        <div class="form-group">
                            <button type="button" id="ExecuteAssignCard" class="btn btn-primary waves-effect waves-light">Pre-asignar Tarjetas</button>
                        </div>
                    </div>
                </div>

               
                <hr />
                <br />
                <table id="example2" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Sucursal</th>
                            <th>Tarjetas Pre-Asignadas</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>
                   
                </table>
            </div>

            <div class="modal-footer">
                <button type="submit" id="btnArchivoDistribucion" class="btn btn-success">Confirmar archivo de distribución</button>
                <button type="button" id="btnCerrarModal" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>           
            </div>
        </div>
    </div>
</div>   
<!--Fin Modal pre-asignar Tarjetas a sucursales-->

<!--Inicio Modal Asignar Tarjetas al CEDIS -->
<!--Inicio Modal pre-Asignar Tarjeta a sucursales -->
<div class="modal fade" id="staticBackdropCedis" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Asignar Tarjetas a CEDIS</h5>
            </div>
            <div class="modal-body">                
                
                <table id="example2" class="display" style="width:100%">
                    <thead>
                        <tr>
                            <th>Sucursal</th>
                            <th>Tarjetas Pre-Asignadas</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>

                </table>
            </div>

            <div class="modal-footer">
                <button type="submit" id="btnArchivoDistribucion" class="btn btn-success">Confirmar archivo de distribución</button>
                <button type="button" id="btnCerrarModal" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
<!--Fin Modal Asignar Tarjetas-->
<!--Fin Modal asignar tarjetas al CEDIS-->





<!--Inicio Modal Cargar Tarjetas-->
