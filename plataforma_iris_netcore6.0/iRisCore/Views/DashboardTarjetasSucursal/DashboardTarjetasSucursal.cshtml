<h5>Tarjeta en Sucursal / CEDIS</h5>
<div id="emailHelp" class="form-text"> Módulo de administración de inventarios de tarjetas físicas</div>
<div class="card-box">
    <div class="card-body">
        <form class="form-horizontal" role="form">
            <div class="row g-1">
                <div class="col-sm-3">
                    <select class="form-select" name="marcaId" id="marcaId" aria-label="Default select example">
                        <option selected>Seleccione la marca</option>
                        @if (ViewBag.Marcas != null)
                        {
                            List<MarcaModel> oMarcas = (List<MarcaModel>)ViewBag.Marcas;
                            foreach (MarcaModel item in oMarcas)
                            {
                                <option value=@item.idMarca>@item.Marca</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <select class="form-select" name="sucursalId" id="sucursalId" aria-label="Default select example">
                        <option value="-1" selected>Seleccione la sucursal</option>
                        @if (ViewBag.Sucursales != null)
                        {
                            List<SucursalModel> oSucursal = (List<SucursalModel>)ViewBag.Sucursales;
                            foreach (SucursalModel item in oSucursal)
                            {
                                <option value=@item.idSucursal>@item.Sucursal</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <select class="form-select" name="estatusId" id="estatusId" aria-label="Default select example">
                        <option selected>Seleccione el estatus</option>
                        @if (ViewBag.Estatus != null)
                        {
                            List<EstatusModel> oEstatus = (List<EstatusModel>)ViewBag.Estatus;
                            foreach (EstatusModel item in oEstatus)
                            {
                                <option value=@item.idEstatus>@item.Estatus</option>
                            }
                        }
                        
                    </select>
                </div>

                <div class="col-sm-3">
                    <button type="submit" id="ExecuteRequest" class="btn btn-success">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Consulta
                    </button>
                    <a class="visually-hidden" id="urlExcel" href="@Url.Action("GenerateExcel","DashBoardTarjetas")">Download Excel</a>
                </div>
            </div>            
             <div class="row g-1" style="margin-top:5px;">
                <div class="form-group">
                    <div class="col-sm-offset-3 col-sm-9">
                        <div class="checkbox checkbox-primary">
                            <input id="firstStock" type="checkbox" name="firstStock">
                            <small style="color:red;"><label for="checkbox2">
                               Primer Lote de Tarjetas
                                </label>
                            </small>
                        </div>
                    </div>
                </div>
                
             </div>

        </form>
    </div>
</div>
    
<div style="text-align:right;">
    
    <button id="AsignarCardCedis" class="btn btn-info waves-effect waves-light">Asignar Tarjetas CEDIS</button>
    <button type="button" id="ExecuteCargarTarjetas" data-bs-toggle="modal" data-bs-target="#staticBackdropCarga" class="btn btn-warning waves-effect waves-light">Cargar Inventario</button>
    <button type="button" id="ExecuteAsignarTarjeta" data-bs-toggle="modal" data-bs-target="#staticBackdrop" class="btn btn-danger waves-effect waves-light">Pre-Asignar Tarjetas</button>

    <button type="button" id="ExecuteRpt" class="btn btn-danger waves-effect waves-light">Generar Reporte</button>


