        $(document).ready(function () {
            $('#modalActDesRefe').on('shown.bs.modal', function () {
                const referenciadorEstatusSelect = $('#referenciadorEstatus');

                function cargarReferenciadoresParaEstatus() {
                    $.ajax({
                        url: '/GestionReferidos/ObtenerListasAltaCodigo',
                        type: 'GET',
                        dataType: 'json',
                        success: function (data) {
                            if (data && data.referenciadores) {
                                referenciadorEstatusSelect.empty();
                                referenciadorEstatusSelect.append('<option value="">Seleccione un Referenciador1</option>');
                                $.each(data.referenciadores, function (index, referenciador) {
                                    referenciadorEstatusSelect.append('<option value="' + referenciador.id + '" data-estatus="' + referenciador.estatus + '" data-cuenta="' + referenciador.cuenta + '">' + referenciador.cuenta + '-' + referenciador.nombre + '</option>');
                                });

                                if (referenciadorEstatusSelect.data('select2')) {
                                    referenciadorEstatusSelect.select2('destroy');
                                }

                                referenciadorEstatusSelect.select2({
                                    dropdownParent: $('#modalActDesRefe'),
                                    placeholder: 'Seleccione un Referenciador',
                                    allowClear: true
                                });

                                // Los radios siempre inician en Activo seleccionado
                                $('#activoRadio').prop('checked', true);
                                $('#inactivoRadio').prop('checked', false);

                            } else {
                                swal('Error', 'No se pudieron cargar los referenciadores para el estatus.', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            swal('Error', 'Error al cargar los referenciadores: ' + xhr.responseText, 'error');
                        }
                    });
                }

                // Evento Change para el Select de Referenciadores
                referenciadorEstatusSelect.off('change').on('change', function () {
                    const selectedOption = $(this).find('option:selected');
                    const estatus = (selectedOption.data('estatus') + '').toUpperCase(); // Asegurate que sea string mayúsculas

                    if (estatus === 'ACTIVO') {
                        $('#activoRadio').prop('checked', true);
                        $('#inactivoRadio').prop('checked', false);
                    } else if (estatus === 'INACTIVO') {
                        $('#activoRadio').prop('checked', false);
                        $('#inactivoRadio').prop('checked', true);
                    } else {
                        // Por si llegara 'nulo' o diferente, ninguno seleccionado o default a 'inactivo'
                        $('#activoRadio').prop('checked', false);
                        $('#inactivoRadio').prop('checked', true);
                    }
                });

                // Llama a la función para cargar datos cuando el modal se muestra
                cargarReferenciadoresParaEstatus();

                // Al abrir modal, marca Activo por default
                $('#activoRadio').prop('checked', true);
                $('#inactivoRadio').prop('checked', false);
            });

            // Limpia radios y select al cerrar modal
            $('#modalActDesRefe').on('hidden.bs.modal', function () {
                $('#referenciadorEstatus')[0].selectedIndex = 0;
                if ($('#referenciadorEstatus').data('select2')) {
                    $('#referenciadorEstatus').select2('destroy');
                }
                $('#activoRadio').prop('checked', true);
                $('#inactivoRadio').prop('checked', false);
            });
        });



