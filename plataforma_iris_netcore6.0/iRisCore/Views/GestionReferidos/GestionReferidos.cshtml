        $(document).ready(function () {
            $('#modalActDesCodigo').on('shown.bs.modal', function () {
                const codigoSelect = $('#miCodigoSelect');
                function cargarCodigos() {
                    $.ajax({
                        url: '/GestionReferidos/ObtenerCodigos',
                        type: 'GET',
                        dataType: 'json',
                        success: function (data) {
                            if (data && data.success && data.codigos) {
                                if (codigoSelect.data('select2')) {
                                    codigoSelect.select2('destroy');
                                }
                                codigoSelect.empty();
                                codigoSelect.append('<option value="">Seleccione un Código</option>');
                                $.each(data.codigos, function (index, codigo) {
                                    var estatus = (codigo.estatus || '').toUpperCase();
                                    codigoSelect.append('<option value="' + codigo.id + '" data-estatus="' + estatus + '">' + codigo.codigoReferencia + ' - ' + codigo.descripcion + '</option>');
                                });
                                codigoSelect.select2({
                                    dropdownParent: $('#modalActDesCodigo'),
                                    placeholder: 'Seleccione un Código',
                                    allowClear: true
                                });
                                // ... Radios por default ...
                            } else {
                                swal('Error', data.message || 'No se pudieron cargar los códigos.', 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            swal('Error', 'Error al cargar los códigos: ' + xhr.responseText, 'error');
                        }
                    });
                }
                // Siempre desuscribe y vuelve a asignar el evento change
                function setRadiosPorDefault() {
                    $('#codigoActivo').prop('checked', true);
                    $('#codigoInactivo').prop('checked', false);
                    $('#codigoCancelado').prop('checked', true);
                }
               
                cargarCodigos();
              
            });
            $('#modalActDesCodigo').on('hidden.bs.modal', function () {
                const codigoSelect = $('#miCodigoSelect');
                if (codigoSelect.data('select2')) {
                    codigoSelect.select2('destroy');
                }
                codigoSelect.empty().append('<option value="">Seleccione un Código</option>');
                // ... radios por default ...
            });


            // ---  de cómo enviar el estatus desde los radios ---
            $(document).ready(function () {
                $('#GuardarActDeCogigo').on('click', function () {
                    var codigoId = $('#miCodigoSelect').val();
                    var estatus = $('input[name="estatusCodigo"]:checked').val(); // ACTIVO, INACTIVO, CANCELADO

                    if (!codigoId) {
                        swal('Atención', 'Seleccione un código.', 'warning');
                        return;
                    }

                    if (!estatus) {
                        swal('Atención', 'Seleccione un estatus.', 'warning');
                        return;
                    }

                    // La función que realmente guarda
                    function guardarEstatusCodigo() {
                        $('#spin').show();
                        $('#GuardarActDeCogigo').prop('disabled', true);

                        var requestData = {
                            codigoId: parseInt(codigoId),
                            estatus: estatus
                        };

                        $.ajax({
                            url: '/GestionReferidos/ModificarEstatusCodigo',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(requestData),
                            success: function (response) {
                                $('#spin').hide();
                                $('#GuardarActDeCogigo').prop('disabled', false);

                                if (response && response.codigo === 0) {
                                    swal('Éxito', response.mensaje || 'Estatus actualizado correctamente.', 'success');
                                    $('#modalActDesCodigo').modal('hide');
                                } else {
                                    swal('Error', response.mensaje || 'No se pudo actualizar el estatus del código.', 'error');
                                }
                            },
                            error: function (xhr) {
                                $('#spin').hide();
                                $('#GuardarActDeCogigo').prop('disabled', false);
                                swal('Error', 'Error en la solicitud AJAX: ' + xhr.responseText, 'error');
                            }
                        });
                    }

                    // Si seleccionan "CANCELADO", pide confirmación antes de guardar
                    if (estatus === 'CANCELADO') {
                        // Para SweetAlert clásico
                        if (typeof swal === "function" && !window.Swal) {
                            swal({
                                title: "Confirmar cancelación",
                                text: "Este código se marcará como CANCELADO y ya no podrá activarse nuevamente. ¿Desea continuar?",
                                type: "warning",
                                showCancelButton: true,
                                confirmButtonColor: "#d33",
                                confirmButtonText: "Sí, cancelar",
                                cancelButtonText: "No"
                            }, function (isConfirm) {
                                if (isConfirm) {
                                    guardarEstatusCodigo();
                                }
                            });
                        }
                        // Para SweetAlert2 (`Swal.fire`)
                        else if (typeof Swal !== "undefined") {
                            Swal.fire({
                                title: "Confirmar cancelación",
                                text: "Este código se marcará como CANCELADO y ya no podrá activarse nuevamente. ¿Desea continuar?",
                                icon: "warning",
                                showCancelButton: true,
                                confirmButtonColor: "#d33",
                                confirmButtonText: "Sí, cancelar",
                                cancelButtonText: "No"
                            }).then(function (result) {
                                // Compatible con ambas versiones de SweetAlert2
                                if (result.isConfirmed || result === true) {
                                    guardarEstatusCodigo();
                                }
                            });
                        }
                    } else {
                        guardarEstatusCodigo();
                    }
                });
            });
        });
    </script>
