                            swal('Error', response.mensaje || 'No se pudo actualizar el estatus del referenciador.', 'error');
                        }
                    },
                    error: function (xhr) {
                        $('#spin').hide();
                        $('#GuardarActDesRefe').prop('disabled', false);
