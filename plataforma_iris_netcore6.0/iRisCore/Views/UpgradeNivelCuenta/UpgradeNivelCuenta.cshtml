@using iRisModel
@{
    ViewData["Title"] = "UpgradeNivelCuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h5>Upgrade de Cuenta</h5>
<div id="emailHelp" class="form-text">Web Service que permite la actualización del Nivel de Cuenta.</div>

@if (ViewBag.Niveles != null)
{
    List<DetalleNiveles> oNivel = (List<DetalleNiveles>)ViewBag.Niveles;

    <div class="card-box">
        <div class="card-body">
            <form class="" id="Formulario">

                <div class="row g-4">
                    <div class="col-sm-4">
                        <select class="form-select" name="nivelCuenta" id="nivelCuenta" aria-label="Default select example">
                            <option selected>Seleccione el Nivel de Cuenta</option>
                            @foreach (DetalleNiveles item in oNivel)  //-- Segundo Nivel
                            {
                                <option value=@item.clave>@item.clave</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <input class="form-control" type="password" name="cuentaASP" id="cuentaASP" placeholder="Número de Cuenta ASP" maxlength="10" aria-label="default input example">
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" id="ExecuteRequest" class="btn btn-success">
                            <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                            Ejecutar Operación
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">

    var js = jQuery.noConflict(true);

    js(document).ready(function () {

        js(document).on('click', '.confirm', function () {
            var myH2 = document.getElementsByTagName('h2')[0].innerHTML;
            if (myH2 == 'Exito') {
                limpiarView();
                js("#Formulario")[0].reset();
            }
        });

        js('#ExecuteRequest').on("click", function (event) {
            event.preventDefault();

            js("#spin").removeClass("visually-hidden");
            js("#ExecuteRequest").attr('disabled', true);

            var url = "@Url.Action("UpgradeNivelCuenta","UpgradeNivelCuenta")";

            var info = new Object();
            info.nivelCuenta = js("#nivelCuenta").val();
            info.cuentaASP = js("#cuentaASP").val();
            js.ajax({
                type: "POST",
                url: url,
                dataType: "json",
                data: info,
                success: function (data) {                    
                    if (data.codigo != 0) {
                        swal({
                            title: "Error",
                            text: data.mensaje,
                            type: "warning",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }
                    else {

                        swal({
                            title: "Exito",
                            text: data.mensaje,
                            type: "success",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }
                    js("#ExecuteRequest").attr('disabled', false);
                    js("#spin").addClass("visually-hidden");
                }
            });

        });


    });
</script>
