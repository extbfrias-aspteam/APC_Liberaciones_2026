@{
    ViewData["Title"] = "ConsultaDuplicados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Estilos {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.3.6/css/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
}
<div>
    <h3>Consulta de teléfonos o correos duplicados</h3>
    Servicio que permite consultar los números de teléfono o correos duplicados.
</div>

<div class="card-box">
    <div class="card-body">

        <form id="formulario">
            <div class="row g-3">
                <div class="col-sm-4">
                    <select class="form-select" name="tipoBloqueo" id="tipoBloqueo" aria-label="Default select example">
                        <option selected>Seleccione una opción...</option>
                        <option value="T">Teléfono</option>
                        <option value="E">Correo</option>
                    </select>
                </div>
                <div class="col-sm-4" id="dinput">
                    <input disabled class="form-control" type="text" name="tinput" id="tinput" placeholder=" " aria-label="default input example">
                </div>
                <div class="col-sm-2">
                    <button disabled type="submit" class="btn btn-success" id="ExecuteRequest">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="card-box">
    <div class="card-body">
        <div class="row gx-5" id="tabla" style="white-space: nowrap">
            <table id="infCuentas" class="display" style="width: 100%;">
                <thead>
                <tr>
                    <th style="text-align: center;">Id solicitante</th>
                    <th style="text-align: center;">Nombre</th>
                    <th style="text-align: center;">Curp</th>
                    <th style="text-align: center;">RFC</th>
                    <th style="text-align: center;">Telefono</th>
                    <th style="text-align: center;">Correo</th>
                    <th style="text-align: center;">Cuenta</th>
                    <th style="text-align: center;">Producto</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.3.6/js/buttons.print.min.js"></script>

    <script>
        $(document).ready(function () {
            // Inicializar DataTables con opciones de exportación, búsqueda y ordenamiento
            // $.fn.dataTable.Editor.classes.form.button = "";
            var tablaOperaciones = $('#infCuentas').DataTable({
                destroy: true,
                responsive: true,
                scrollX: true,
                ordering: true,
                paging: true,
                searching: true,
                lengthChange: false,
                language: {
                    "url": "../lib/Spanish.json"
                },
                columns: [
                    { data: 'solicitanteId' },
                    { data: 'nombre' },
                    { data: 'curp' },
                    { data: 'rfc' },
                    { data: 'telefono' },
                    { data: 'correo' },
                    { data: 'cuenta' },
                    { data: 'producto' },
                ]
            });

            $('#tipoBloqueo').on('change', function () {
                if ($("#tipoBloqueo").val() == "T" || $("#tipoBloqueo").val() == "E") {
                    $("#tinput").attr('disabled', false);
                    $("#ExecuteRequest").attr('disabled', false);
                    var inputDato = document.getElementById("tinput");
                    inputDato.value = "";
                }
                else {
                    $("#tinput").attr('disabled', true);
                    var inputDato = document.getElementById("tinput");
                    inputDato.value = "";
                    $("#ExecuteRequest").attr('disabled', true);
                }
            });

            $('#tinput').on('input', function () {
                if ($("#tipoBloqueo").val() == "T") {
                    this.value = this.value.replace(/[^0-9]/g, ''); // Elimina todo lo que no sea un número
                }
            });

            $('#ExecuteRequest').on("click", function (event) {
                event.preventDefault();
                $("#spin").removeClass("visually-hidden");
                $("#ExecuteRequest").attr('disabled', true);

                tablaOperaciones.clear();
                tablaOperaciones.draw();

                var data = new Object();

                if ($("#tipoBloqueo").val() == "T") {
                    data.telefono = $("#tinput").val();
                }
                else
                {
                    data.correo = $("#tinput").val();
                }

                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetDuplicados", "ConsultaDuplicados")',
                    dataType: "json",
                    data: data,
                    success: function (data) {
                        //Exito
                        if (data.result.codigo == 1) {
                            tablaOperaciones.rows.add(data.result.data);
                            tablaOperaciones.draw();

                            if (data.result.mensaje != "Exito") 
                            {
                                swal({
                                    title: "",
                                    text: data.result.mensaje,
                                    type: "success",
                                    showCancelButton: false,
                                    confirmButtonColor: "#DD6B55",
                                    closeOnConfirm: false
                                });
                            }
                        }
                        else if (data.result.codigo == -1) {
                            console.error('Error:', data.result.mensaje);
                        }
                        else {
                            swal({
                                title: "Error",
                                text: data.result.mensaje,
                                type: "warning",
                                showCancelButton: false,
                                confirmButtonColor: "#DD6B55",
                                closeOnConfirm: false
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error:', error);
                    },
                    complete: function (xhr, status) {
                        //quitar spin y activar botón
                        $("#ExecuteRequest").attr('disabled', false);
                        $("#spin").addClass("visually-hidden");
                        var inputDato = document.getElementById("tinput");
                        inputDato.value = "";
                    }
                });
            });
        });
    </script>

}