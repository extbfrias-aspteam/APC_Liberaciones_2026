
@{
    ViewData["Title"] = "WSActivarTarjeta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h5>Activar Tarjeta</h5>
<div id="emailHelp" class="form-text">WebService que permitirá Activar una Tarjeta Física o Virtual.</div>
<div class="card-box">
    <div class="card-body">
        <form id="Formulario">
            <div class="row g-2">
                <div class="col-sm-6">
                    <input class="form-control" type="password" name="numeroTarjeta" id="numeroTarjeta" placeholder="Número de Tarjeta" aria-label="default input example">
                </div>
                <div class="col-sm-6">
                    <button type="submit" class="btn btn-success" id="ExecuteRequest">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">
    var js = jQuery.noConflict(true);

    js(document).ready(function () {

        js(document).on('click', '.confirm', function () {
            var myH2 = document.getElementsByTagName('h2')[0].innerHTML;
            if (myH2 == 'Exito') {
                js("#Formulario")[0].reset();
            }
        });

        js('#ExecuteRequest').on("click", function (event) {
            event.preventDefault();

            js("#spin").removeClass("visually-hidden");
            js("#ExecuteRequest").attr('disabled', true);

            var url = "@Url.Action("WSActivarTarjeta","WSActivarTarjeta")";

            var data = new Object();
            data.numeroTarjeta = js("#numeroTarjeta").val();

            js.ajax({
                type: "POST",
                url: url,
                dataType: "json",
                data: data,
                success: function (data) {                   
                    if (data.codigo != 0) {
                        swal({
                            title: "Error",
                            text: data.mensaje,
                            type: "warning",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }
                    else {

                        swal({
                            title: "Exito",
                            text: "Tarjeta Activada: " + js("#numeroTarjeta").val(),
                            type: "success",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }

                    js("#ExecuteRequest").attr('disabled', false);
                    js("#spin").addClass("visually-hidden");
                }
            });

        });

    })


</script>
