
@{
    ViewData["Title"] = "BloqueoDesbloqueoAPP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h5>Bloqueo y Desbloqueo de la APP Movil</h5>

<div id="emailHelp" class="form-text">WebService que permitirá bloquear o desbloquear la App Movil.</div>
<div class="card-box">
    <div class="card-body">
        <form class="" id="Formulario">

            <div class="row g-3">
                <div class="col-sm-4">
                    <select class="form-select" name="tipoOperacion" id="tipoOperacion" aria-label="Default select example">
                        <option selected>Seleccione el Tipo de Operación</option>
                        <option value="Block">Bloqueo</option>
                        <option value="unLock">Desbloqueo</option>
                    </select>
                </div>
                <div class="col-sm-2">
                    <input class="form-control" type="text" name="numeroTelefonico" id="numeroTelefonico" placeholder="Número Telefónico" aria-label="default input example">
                </div>
                <div class="col-sm-2">
                    <input class="form-control" type="text" name="cuentaASP" id="cuentaASP" placeholder="Cuenta ASP" maxlength="10" aria-label="default input example">
                </div>

                <div class="col-sm-3">
                    <button type="submit" id="ExecuteRequest" class="btn btn-success">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Operación</button>
                </div>
            </div>
        </form>
    </div>
</div>


<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">

    var js = jQuery.noConflict(true);

    js(document).ready(function () {

        js(document).on('click', '.confirm', function () {
            var myH2 = document.getElementsByTagName('h2')[0].innerHTML;
            if (myH2 == 'Exito') {
                js("#Formulario")[0].reset();
            }
        });

        js('#ExecuteRequest').on("click", function (event) {
            event.preventDefault();
            js("#spin").removeClass("visually-hidden");
            js("#ExecuteRequest").attr('disabled', true);

            var url = "@Url.Action("BloqueoDesbloqueoAPP","BloqueoDesbloqueoAPP")";

            var data = new Object();
            data.telefono = js("#numeroTelefonico").val();
            data.cuenta = js("#cuentaASP").val();

            js.ajax({
                type: "POST",
                url: url,
                dataType: "json",
                data: { model:data, tipoOperacion: js("#tipoOperacion").val() },
                success: function (data) {                   
                    if (data.codigo != 0) {
                        swal({
                            title: "Error",
                            text: data.mensaje,
                            type: "warning",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });
                    }
                    else {

                        swal({
                            title: "Exito",
                            text: "ASP Pago - " + data.mensaje + " - Teléfono asociado: " + js("#numeroTelefonico").val(),
                            type: "success",
                            showCancelButton: false,
                            confirmButtonColor: "#DD6B55",
                            closeOnConfirm: false
                        });

                    }
                    js("#ExecuteRequest").attr('disabled', false);
                    js("#spin").addClass("visually-hidden");
                }
            });

        });
    });
</script>


