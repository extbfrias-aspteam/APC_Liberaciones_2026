@using iRisModel;
@{
    ViewData["Title"] = "PagoCredito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" rel="stylesheet" />
}

<h5>Consulta - Estado de Movimientos - Crédito</h5>
<div id="emailHelp" class="form-text">WS que permite consultar el Estado de Movimientos</div>
<div class="card-box">
    <div class="card-body">
        <form>
            <div class="row g-1">
                <div class="col-sm-12">
                    <select class="form-select" name="sucursalId" id="sucursalId" aria-label="Default select example">
                        <option value="-1" selected>Seleccione la sucursal</option>
                        @if (ViewBag.Sucursales != null)
                        {
                            List<SucursalModel> oSucursal = (List<SucursalModel>)ViewBag.Sucursales;
                            foreach (SucursalModel item in oSucursal)
                            {
                                <option value=@item.idSucursal>@item.Sucursal</option>
                            }
                        }
                    </select>
                </div>
            </div>           
            <br />
            <div class="row g-1">                
                <div class="col-sm-4">
                    <div class="form-group">
                        <input type="text" class="form-control" name="cuentaCredito" id="cuentaCredito" placeholder="Cuenta de Crédito" maxlength="10" required>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        <input type="text" class="form-control" name="noDisposicion" id="noDisposicion" placeholder="Número de Disposición" maxlength="3" required>
                    </div>
                </div>

                <div class="col-sm-3">
                    <button type="submit" id="ExecuteRequest" class="btn btn-success">
                        <span id="spin" class="spinner-border spinner-border-sm visually-hidden"></span>
                        Ejecutar Consulta
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>

<div id="resultado" class="visually-hidden">
<div class="row">
    <div class="col-lg-12">
        <div class="card-box">
            <center><h3>Estado de Movimientos</h3><strong><span style="color:darkred;" id="periodo"></span> </strong>  <span id="pago"></span></center>
        </div>
    </div>
</div>


<div class="row" id="detalle">
    <div class="col-lg-6">
        <div class="card-box">            
            <form class="form-horizontal" role="form">
                <div class="form-group">
                    <label class="col-md-3 control-label"><strong>No. Cuenta</strong></label>
                    <label class="col-md-8 control-label"><span style="color:darkblue;" id="cuenta"></span></label>
                </div>
                <div class="form-group">
                    <label class="col-md-3 control-label"><strong>Empresa</strong></label>
                    <label class="col-md-8 control-label"><span style="color:darkblue;" id="empresa"></span></label>
                </div>
                <div class="form-group">
                    <label class="col-md-3 control-label"><strong>Solicitante</strong></label>
                    <label class="col-md-8 control-label"><span style="color:darkblue;" id="solicitante"></span></label>
                </div>
                <div class="form-group">
                    <label class="col-md-3 control-label"><strong>Referencia</strong></label>
                    <label class="col-md-8 control-label"><span style="color:darkblue;" id="referencia"></span></label>
                </div>
                <div class="form-group">
                    <label class="col-md-3 control-label"><strong>Disposición</strong></label>
                    <label class="col-md-8 control-label"><span style="color:darkblue;" id="numeroDisposicion"></span></label>
                </div>

            </form>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card-box">
            <form class="form-horizontal" role="form">
                <div class="form-group">
                    <label class="col-md-4 control-label"><strong>Tasa anual</strong></label>
                    <label class="col-md-2 control-label"><span style="color:darkblue;" id="tasaAnual"></span></label>
                    <label class="col-md-3 control-label"><strong>Tasa mensual</strong></label>
                    <label class="col-md-2 control-label"><span style="color:darkblue;" id="tasaMensual"></span></label>
                </div>               
                <div class="form-group">
                    <label class="col-md-4 control-label"><strong>Tasa moratoria</strong></label>
                    <label class="col-md-6 control-label"><span style="color:darkblue;" id="tasaMoratoria"></span></label>
                </div>

                <div class="form-group">
                    <label class="col-md-4 control-label"><strong>CAT</strong></label>
                    <label class="col-md-6 control-label"><span style="color:darkblue;" id="cat"></span></label>
                </div>
                <div class="form-group">
                    <label class="col-md-4 control-label"><strong>Monto</strong></label>
                    <label class="col-md-6 control-label"><span style="color:darkblue;" id="montoDispersion"></span></label>
                </div>
                <div class="form-group">
                    <label class="col-md-4 control-label"><strong>Fecha de descuento</strong></label>
                    <label class="col-md-2 control-label"><span style="color:darkblue;" id="fechaDescuento"></span></label>
                        <label class="col-md-3 control-label"><strong>Calificación</strong></label>
                        <label class="col-md-2 control-label"><span style="color:darkblue;" id="calificacion"></span></label>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row">
  <div class="col-12">

      <table id="example" class="display" style="width:100%">
        <thead>
             <tr>                
                <th colspan="11" style="background-color:darkgrey; text-align:center; color:white;">Vencimientos</th>
                <th colspan="10" style="background-color:dimgray; text-align:center; color:white;">Pagos</th>
            </tr> 
            <tr>
                <th rowspan="2">No</th>
                <th rowspan="2">Fecha.Venc</th>
                <th rowspan="2">Capital</th>
                <th rowspan="2">Int.Normal</th>
                <th rowspan="2">Falta-Pago</th>
                <th rowspan="2">Pago-Tardío</th>
                <th colspan="3" style="text-align:center;">Impuestos</th>
                <th rowspan="2">Total</th>
                <th rowspan="2">Edo</th>

                        <th rowspan="2">Capital</th>
                        <th rowspan="2">Int.Normal</th>
                        <th rowspan="2">Falta-Pago</th>
                        <th rowspan="2">Pago-Tardío</th>
                        <th colspan="3" style="text-align:center;">Impuestos</th>
                        <th rowspan="2">Total</th>
                        <th rowspan="2">Fecha-Pago</th>
                        <th rowspan="2">Dias-atraso</th>

            </tr>
            <tr>             
                <th>Normal</th>
                <th>Falta-Pago</th>
                <th>Pago-Tardio</th>               
                <th>Normal</th>
                <th>Falta-Pago</th>
                <th>Pago-Tardío</th>
            </tr>
        </thead>
        <tbody>
            
        </tbody>
      </table>
    </div>

</div>
</div>


