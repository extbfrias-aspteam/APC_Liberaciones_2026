        var colors = ['#b91d47', '#00aba9', '#2b5797', '#e8c3b9', '#1e7145', '#6c757d'];

        var url = "@Url.Action("DashBoardCuentas","Home")";

        js.ajax({
            type: "POST",
            url: url,
            dataType: "json",
            data: { tipoProducto: "facil" },
            async: true,
            success: function (data) {
                const meses = [];
                const vigente = [];
                const cancelada = [];
                const bloqueada = [];

                var idx = 0;
                data.concentradoActual.forEach(function (detallado, index) {                     
                        if (detallado.estatus == "VIGENTE") {
                        js("#totVigenteCuentaFacil").text(data.concentradoActual[idx].total);
                        }
                    idx++;
                });               

                data.detalladoAnual.forEach(function(detallado, index)
                {
                    meses.push(detallado.mes.substring(0,3));
                    
                    detallado.estatusCuenta.forEach(function(detalle, index) {
                        if (detalle.estatus == "VIGENTE") {
                            vigente.push(detalle.cantidad);
                        } else if (detalle.estatus == "CANCELADA") {
                            cancelada.push(detalle.cantidad);
                        } else {
                            bloqueada.push(detalle.cantidad);
                        }
                    });
                }); 

                /* large line chart */
                var chLine = document.getElementById("chLine");
                var chartData = {
                    labels: meses,
                    datasets: [{
                        label: 'Activas',
                        data: vigente,
                        backgroundColor: colors[1], //'transparent',
                        borderColor: colors[1],
                        borderWidth: 4,
                        pointBackgroundColor: colors[1]
                    },
                    {
                        label: 'Bloqueadas',
                        data: bloqueada,
                        backgroundColor: colors[3],
                        borderColor: colors[3],
                        borderWidth: 4,
                        pointBackgroundColor: colors[3]
                    },
                    {
                        label: 'Canceladas',
                        data: cancelada,
                        backgroundColor: colors[4],
                        borderColor: colors[4],
                        borderWidth: 4,
                        pointBackgroundColor: colors[4]
                    }
                    ]
                };
                if (chLine) {
                    new Chart(chLine, {
                        type: 'line',
                        data: chartData,
                        options: {                            
                            legend: {
                                display: false
                            },
                            responsive: true
                        }
                    });
                }
            }
        });



        /* ------ ------- */
        js.ajax({
            type: "POST",
            url: url,
            dataType: "json",
            data: { tipoProducto: "miahorro" },
            async: true,
            success: function (data) {
                const meses2 = [];
                const vigente2 = [];
                const cancelada2 = [];
                const bloqueada2 = [];

                var idxAhorro = 0;

                data.concentradoActual.forEach(function (detallado, index) {
                    if (detallado.estatus == "VIGENTE") {
                        js("#totVigenteMiAhorro").text(data.concentradoActual[idxAhorro].total);
                    }
                    idxAhorro++;
                });                

                data.detalladoAnual.forEach(function (detallado, index) {
                    meses2.push(detallado.mes.substring(0, 3));

                    detallado.estatusCuenta.forEach(function (detalle, index) {
                        if (detalle.estatus == "VIGENTE") {
                            vigente2.push(detalle.cantidad);
                        } else if (detalle.estatus == "CANCELADA") {
                            cancelada2.push(detalle.cantidad);
                        } else {
                            bloqueada2.push(detalle.cantidad);
                        }
                    });
                });

                /* large line chart */
                chLine = document.getElementById("chLineMiAhorro");
                 chartData = {
                    labels: meses2,
                    datasets: [{
                        label: 'Activas',
                        data: vigente2,
                        backgroundColor: colors[1], //'transparent',
                        borderColor: colors[1],
                        borderWidth: 4,
                        pointBackgroundColor: colors[1]
                    },
                    {
                        label: 'Bloqueadas',
                        data: bloqueada2,
                        backgroundColor: colors[3],
                        borderColor: colors[3],
                        borderWidth: 4,
                        pointBackgroundColor: colors[3]
                    },
                    {
                        label: 'Canceladas',
                        data: cancelada2,
                        backgroundColor: colors[4],
                        borderColor: colors[4],
                        borderWidth: 4,
                        pointBackgroundColor: colors[4]
                    }
                    ]
                };
                if (chLine) {
                    new Chart(chLine, {
                        type: 'line',
                        data: chartData,
                        options: {
                            legend: {
                                display: false
                            },
                            responsive: true
                        }
                    });
                }
            }
        });

        /* -------------- */





        var urlEstatus = "@Url.Action("DashBoardTarjetas","Home")";
        js.ajax({
            type: "GET",
            url: urlEstatus,
            dataType: "json",
            data: null,
            async: true,
            success: function (data) {
                                
                js("#TFActivas").text(data.totalTFActiva);
                js("#TFBloqueadas").text(data.totalTFBloqueada);
                js("#TFCanceladas").text(data.totalTFCancelada);     
                js("#TFSinAsignar").text(data.totalTFSinAsignar);

                js("#TVActivas").text(data.totalTVActiva);
                js("#TVBloqueadas").text(data.totalTVBloqueada);
                js("#TVCanceladas").text(data.totalTVCancelada);
            }
        });


        /* bar chart */
        var chBar = document.getElementById("chBar");
        if (chBar) {
            new Chart(chBar, {
                type: 'bar',
                data: {
                    labels: ["S", "M", "T", "W", "T", "F", "S"],
                    datasets: [{
                        label: 'Liquidadas',
                        data: [589, 445, 483, 503, 689, 692, 634],
                        backgroundColor: colors[0]
                    },
                    {
                        label: 'Devueltas',
                        data: [639, 465, 493, 478, 589, 632, 674],
                        backgroundColor: colors[4]
                    }]
                },
                options: {
                    legend: {
                        display: false
                    }
                    //scales: {
                    //    xAxes: [{
                    //        barPercentage: 1,
                    //        categoryPercentage: 1
                    //    }]
                    //}
                }
            });
        }

        /* 3 donut charts */
        var donutOptions = {
            cutoutPercentage: 85,
            legend: { position: 'bottom', padding: 5, labels: { pointStyle: 'circle', usePointStyle: true } }
        };

        // donut 1
        var chDonutData1 = {
            labels: ['POS', 'eCommerce', 'ATM', 'Devoluciones'],
            datasets: [
                {
                    backgroundColor: colors.slice(0, 4),
                    borderWidth: 0,
                    data: [74, 11, 40, 3]
                }
            ]
        };

        var chDonut1 = document.getElementById("chDonut1");
        if (chDonut1) {
            new Chart(chDonut1, {
                type: 'pie',
                data: chDonutData1,
                options: donutOptions
            });
        }
    
