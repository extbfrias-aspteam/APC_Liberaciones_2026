@{
    ViewData["Title"] = "Home iRis";
}

<div class="container">

     <div class="row">
        <div class="col-lg-6">
            <div class="card-box" >
                <h6 class="card-title">Producto - Mi Ahorro ASP</h6>
                <div class="widget-chart text-center" style="height: 290px;">
                    <canvas id="chLineMiAhorro"></canvas>
                </div>
                <div class="card-footer">
                    Total Cuentas Vigentes <span id="totVigenteMiAhorro"></span>
                </div>  
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card-box">
                <h6 class="card-title">Producto - Cuenta Fácil</h6>
                <div class="widget-chart text-center" style="height: 290px;">
                    <canvas id="chLine"></canvas>
                </div>
                <div class="card-footer">
                    Total Cuentas Vigentes <span id="totVigenteCuentaFacil"></span>
                </div>
            </div>
        </div>
     </div>

    <div class="row">
        

        <div class="col-lg-3">
            <div class="card-box" style="max-width: 540px;">
                <div class="row g-0">

                    <div class="col-md-12">
                        <h6 class="card-title">Tarjetas Físicas</h6>

                        <div class="card-body" style="height: 290px;">
                            <div class="col-md-12 ">
                                <img src="~/images/cardMC.png" width="90%" />
                            </div>
                            <div class="row">
                                <div class="col-6 col-sm-7"><small>ACTIVAS</small></div>
                                <div class="col-6 col-sm-5" style="text-align:right;"><span id="TFActivas"></span></div>
                                <!-- Force next columns to break to new line at md breakpoint and up -->
                                <div class="w-100 d-none d-md-block"></div>
                                <div class="col-6 col-sm-7"><small>BLOQUEADAS</small></div>
                                <div class="col-6 col-sm-5" style="text-align:right;"><span id="TFBloqueadas"></span></div>
                                <!-- Force next columns to break to new line at md breakpoint and up -->
                                <div class="w-100 d-none d-md-block"></div>
                                <div class="col-6 col-sm-7"><small>CANCELADAS</small></div>
                                <div class="col-6 col-sm-5" style="text-align:right;"><span id="TFCanceladas"></span></div>

                                <div class="w-100 d-none d-md-block"></div>
                                <div class="col-6 col-sm-7"><small>SIN ASIGNAR</small></div>
                                <div class="col-6 col-sm-5" style="text-align:right;"><span id="TFSinAsignar"></rigth></div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3">
            <div class="card-box" style="max-width: 540px;">
                <div class="row g-0">
                    <div class="col-md-12">
                        <h6 class="card-title">Tarjetas Virtuales</h6>
                        <div class="card-body" style="height: 290px;">
                            <div class="col-md-12">
                                <img src="~/images/digitalcard.png" width="90%" />
                            </div>
                            <div class="row">
                                <div class="col-6 col-sm-5">ACTIVAS</div>
                                <div class="col-6 col-sm-6" style="text-align:right;"><span id="TVActivas"></span></div>
                                <!-- Force next columns to break to new line at md breakpoint and up -->
                                <div class="w-100 d-none d-md-block"></div>
                                <div class="col-6 col-sm-5">BLOQUEADAS</div>
                                <div class="col-6 col-sm-6" style="text-align:right;"><span id="TVBloqueadas"></span></div>
                                <!-- Force next columns to break to new line at md breakpoint and up -->
                                <div class="w-100 d-none d-md-block"></div>
                                <div class="col-6 col-sm-5">CANCELADAS</div>
                                <div class="col-6 col-sm-6" style="text-align:right;"><span id="TVCanceladas"></span></div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>      
    </div>
</div>


