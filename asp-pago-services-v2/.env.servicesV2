# Host Base de datos procrea
DB_PROCREA_HOST=jdbc:postgresql://<ip_bd_procrea>:<puerto_bd_procrea>/<nombre_bd_procrea>
# Credenciales para acceder a Base de datos procrea
DB_PROCREA_USER=<usuario_bd_procrea>
DB_PROCREA_PASS=<password_bd_procrea>
# Host Base de datos cero
DB_CERO_HOST=jdbc:postgresql://<ip_bd_cero>:<puerto_bd_cero>/<nombre_bd_cero>
# Credenciales para acceder a Base de datos cero
DB_CERO_USER=<usuario_bd_cero>
DB_CERO_PASS=<password_bd_cero>